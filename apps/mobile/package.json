{
  "name": "twomiah-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:build": "cross-env APP_VARIANT=build expo start",
    "dev:roofer": "cross-env APP_VARIANT=roofer expo start",
    "dev:care": "cross-env APP_VARIANT=care expo start",
    "build": "echo 'Use eas build for native builds'",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "build:apk": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:production": "eas build --platform all --profile production",
    "apk:build": "eas build --platform android --profile build-preview",
    "apk:roofer": "eas build --platform android --profile roofer-preview",
    "apk:care": "eas build --platform android --profile care-preview",
    "ios:build": "eas build --platform ios --profile build-preview",
    "ios:roofer": "eas build --platform ios --profile roofer-preview",
    "ios:care": "eas build --platform ios --profile care-preview",
    "prod:build": "eas build --platform all --profile build-production",
    "prod:roofer": "eas build --platform all --profile roofer-production",
    "prod:care": "eas build --platform all --profile care-production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@stripe/stripe-terminal-react-native": "0.0.1-beta.33",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "^20.11.0",
    "@types/react": "~19.1.10",
    "cross-env": "^7.0.3",
    "typescript": "~5.9.2"
  }
}
