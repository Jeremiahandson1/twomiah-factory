{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "TAP_TO_PAY_IOS": "0"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "TAP_TO_PAY_IOS": "0"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "TAP_TO_PAY_IOS": "0"
      }
    },
    "build-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "build"
      },
      "channel": "build-preview"
    },
    "build-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "build"
      },
      "channel": "build-production"
    },
    "roofer-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "roofer"
      },
      "channel": "roofer-preview"
    },
    "roofer-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "roofer"
      },
      "channel": "roofer-production"
    },
    "care-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "care",
        "TWOMIAH_EAS_BUILD": "care"
      },
      "channel": "care-preview"
    },
    "care-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "care",
        "TWOMIAH_EAS_BUILD": "care"
      },
      "channel": "care-production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "jeremiahandson1@gmail.com",
        "ascAppId": "6828043536",
        "appleTeamId": "63XSWU8M5Z"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    }
  }
}
