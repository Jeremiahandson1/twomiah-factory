{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "build-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "build"
      },
      "channel": "build-preview"
    },
    "build-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "build"
      },
      "channel": "build-production"
    },
    "roofer-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "roofer"
      },
      "channel": "roofer-preview"
    },
    "roofer-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "roofer"
      },
      "channel": "roofer-production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "TODO_REPLACE_WITH_APPLE_ID@twomiah.com",
        "ascAppId": "TODO_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "TODO_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    }
  }
}
