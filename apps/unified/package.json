{
  "name": "@twomiah/unified",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The unified Twomiah app (docs/SPEC_UNIFIED_PRODUCT.md): one server per tenant for the website, bookings and CRM. Rules: docs/RULEBOOK.md.",
  "scripts": {
    "start": "bun server/db/migrate.ts && bun server/index.ts",
    "dev": "bun --watch server/index.ts",
    "db:generate": "bunx drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@twomiah/tenant-backend": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "ejs": "^3.1.9",
    "hono": "^4.6.14",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.12",
    "pg": "^8.13.1",
    "sharp": "^0.33.2",
    "stripe": "^20.3.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/bun": "^1.3.14",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3"
  }
}
