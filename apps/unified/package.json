{
  "name": "@twomiah/unified",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The unified Twomiah app (docs/SPEC_UNIFIED_PRODUCT.md): one server per tenant for the website, bookings and CRM. Rules: docs/RULEBOOK.md.",
  "scripts": {
    "start": "bun server/db/migrate.ts && bun server/index.ts",
    "dev": "bun --watch server/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "bun tests/runEach.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@stripe/react-stripe-js": "^2.5.0",
    "@stripe/stripe-js": "^3.0.0",
    "@twomiah/roof-core": "workspace:*",
    "@twomiah/tenant-backend": "workspace:*",
    "@twomiah/tenant-ui": "workspace:*",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.36.4",
    "ejs": "^3.1.9",
    "hono": "^4.6.14",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "maplibre-gl": "^6.16.0",
    "nodemailer": "^10.1.4",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.1",
    "sharp": "^0.33.2",
    "stripe": "^20.3.0",
    "three": "^0.170.0",
    "twilio": "^5.3.4",
    "web-push": "^3.6.6",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/bun": "^1.3.14",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.1.4"
  }
}
