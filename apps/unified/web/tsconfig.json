{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    // One React's types for the app and every package it imports: a package resolving on its own (lucide-react)
    // otherwise finds the workspace's hoisted React 19 types, and nothing it exports is a JSX component here.
    "baseUrl": ".",
    "paths": {
      "react": ["../node_modules/@types/react"],
      "react/*": ["../node_modules/@types/react/*"],
      "react-dom": ["../node_modules/@types/react-dom"],
      "react-dom/*": ["../node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "demo", "vite.config.ts", "vite.demo.config.ts", "tailwind.config.ts"]
}
