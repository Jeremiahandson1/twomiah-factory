<%
  // A private-party ENQUIRY, not a reservation system. Posts to /api/leads (formType 'party') → a lead,
  // an email to the owner, and a party enquiry in the CRM.
  //
  // data: { heading, intro, asHeading, occasions: [], minParty, promise, sidebar: [{num,label}], facts: [] }
  // Everything the section states is the owner's: no occasion list, reply promise or party size is
  // assumed when none is given (scripts/check-composer-facts.ts).
  const H = data.asHeading ? 'h1' : 'h2'
  const occasions = Array.isArray(data.occasions) ? data.occasions.filter(Boolean) : []
  const facts = Array.isArray(data.facts) ? data.facts.filter(Boolean) : []
  const sidebar = Array.isArray(data.sidebar) ? data.sidebar.filter(x => x && x.num) : []
  const today = new Date().toISOString().slice(0, 10)
  const t = Date.now()
%>
<section class="parties" id="parties" aria-labelledby="parties-heading">
  <div class="container">
    <div class="section-head section-head--left">
      <<%= H %> class="section-title" id="parties-heading"><%= data.heading || 'Book the back booths' %></<%= H %>>
      <% if (data.intro) { %><p class="section-intro"><%= data.intro %></p><% } %>
    </div>
    <div class="parties__layout">
      <form class="parties__form" method="POST" action="/api/leads" aria-label="Private party inquiry">
        <input type="hidden" name="formType" value="party">
        <input type="hidden" name="source" value="<%= typeof currentPath !== 'undefined' && currentPath ? currentPath : '/parties' %>">
        <input type="hidden" name="t" value="<%= t %>">
        <div class="parties__hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        <div class="parties__row">
          <div class="parties__field"><label class="parties__label" for="p-name">Your name</label><input id="p-name" type="text" name="name" required autocomplete="name"></div>
          <div class="parties__field"><label class="parties__label" for="p-phone">Phone (we call back)</label><input id="p-phone" type="tel" name="phone" required autocomplete="tel" inputmode="tel"></div>
        </div>
        <%- smsConsent('enquiry') %>
        <div class="parties__row">
          <div class="parties__field"><label class="parties__label" for="p-email">Email (optional)</label><input id="p-email" type="email" name="email" autocomplete="email"></div>
          <div class="parties__field"><label class="parties__label" for="p-date">Date you have in mind</label><input id="p-date" type="date" name="requestedDate" min="<%= today %>"></div>
        </div>
        <div class="parties__row">
          <div class="parties__field"><label class="parties__label" for="p-size">How many people</label><input id="p-size" type="number" name="partySize" min="<%= data.minParty || 2 %>" max="200" inputmode="numeric"></div>
          <div class="parties__field"><label class="parties__label" for="p-occ">What's the occasion</label>
            <% if (occasions.length) { %><select id="p-occ" name="occasion"><% for (const o of occasions) { %><option><%= o %></option><% } %></select>
            <% } else { %><input id="p-occ" type="text" name="occasion" maxlength="80"><% } %>
          </div>
        </div>
        <div class="parties__room" id="pf-room-wrap" hidden>
          <div class="parties__row">
            <div class="parties__field"><label class="parties__label" for="pf-start">Start time (optional)</label><input id="pf-start" type="time" name="startTime"></div>
            <div class="parties__field"><label class="parties__label" for="pf-end">End time (optional)</label><input id="pf-end" type="time" name="endTime"></div>
          </div>
          <div class="parties__field parties__field--full"><label class="parties__label" for="pf-room">Room you would like (optional)</label>
            <select id="pf-room" name="spaceId"><option value="" data-base="">No preference</option></select></div>
          <input type="hidden" name="room" id="pf-room-name" value="">
          <p class="parties__promise" id="pf-room-note" aria-live="polite"></p>
        </div>
        <div class="parties__field parties__field--full"><label class="parties__label" for="p-msg">Anything else</label><textarea id="p-msg" name="message" rows="4" placeholder="Food, drinks, a cake, a game on the TV — whatever matters."></textarea></div>
        <div class="parties__submit-row">
          <button class="btn btn--primary btn--xl" type="submit">Ask about a party</button>
          <% if (data.promise) { %><span class="parties__promise"><%= data.promise %></span><% } %>
        </div>
      </form>
      <aside class="parties__sidebar">
        <% for (const s of sidebar) { %>
          <div class="parties__sidebar-row"><div class="parties__sidebar-num"><%= s.num %></div><div class="parties__sidebar-label"><%= s.label || '' %></div></div>
        <% } %>
        <% if (facts.length) { %>
          <div class="parties__sidebar-row"><ul class="parties__sidebar-list"><% for (const f of facts) { %><li><%= f %></li><% } %></ul></div>
        <% } %>
        <% if (settings.phone) { %>
          <div class="parties__sidebar-row"><div class="eyebrow">Or just call</div><a class="parties__phone mono" href="tel:<%= String(settings.phone).replace(/[^\d+]/g, '') %>"><%= settings.phone %></a></div>
        <% } %>
      </aside>
    </div>
  </div>
</section>
<script>
// The venue's rooms and whether each looks free on the date typed (a look: nothing is held). Shown only when the venue has the
// room picker switched on: the rooms address answers 404 otherwise and the box stays hidden.
(function () {
  var form = document.querySelector('.parties__form'); if (!form) return;
  var wrap = document.getElementById('pf-room-wrap'), sel = document.getElementById('pf-room'), note = document.getElementById('pf-room-note'), nameEl = document.getElementById('pf-room-name');
  var date = form.elements.requestedDate, size = form.elements.partySize, st = document.getElementById('pf-start'), en = document.getElementById('pf-end');
  var pending = 0, built = false;
  function look() {
    var mine = ++pending;
    var q = '?date=' + encodeURIComponent(date.value || '') + '&startTime=' + encodeURIComponent(st.value || '') + '&endTime=' + encodeURIComponent(en.value || '') + '&guests=' + encodeURIComponent(size.value || '');
    fetch('/api/event-form/rooms' + q, { headers: { Accept: 'application/json' } }).then(function (r) { return r.ok ? r.json() : null; }).then(function (j) {
      if (!j || !j.data || !j.data.length || mine !== pending) return;
      if (!built) {
        j.data.forEach(function (r) {
          var cap = [r.seatedCapacity ? 'seats ' + r.seatedCapacity : '', r.standingCapacity ? 'standing ' + r.standingCapacity : ''].filter(Boolean).join(', ');
          var o = document.createElement('option'); o.value = r.id; o.setAttribute('data-base', r.name + (cap ? ' (' + cap + ')' : '')); sel.appendChild(o);
        });
        built = true; wrap.hidden = false;
      }
      var chosen = sel.value, pick = null;
      Array.prototype.forEach.call(sel.options, function (o) {
        var r = j.data.filter(function (x) { return x.id === o.value; })[0]; if (!r) return;
        if (r.id === chosen) pick = r;
        o.textContent = o.getAttribute('data-base') + (r.looksFree === true ? ' \u2014 looks free' : r.looksFree === false ? ' \u2014 looks taken' : '') + (r.fits === false ? ' (smaller than your group)' : '');
      });
      nameEl.value = chosen ? sel.options[sel.selectedIndex].getAttribute('data-base') : '';
      note.textContent = !chosen ? '' : pick && pick.looksFree === true ? 'That room looks free on that day. Nothing is held for you until we confirm it with you.' : pick && pick.looksFree === false ? 'That room looks taken at that time. You can still send your request, or choose another room or day, and we will get back to you.' : 'Choose a date and we will show whether the room looks free.';
    }).catch(function () {});
  }
  [date, size, st, en, sel].forEach(function (el) { el.addEventListener('change', look); });
  look();
})();
</script>
