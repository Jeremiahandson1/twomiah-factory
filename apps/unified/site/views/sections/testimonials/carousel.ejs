<%
  // Testimonials as a carousel: the owner's real reviews, one at a time. Built to need no script — the track is a native
  // scroll-snap strip, so without JavaScript every review is reachable by swiping or scrolling. The inline script only adds
  // the previous/next buttons, the dots and the arrow keys. It never moves by itself (no autoplay), and it scrolls smoothly
  // only for a visitor who has not asked for reduced motion. Quotes are the owner's: a review with no quote is not shown.
  const heading = data.heading || ''
  const intro = data.intro || ''
  const items = Array.isArray(data.items) ? data.items.filter(function (q) { return q && q.quote }) : []
  if (items.length === 0) return
  const uid = 'tc' + Math.random().toString(36).slice(2, 8)
%>
<section class="testimonials-carousel" data-carousel<%= items.length > 1 ? '' : ' data-single' %> aria-roledescription="carousel" aria-label="<%= heading || 'Customer reviews' %>">
  <div class="container">
    <% if (heading || intro) { %>
      <div class="testimonials-carousel__head">
        <% if (heading) { %><h2 class="testimonials-carousel__title"><%= heading %></h2><% } %>
        <% if (intro) { %><p class="testimonials-carousel__intro"><%= intro %></p><% } %>
      </div>
    <% } %>
    <div class="testimonials-carousel__frame">
      <ul class="testimonials-carousel__track" id="<%= uid %>" tabindex="0" aria-label="Reviews. Use the left and right arrow keys, or swipe." data-track>
        <% items.forEach(function (q, i) { %>
          <li class="testimonials-carousel__slide" role="group" aria-roledescription="slide" aria-label="Review <%= i + 1 %> of <%= items.length %>">
            <figure class="testimonials-carousel__card">
              <blockquote class="testimonials-carousel__quote">&ldquo;<%= q.quote %>&rdquo;</blockquote>
              <figcaption class="testimonials-carousel__who">
                <% if (q.photo) { %><img class="testimonials-carousel__photo" src="<%= q.photo %>" alt="" loading="lazy"><% } %>
                <span>
                  <% if (q.author) { %><span class="testimonials-carousel__author"><%= q.author %></span><% } %>
                  <% if (q.role) { %><span class="testimonials-carousel__role"><%= q.role %></span><% } %>
                </span>
              </figcaption>
            </figure>
          </li>
        <% }) %>
      </ul>
      <% if (items.length > 1) { %>
        <div class="testimonials-carousel__controls" hidden data-controls>
          <button type="button" class="testimonials-carousel__btn" data-prev aria-label="Previous review" aria-controls="<%= uid %>"><span aria-hidden="true">&larr;</span></button>
          <div class="testimonials-carousel__dots" role="group" aria-label="Choose a review">
            <% items.forEach(function (q, i) { %><button type="button" class="testimonials-carousel__dot" data-dot="<%= i %>" aria-label="Review <%= i + 1 %> of <%= items.length %>" aria-current="<%= i === 0 ? 'true' : 'false' %>"></button><% }) %>
          </div>
          <button type="button" class="testimonials-carousel__btn" data-next aria-label="Next review" aria-controls="<%= uid %>"><span aria-hidden="true">&rarr;</span></button>
        </div>
      <% } %>
    </div>
  </div>
  <% if (items.length > 1) { %>
  <script>(function () {
    var root = document.currentScript.parentElement;
    var track = root.querySelector('[data-track]'), controls = root.querySelector('[data-controls]');
    if (!track || !controls) return;
    var slides = track.children, dots = controls.querySelectorAll('[data-dot]');
    var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    controls.hidden = false;
    function at() { return Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / (slides[0].offsetWidth || 1)))); }
    function go(i) { i = Math.max(0, Math.min(slides.length - 1, i)); track.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft, behavior: calm ? 'auto' : 'smooth' }); }
    function mark() { var i = at(); for (var d = 0; d < dots.length; d++) dots[d].setAttribute('aria-current', d === i ? 'true' : 'false'); }
    track.addEventListener('scroll', function () { window.requestAnimationFrame(mark); }, { passive: true });
    controls.querySelector('[data-prev]').addEventListener('click', function () { go(at() - 1); });
    controls.querySelector('[data-next]').addEventListener('click', function () { go(at() + 1); });
    for (var d = 0; d < dots.length; d++) (function (n) { dots[n].addEventListener('click', function () { go(n); }); })(d);
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(at() + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); go(at() - 1); }
      else if (e.key === 'Home') { e.preventDefault(); go(0); }
      else if (e.key === 'End') { e.preventDefault(); go(slides.length - 1); }
    });
    window.addEventListener('resize', mark);
  })();</script>
  <% } %>
</section>
