<%
  // THE MENU — semantic HTML with real prices, grouped by section, from the CRM (site.menu, lib/bar.ts)
  // so it is the same data the Menu JSON-LD and the bartender's 86 button use. Never a PDF, never an
  // image. data.sections is the fallback when the bar has no CRM menu yet.
  //
  // data: { heading, intro, asHeading, kind ('food' | 'drink' | 'all'), sections (fallback when site is null), showSignatureLinks }
  const S = (typeof site !== 'undefined' && site && Array.isArray(site.menu) && site.menu.length) ? site.menu : (Array.isArray(data.sections) ? data.sections : [])
  const kind = data.kind || 'all'
  const sections = S.filter(s => s && Array.isArray(s.items) && s.items.length && (kind === 'all' || (s.kind || 'food') === kind))
  const heading = data.heading || 'The menu'
  const intro = data.intro || ''
  const H = data.asHeading ? 'h1' : 'h2'
  const showLinks = data.showSignatureLinks !== false
  function price(i) {
    if (i.priceLabel) return i.priceLabel
    if (i.priceCents === null || i.priceCents === undefined) return '—'
    return i.priceCents % 100 === 0 ? '$' + (i.priceCents / 100) : '$' + (i.priceCents / 100).toFixed(2)
  }
  const DIET = { GF: 'Gluten-free', V: 'Vegetarian', VG: 'Vegan', DF: 'Dairy-free', N: 'Contains nuts', SP: 'Spicy' }
  const legend = new Set()
  sections.forEach(s => s.items.forEach(i => (Array.isArray(i.dietary) ? i.dietary : []).forEach(d => legend.add(String(d).toUpperCase()))))
%>
<section class="menu-full" id="menu" aria-labelledby="menu-heading">
  <div class="container">
    <div class="section-head">
      <<%= H %> class="section-title" id="menu-heading"><%= heading %></<%= H %>>
      <% if (intro) { %><p class="section-intro"><%= intro %></p><% } %>
      <% if (typeof site !== 'undefined' && site && site.live && site.live.ordering && site.live.ordering.available && kind !== 'drink') { %>
        <p class="menu__order"><a class="btn btn--primary btn--lg" href="/order">Order for pickup</a></p>
      <% } %>
      <% if (legend.size) { %>
        <ul class="menu__legend" aria-label="Dietary key">
          <% for (const code of legend) { %><li class="menu__legend-chip"><span class="menu__chip menu__chip--<%= code.toLowerCase() %>"><%= code %></span><%= DIET[code] || code %></li><% } %>
        </ul>
      <% } %>
    </div>

    <% if (!sections.length) { %>
      <p class="menu-full__empty">The menu is being typed up. Call <a href="tel:<%= String(settings.phone || '').replace(/[^\d+]/g, '') %>"><%= settings.phone || 'us' %></a> and we'll read it to you.</p>
    <% } %>

    <% for (const s of sections) { %>
      <section class="menu-section" id="menu-<%= s.slug %>" aria-labelledby="menu-<%= s.slug %>-h">
        <header class="menu-section__head">
          <h<%= data.asHeading ? 2 : 3 %> class="menu-section__title" id="menu-<%= s.slug %>-h"><%= s.name %></h<%= data.asHeading ? 2 : 3 %>>
          <% if (s.description) { %><p class="menu-section__desc"><%= s.description %></p><% } %>
        </header>
        <ul class="menu-list" role="list">
          <% for (const i of s.items) { if (i.isActive === false) continue; const link = showLinks && i.isSignature ? '/' + s.slug + '/' + i.slug : ''; const out = i.is86ed; %>
            <li class="menu-line<%= out ? ' menu-line--86' : '' %><%= i.isSignature ? ' menu-line--signature' : '' %><%= i.imageUrl ? ' menu-line--photo' : '' %>" id="item-<%= i.slug %>">
              <% if (i.imageUrl) { %><img class="menu-line__img" src="<%= i.imageUrl %>" alt="<%= i.name %>" loading="lazy" width="96" height="96"><% } %>
              <div class="menu-line__text">
              <div class="menu-line__head">
                <span class="menu-line__name">
                  <% if (link) { %><a href="<%= link %>"><%= i.name %></a><% } else { %><%= i.name %><% } %>
                  <% if (out) { %><span class="menu-line__out">out tonight</span><% } %>
                </span>
                <span class="menu-line__price mono"><%= price(i) %></span>
              </div>
              <% if (i.description) { %><p class="menu-line__desc"><%= i.description %></p><% } %>
              <% if (Array.isArray(i.dietary) && i.dietary.length) { %>
                <ul class="menu-item__diet" aria-label="Dietary tags">
                  <% for (const d of i.dietary) { %><li class="menu__chip menu__chip--<%= String(d).toLowerCase() %>"><%= String(d).toUpperCase() %></li><% } %>
                </ul>
              <% } %>
              </div>
            </li>
          <% } %>
        </ul>
      </section>
    <% } %>
  </div>
</section>
<%/* An item's photo beside its line; an item with none keeps the plain line. In a layer, so a design that styles the menu
     (the bar's) wins every rule it has, and a design that never did (a restaurant's showcase) still gets a readable menu. */%>
<style>@layer menu-section {
  .menu-full{padding:var(--space,64px) 0}
  .menu-section{max-width:820px;margin:0 auto 48px}
  .menu-section__title{margin:0 0 6px}
  .menu-list{list-style:none;margin:0;padding:0}
  .menu-line{padding:14px 0;border-bottom:1px solid var(--line,rgba(127,127,127,.3))}
  .menu-line:last-child{border-bottom:0}
  .menu-line__head{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
  .menu-line__name{font-weight:700}
  .menu-line__price{white-space:nowrap;font-weight:700}
  .menu-line__desc{margin:6px 0 0;opacity:.85;line-height:1.5}
  .menu-line__out{margin-left:8px;font-size:12px;text-transform:uppercase;letter-spacing:.08em}
  .menu-line--86{opacity:.5}
  .menu-item__diet{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 0;padding:0}
  .menu__legend{list-style:none;display:flex;flex-wrap:wrap;gap:12px;padding:0}
  .menu__chip{display:inline-block;font-size:11px;font-weight:700;padding:1px 6px;border:1px solid currentColor;border-radius:4px;margin-right:4px}
  .menu-line--photo{display:grid;grid-template-columns:96px minmax(0,1fr);gap:16px;align-items:start}
  .menu-line__img{width:96px;height:96px;object-fit:cover;border-radius:10px;display:block}
  @media (max-width:480px){.menu-line--photo{grid-template-columns:72px minmax(0,1fr);gap:12px}.menu-line__img{width:72px;height:72px}}
}</style>
