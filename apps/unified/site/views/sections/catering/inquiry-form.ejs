<%
  // Catering-specific inquiry form. Collects event date, headcount, venue
  // type, and special dietary needs — fields a generic /contact form
  // wouldn't have. POSTs to /api/leads with source=catering so the CRM
  // can route it to the catering pipeline.
  // Minimum headcount, lead time and the reply promise are the OWNER'S
  // policies. With none supplied they are not shown and not enforced — a
  // default here would print a minimum and a promise nobody made.
  const heading = data.heading || 'Book the truck'
  const intro = data.intro || ''
  const minHeadcount = parseInt(data.minHeadcount, 10) > 0 ? parseInt(data.minHeadcount, 10) : null
  const leadTimeWeeks = parseInt(data.leadTimeWeeks, 10) > 0 ? parseInt(data.leadTimeWeeks, 10) : null
  const venueTypes = Array.isArray(data.venueTypes) && data.venueTypes.length
    ? data.venueTypes
    : ['Wedding', 'Birthday', 'Corporate', 'Community', 'Other']
  const responsePromise = data.responsePromise || ''
  const hasSidebar = !!minHeadcount || !!leadTimeWeeks || Array.isArray(data.includes)
%>
<section id="catering" class="catering catering--inquiry">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title"><%= heading %></h2>
      <% if (intro) { %><p class="section-intro"><%= intro %></p><% } %>
    </div>
    <div class="catering__layout">
      <form class="catering__form" method="POST" action="/api/leads" aria-label="Catering inquiry">
        <input type="hidden" name="source" value="catering">
        <input type="hidden" name="honeypot" value="" style="display:none;" tabindex="-1" autocomplete="off">
        <div class="catering__row">
          <label class="catering__field">
            <span class="catering__label">Your name</span>
            <input type="text" name="name" required autocomplete="name">
          </label>
          <label class="catering__field">
            <span class="catering__label">Email</span>
            <input type="email" name="email" required autocomplete="email">
          </label>
        </div>
        <div class="catering__row">
          <label class="catering__field">
            <span class="catering__label">Phone</span>
            <input type="tel" name="phone" autocomplete="tel">
          </label>
          <%- smsConsent('enquiry') %>
          <label class="catering__field">
            <span class="catering__label">Event date</span>
            <input type="date" name="eventDate" required min="<%= new Date(Date.now() + (leadTimeWeeks || 0) * 7 * 24 * 60 * 60 * 1000).toISOString().slice(0,10) %>">
          </label>
        </div>
        <div class="catering__row">
          <label class="catering__field">
            <span class="catering__label">Headcount</span>
            <input type="number" name="headcount" required min="<%= minHeadcount || 1 %>"<% if (minHeadcount) { %> placeholder="<%= minHeadcount %>+"<% } %>>
          </label>
          <label class="catering__field">
            <span class="catering__label">Event type</span>
            <select name="venueType" required>
              <option value="">Choose…</option>
              <% for (const v of venueTypes) { %><option value="<%= v %>"><%= v %></option><% } %>
            </select>
          </label>
        </div>
        <div class="catering__room" id="cf-room-wrap" hidden>
          <div class="catering__row">
            <label class="catering__field">
              <span class="catering__label">Start time (optional)</span>
              <input type="time" name="startTime" id="cf-start">
            </label>
            <label class="catering__field">
              <span class="catering__label">End time (optional)</span>
              <input type="time" name="endTime" id="cf-end">
            </label>
          </div>
          <label class="catering__field catering__field--full">
            <span class="catering__label">Room you would like (optional)</span>
            <select name="spaceId" id="cf-room"><option value="" data-base="">No preference</option></select>
          </label>
          <input type="hidden" name="room" id="cf-room-name" value="">
          <p class="catering__promise" id="cf-room-note" aria-live="polite"></p>
        </div>
        <label class="catering__field catering__field--full">
          <span class="catering__label">Address or venue (if you have it)</span>
          <input type="text" name="venue" autocomplete="street-address">
        </label>
        <label class="catering__field catering__field--full">
          <span class="catering__label">Anything else? Dietary, ceremony time, vibe, music, allergies — whatever helps us quote.</span>
          <textarea name="notes" rows="4"></textarea>
        </label>
        <div class="catering__submit-row">
          <button type="submit" class="btn btn--xl btn--primary">Send inquiry</button>
          <% if (responsePromise) { %><span class="catering__promise"><%= responsePromise %></span><% } %>
        </div>
      </form>
      <% if (hasSidebar) { %>
      <aside class="catering__sidebar">
        <% if (minHeadcount) { %>
        <div class="catering__sidebar-row">
          <div class="catering__sidebar-num mono"><%= minHeadcount %>+</div>
          <div class="catering__sidebar-label">Minimum headcount</div>
        </div>
        <% } %>
        <% if (leadTimeWeeks) { %>
        <div class="catering__sidebar-row">
          <div class="catering__sidebar-num mono"><%= leadTimeWeeks %> wk</div>
          <div class="catering__sidebar-label">Earliest booking</div>
        </div>
        <% } %>
        <% if (Array.isArray(data.includes)) { %>
          <div class="catering__sidebar-row catering__sidebar-row--list">
            <div class="catering__sidebar-label">Every booking includes</div>
            <ul class="catering__sidebar-list">
              <% for (const inc of data.includes) { %><li><%= inc %></li><% } %>
            </ul>
          </div>
        <% } %>
      </aside>
      <% } %>
    </div>
  </div>
</section>
<script>
// The venue's rooms and whether each looks free on the date typed (a look: nothing is held). Shown only when the venue has the
// room picker switched on: the rooms address answers 404 otherwise and the box stays hidden.
(function () {
  var form = document.querySelector('.catering__form'); if (!form) return;
  var wrap = document.getElementById('cf-room-wrap'), sel = document.getElementById('cf-room'), note = document.getElementById('cf-room-note'), nameEl = document.getElementById('cf-room-name');
  var date = form.elements.eventDate, size = form.elements.headcount, st = document.getElementById('cf-start'), en = document.getElementById('cf-end');
  var pending = 0, built = false;
  function look() {
    var mine = ++pending;
    var q = '?date=' + encodeURIComponent(date.value || '') + '&startTime=' + encodeURIComponent(st.value || '') + '&endTime=' + encodeURIComponent(en.value || '') + '&guests=' + encodeURIComponent(size.value || '');
    fetch('/api/event-form/rooms' + q, { headers: { Accept: 'application/json' } }).then(function (r) { return r.ok ? r.json() : null; }).then(function (j) {
      if (!j || !j.data || !j.data.length || mine !== pending) return;
      if (!built) {
        j.data.forEach(function (r) {
          var cap = [r.seatedCapacity ? 'seats ' + r.seatedCapacity : '', r.standingCapacity ? 'standing ' + r.standingCapacity : ''].filter(Boolean).join(', ');
          var o = document.createElement('option'); o.value = r.id; o.setAttribute('data-base', r.name + (cap ? ' (' + cap + ')' : '')); sel.appendChild(o);
        });
        built = true; wrap.hidden = false;
      }
      var chosen = sel.value, pick = null;
      Array.prototype.forEach.call(sel.options, function (o) {
        var r = j.data.filter(function (x) { return x.id === o.value; })[0]; if (!r) return;
        if (r.id === chosen) pick = r;
        o.textContent = o.getAttribute('data-base') + (r.looksFree === true ? ' \u2014 looks free' : r.looksFree === false ? ' \u2014 looks taken' : '') + (r.fits === false ? ' (smaller than your group)' : '');
      });
      nameEl.value = chosen ? sel.options[sel.selectedIndex].getAttribute('data-base') : '';
      note.textContent = !chosen ? '' : pick && pick.looksFree === true ? 'That room looks free on that day. Nothing is held for you until we confirm it with you.' : pick && pick.looksFree === false ? 'That room looks taken at that time. You can still send your request, or choose another room or day, and we will get back to you.' : 'Choose a date and we will show whether the room looks free.';
    }).catch(function () {});
  }
  [date, size, st, en, sel].forEach(function (el) { el.addEventListener('change', look); });
  look();
})();
</script>
