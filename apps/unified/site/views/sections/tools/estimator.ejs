<%
  // The CRM's instant roof estimator (/estimator.js), mounted for this company. The site and the CRM are one app, so
  // the widget loads from this site's own origin ('' — server/site/routes.ts serves it) unless a page names another;
  // it shows nothing when the roofer has the estimator off (its /api/estimator/config answers an error).
  const crm = data.crmOrigin || ''
  const slug = data.slug || ''
%>
<% if (slug) { %>
<section class="tool-estimator" aria-label="Instant estimate">
  <div class="container">
    <div id="twomiah-estimator" data-slug="<%= slug %>"></div>
    <script src="<%= crm %>/estimator.js" defer></script>
  </div>
</section>
<style>
  .tool-estimator{padding:0 0 var(--space,64px)}
  #twomiah-estimator{max-width:760px;margin:0 auto}
</style>
<% } %>
