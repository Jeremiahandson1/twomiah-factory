<%
  // Contact section: the form on one side, the business's details (phone, email, address, hours, response promise) on
  // the other. The main body of a /contact page.
  //
  // One section for every vertical. Where the site templates differed, it was only in words — the address label
  // ("Office" for trades, "Address" elsewhere) and what the message box asks — which now come from the vertical's
  // settings (`words`, server/core/vertical.ts). The message box posts as `message` in every vertical; the
  // contractor copy still posted `project`, which the server reads too. Its heading is the page's h1 when the section
  // opens the page (isFirst, home.ejs) and an h2 below another section's — the bar's copy was always h2.
  const heading = data.heading || 'Start a conversation'
  const intro = data.intro || ''
  const phone = data.phone || ''
  const email = data.email || ''
  const address = data.address || ''
  // The section's own Hours lines; left empty, the company's opening hours (Settings › Company), as the site context
  // prints them (server/site/context.ts businessHoursLines).
  const ownHours = Array.isArray(data.hours) ? data.hours.filter(Boolean) : []
  const hours = ownHours.length ? ownHours : ((typeof settings !== 'undefined' && settings && Array.isArray(settings.businessHoursLines)) ? settings.businessHoursLines : [])
  const responsePromise = data.responsePromise || ''
  // Always the enquiry endpoint (saved where the business works its leads, and emailed to the owner).
  const formAction = '/api/leads'
  // A service's own page asks for a quote for that service: `service` rides with the enquiry (it is read as an answer
  // the form asked for, and `source` names the page), and `id` is the anchor the page's button goes to.
  const service = data.service || ''
  const anchor = data.id ? String(data.id).replace(/[^a-z0-9_-]/gi, '') : ''
  const H = typeof isFirst !== 'undefined' && isFirst === false ? 'h2' : 'h1'
  // The Web presence plan's lead form is the owner's to switch off (data.noForm): the section then holds the details alone —
  // no form, no script, no endpoint. Every other site's contact section is unchanged (the form is on unless this says so).
  const showForm = data.noForm !== true
  // …and it asks for a phone number and/or an email (either one), has no texting consent box (the plan has no texting), and
  // may carry one or two of the trade's own questions (data.extraFields: [{ label }], posted as extra1 / extra2).
  const wp = data.webPresence === true
  const extraFields = wp && Array.isArray(data.extraFields) ? data.extraFields.filter((f) => f && typeof f.label === 'string' && f.label.trim()).slice(0, 2) : []
%>
<section class="contact-section"<% if (anchor) { %> id="<%= anchor %>"<% } %>>
  <div class="container contact-section__grid<%= showForm ? '' : ' contact-section__grid--details' %>">
    <div class="contact-section__copy">
      <<%= H %> class="contact-section__title"><%= heading %></<%= H %>>
      <% if (intro) { %><p class="contact-section__intro"><%= intro %></p><% } %>

      <div class="contact-section__details">
        <% if (phone) { %>
          <div class="contact-section__row">
            <div class="contact-section__label">Phone</div>
            <a class="contact-section__value" href="tel:<%= phone %>"><%= phone %></a>
          </div>
        <% } %>
        <% if (email) { %>
          <div class="contact-section__row">
            <div class="contact-section__label">Email</div>
            <a class="contact-section__value" href="mailto:<%= email %>"><%= email %></a>
          </div>
        <% } %>
        <% if (address) { %>
          <div class="contact-section__row">
            <div class="contact-section__label"><%= words.contactAddressLabel %></div>
            <div class="contact-section__value"><%= address %></div>
          </div>
        <% } %>
        <% if (hours.length) { %>
          <div class="contact-section__row">
            <div class="contact-section__label">Hours</div>
            <div class="contact-section__value">
              <% for (const h of hours) { %><div><%= h %></div><% } %>
            </div>
          </div>
        <% } %>
      </div>

      <% if (responsePromise) { %><div class="contact-section__promise"><%= responsePromise %></div><% } %>
    </div>

    <% if (showForm) { %>
    <form class="contact-form" action="<%= formAction %>" method="post"<% if (wp) { %> data-either<% } %>>
      <%/* Spam protection: hidden honeypot + a stamp the server compares
            against submit time to drop sub-2s bot submissions. Both
            inputs are visually + screen-reader hidden. */%>
      <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;">
        <label for="cf-website">Website (leave empty)</label>
        <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off">
      </div>
      <input type="hidden" name="t" value="" data-form-stamp>
      <% if (service) { %><input type="hidden" name="service" value="<%= service %>"><input type="hidden" name="source" value="Service page: <%= service %>"><% } %>
      <script>(function(){var s=document.currentScript.previousElementSibling;if(s&&s.name==='t')s.value=Date.now();})();</script>
      <div class="contact-form__row">
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" required minlength="2" autocomplete="name" aria-describedby="cf-name-err" data-msg="Please enter your name.">
        <p class="contact-form__error" id="cf-name-err" hidden></p>
      </div>
      <div class="contact-form__row">
        <label for="cf-email"><%= wp ? 'Email (phone or email, either is fine)' : 'Email' %></label>
        <input id="cf-email" name="email" type="email"<% if (!wp) { %> required<% } %> autocomplete="email" aria-describedby="cf-email-err" data-msg="Please enter your email address." data-msg-invalid="Please enter a valid email address, like name@example.com.">
        <p class="contact-form__error" id="cf-email-err" hidden></p>
      </div>
      <div class="contact-form__row">
        <label for="cf-phone"><%= wp ? 'Phone' : 'Phone (optional)' %></label>
        <input id="cf-phone" name="phone" type="tel">
      </div>
      <% extraFields.forEach(function (f, i) { %>
      <div class="contact-form__row">
        <label for="cf-extra<%= i + 1 %>"><%= f.label %></label>
        <input id="cf-extra<%= i + 1 %>" name="extra<%= i + 1 %>" type="text" maxlength="200">
      </div>
      <% }) %>
      <% if (!wp) { %><%- smsConsent('enquiry') %><% } %>
      <div class="contact-form__row">
        <label for="cf-message"><%= words.contactMessageLabel %></label>
        <textarea id="cf-message" name="message" rows="5" required minlength="4" aria-describedby="cf-message-err" data-msg="<%= words.contactMessageRequired %>"></textarea>
        <p class="contact-form__error" id="cf-message-err" hidden></p>
      </div>
      <button class="btn btn--primary btn--lg" type="submit">Send</button>
      <p class="contact-form__status" role="status" aria-live="polite" hidden></p>
    </form>
    <script>(function(){
      var f = document.currentScript.previousElementSibling;
      if (!f || !window.fetch || !window.FormData) return;
      // The form's own words under each box, not the browser's tooltip (live test 2026-10-22: "Name is required" showed
      // only as a bubble that vanished). The same rules the server holds (site/enquiryHandler.ts), which still checks.
      f.noValidate = true;
      var show = function(i, msg){ var p = document.getElementById(i.getAttribute('aria-describedby')); if (!p) return; p.textContent = msg || ''; p.hidden = !msg; if (msg) i.setAttribute('aria-invalid', 'true'); else i.removeAttribute('aria-invalid'); };
      var problem = function(i){
        var v = (i.value || '').trim(), min = Number(i.getAttribute('minlength')) || 1;
        if (i.required && v.length < min) return i.getAttribute('data-msg');
        if (i.type === 'email' && v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return i.getAttribute('data-msg-invalid');
        return '';
      };
      f.querySelectorAll('[data-msg]').forEach(function(i){ i.addEventListener('input', function(){ if (i.getAttribute('aria-invalid')) show(i, problem(i)); }); });
      f.addEventListener('submit', function(e){
        e.preventDefault();
        var first = null;
        f.querySelectorAll('[data-msg]').forEach(function(i){ var m = problem(i); show(i, m); if (m && !first) first = i; });
        if (!first && f.hasAttribute('data-either')) {
          var em = f.querySelector('[name=email]'), ph = f.querySelector('[name=phone]');
          if (!(em.value || '').trim() && !(ph.value || '').trim()) { show(em, 'Please give a phone number or an email so we can reply.'); first = em; }
        }
        if (first) { first.focus(); return; }
        var b = f.querySelector('button[type="submit"]'), s = f.querySelector('.contact-form__status');
        b.disabled = true;
        fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } })
          .then(function(r){ return r.json().catch(function(){ return {}; }).then(function(d){ return { ok: r.ok, d: d }; }); })
          .then(function(x){
            s.hidden = false;
            if (x.ok) {
              s.textContent = x.d.message || 'Thanks \u2014 your message was sent.';
              if (window.twomiahLeadSent) window.twomiahLeadSent(s.textContent);
              /* reset(), not value = '' on every input: that left the "Text me" box ticked with its value wiped, so the
                 next message sent an empty consent (bar live test, 2026-10-25). */
              f.reset();
            } else { s.textContent = x.d.error || 'That didn\u2019t go through. Please try again.'; b.disabled = false; }
          })
          .catch(function(){ s.hidden = false; s.textContent = 'That didn\u2019t go through. Please check your connection and try again.'; b.disabled = false; });
      });
    })();</script>
    <% } %>
  </div>
</section>
<% if (!showForm) { %><style>.contact-section__grid--details { grid-template-columns: 1fr !important; max-width: 720px; }</style><% } %>
