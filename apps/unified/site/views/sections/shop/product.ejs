<%
  // One product: gallery, options, quantity and add to cart, the details, and its structured data. From
  // templates/website-store views/product.ejs. data: { product: { slug, name, tagline, description, featured, images[], variants[] } }
  const p = data.product || {}
  const images = Array.isArray(p.images) ? p.images : []
  const variants = Array.isArray(p.variants) ? p.variants : []
  const primary = images.find((i) => i.isPrimary) || images[0] || null
  const multiVariant = variants.length > 1
  // The option chosen on arrival: the first in stock, else the first.
  const defaultVariant = variants.length ? (variants.find((v) => v.inventoryQty !== 0) || variants[0]) : null
  const inv = (v) => (v.inventoryQty === null || typeof v.inventoryQty === 'undefined') ? '' : v.inventoryQty
  const money = (c) => '$' + ((Number(c) || 0) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  // JSON inside a script block: a "<" is escaped so "</script>" in a name can't end it early.
  const ld = (v) => JSON.stringify(v).replace(/</g, '\\u003c')
  const prices = variants.map((v) => v.priceCents)
  const anyInStock = variants.some((v) => v.inventoryQty === null || typeof v.inventoryQty === 'undefined' || v.inventoryQty > 0)
  const availability = anyInStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock'
  const url = (settings.siteOrigin || '') + '/product/' + encodeURIComponent(p.slug || '')
  const structured = Object.assign(
    { '@context': 'https://schema.org', '@type': 'Product', name: p.name, url },
    p.description ? { description: String(p.description).replace(/\s+/g, ' ').slice(0, 500) } : {},
    images.length ? { image: images.map((i) => i.url) } : {},
    {
      offers: variants.length > 1
        ? { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: (Math.min.apply(null, prices) / 100).toFixed(2), highPrice: (Math.max.apply(null, prices) / 100).toFixed(2), offerCount: variants.length, availability }
        : variants.length === 1
          ? { '@type': 'Offer', priceCurrency: 'USD', price: (variants[0].priceCents / 100).toFixed(2), availability, url }
          : [],
    },
  )
  const selected = (v) => defaultVariant && v.id === defaultVariant.id
  // The upsells (server/crm/store/checkout/catalogue.ts productUpsells): the owner's picks, else the same category.
  const ups = data.upsells || {}
  const together = Array.isArray(ups.together) ? ups.together : []
  const alsoLike = Array.isArray(ups.alsoLike) ? ups.alsoLike : []
  const firstImage = (x) => { const im = Array.isArray(x && x.images) ? x.images : []; return im.find((i) => i.isPrimary) || im[0] || null }
  const buyable = (x) => (Array.isArray(x && x.variants) ? x.variants : []).find((v) => v.inventoryQty === null || typeof v.inventoryQty === 'undefined' || v.inventoryQty > 0) || null
%>
<div class="store-page product-page">
  <div class="container">
    <a href="/shop" class="store-back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
      Back to Shop
    </a>
    <div class="product-detail">
      <div class="product-gallery">
        <div class="product-gallery__main">
          <% if (primary) { %>
            <img data-gallery-main src="<%= primary.url %>" alt="<%= primary.alt || p.name %>" width="800" height="800">
          <% } else { %>
            <div class="product-card__noimg product-gallery__noimg" aria-hidden="true">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
            </div>
          <% } %>
        </div>
        <% if (images.length > 1) { %>
          <div class="product-gallery__thumbs">
            <% images.forEach(function (img, i) { %>
              <button type="button" class="product-gallery__thumb <%= (primary && img.url === primary.url) ? 'is-active' : '' %>" data-gallery-thumb
                data-full="<%= img.url %>" data-alt="<%= img.alt || p.name %>" aria-label="View image <%= i + 1 %>">
                <img src="<%= img.url %>" alt="" loading="lazy" width="120" height="120">
              </button>
            <% }) %>
          </div>
        <% } %>
      </div>
      <div class="product-info">
        <% if (p.featured) { %><span class="product-eyebrow">Featured</span><% } %>
        <h1 class="product-info__name"><%= p.name %></h1>
        <% if (p.tagline) { %><p class="product-info__tagline"><%= p.tagline %></p><% } %>
        <% if (defaultVariant) { %>
          <div class="product-info__price">
            <span class="product-price__now" data-price-display><%= money(defaultVariant.priceCents) %></span>
            <span class="product-price__was" data-compare-display style="<%= (defaultVariant.compareAtPriceCents && defaultVariant.compareAtPriceCents > defaultVariant.priceCents) ? '' : 'display:none' %>"><%= defaultVariant.compareAtPriceCents ? money(defaultVariant.compareAtPriceCents) : '' %></span>
          </div>
        <% } %>
        <p class="product-soldout" data-soldout-msg style="<%= (defaultVariant && defaultVariant.inventoryQty === 0) ? '' : 'display:none' %>">This item is currently sold out.</p>
        <% if (multiVariant) { %>
          <div class="product-variants" role="group" aria-label="Choose an option">
            <span class="product-variants__label">Options</span>
            <div class="product-variants__opts">
              <% variants.forEach(function (v) { %>
                <button type="button" class="variant-option <%= selected(v) ? 'is-selected' : '' %>" data-variant-option aria-pressed="<%= selected(v) ? 'true' : 'false' %>"
                  data-sku="<%= v.sku %>" data-name="<%= v.name %>" data-price="<%= v.priceCents %>" data-price-display="<%= money(v.priceCents) %>"
                  data-compare="<%= (v.compareAtPriceCents && v.compareAtPriceCents > v.priceCents) ? money(v.compareAtPriceCents) : '' %>"
                  data-max="<%= inv(v) %>"<% if (v.inventoryQty === 0) { %> data-soldout="1"<% } %>><%= v.name %><% if (v.inventoryQty === 0) { %> &mdash; sold out<% } %></button>
              <% }) %>
            </div>
          </div>
        <% } %>
        <% if (defaultVariant) { %>
          <div class="product-buy">
            <div class="qty-stepper" data-qty-stepper>
              <button type="button" class="qty-stepper__btn" data-qty-dec aria-label="Decrease quantity">&minus;</button>
              <input type="number" class="qty-stepper__input" data-qty-input value="1" min="1" step="1" inputmode="numeric" aria-label="Quantity">
              <button type="button" class="qty-stepper__btn" data-qty-inc aria-label="Increase quantity">&plus;</button>
            </div>
            <button type="button" class="btn btn--primary btn--lg product-add" data-add-to-cart data-product-add
              data-sku="<%= defaultVariant.sku %>" data-name="<%= p.name %>" data-variant="<%= multiVariant ? defaultVariant.name : '' %>"
              data-price="<%= defaultVariant.priceCents %>" data-image="<%= primary ? primary.url : '' %>" data-max="<%= inv(defaultVariant) %>"
              <%= defaultVariant.inventoryQty === 0 ? 'disabled' : '' %>><span data-add-label><%= defaultVariant.inventoryQty === 0 ? 'Sold out' : 'Add to Cart' %></span></button>
          </div>
        <% } else { %>
          <p class="product-soldout">This item is not available for purchase right now.</p>
        <% } %>
        <a href="/cart" class="product-viewcart">View cart<span class="product-viewcart__count" data-cart-count>0</span></a>
        <% if (p.description) { %>
          <div class="product-description">
            <h2>Details</h2>
            <div class="prose">
              <% String(p.description).split(/\n\n+/).forEach(function (para) { %><p><%= para %></p><% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <% if (together.length) { %>
    <section class="container product-upsell" aria-labelledby="fbt-title">
      <h2 id="fbt-title" class="product-upsell__title">Frequently bought together</h2>
      <div class="product-upsell__row">
        <% together.forEach(function (x) { const img = firstImage(x); const v = buyable(x) %>
          <div class="product-upsell__item">
            <a href="/product/<%= encodeURIComponent(x.slug) %>" class="product-upsell__link">
              <% if (img) { %><img src="<%= img.url %>" alt="<%= img.alt || x.name %>" loading="lazy" width="96" height="96"><% } else { %><span class="product-upsell__noimg" aria-hidden="true"></span><% } %>
              <span class="product-upsell__name"><%= x.name %></span>
            </a>
            <% if (v) { %>
              <span class="product-upsell__price"><%= money(v.priceCents) %></span>
              <button type="button" class="btn btn--secondary btn--sm" data-add-to-cart data-sku="<%= v.sku %>" data-name="<%= x.name %>" data-variant="<%= x.variants.length > 1 ? v.name : '' %>"
                data-price="<%= v.priceCents %>" data-image="<%= img ? img.url : '' %>" data-max="<%= inv(v) %>"><span data-add-label>Add</span></button>
            <% } else { %><span class="product-upsell__price">Sold out</span><% } %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
  <% if (alsoLike.length) { %>
    <section class="container product-upsell" aria-labelledby="ymal-title">
      <h2 id="ymal-title" class="product-upsell__title">You may also like</h2>
      <div class="product-grid product-grid--compact">
        <% alsoLike.forEach(function (x) { const img = firstImage(x); const v = buyable(x) || (x.variants || [])[0] %>
          <a href="/product/<%= encodeURIComponent(x.slug) %>" class="product-card product-card__link">
            <div class="product-card__media">
              <% if (img) { %><img src="<%= img.url %>" alt="<%= img.alt || x.name %>" loading="lazy" width="400" height="400"><% } else { %><div class="product-card__noimg" aria-hidden="true"></div><% } %>
            </div>
            <div class="product-card__body"><span class="product-card__name"><%= x.name %></span><% if (v) { %><span class="product-card__price"><%= money(v.priceCents) %></span><% } %></div>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>
  <%
    // Reviews (store live test, 2026-10-26: no review form on the product page though Product Reviews existed). The
    // approved ones only; a new one is pending until the owner approves it (/api/public/products/:slug/reviews, which
    // holds the same honeypot, time stamp and per-address limit as the contact form).
    const rv = data.reviews || { open: false, reviews: [], summary: { average: 0, count: 0 } }
    const approved = Array.isArray(rv.reviews) ? rv.reviews : []
    const stars = (n) => '★★★★★'.slice(0, Math.round(n)) + '☆☆☆☆☆'.slice(0, 5 - Math.round(n))
  %>
  <% if (approved.length || rv.open) { %>
    <section class="container product-reviews" aria-labelledby="reviews-title">
      <h2 id="reviews-title" class="product-upsell__title">Reviews</h2>
      <% if (rv.summary && rv.summary.count) { %>
        <p class="product-reviews__summary"><span aria-hidden="true"><%= stars(rv.summary.average) %></span> <%= Number(rv.summary.average).toFixed(1) %> out of 5 · <%= rv.summary.count %> review<%= rv.summary.count === 1 ? '' : 's' %></p>
      <% } %>
      <% approved.forEach(function (r) { %>
        <article class="product-review">
          <p class="product-review__stars"><span aria-hidden="true"><%= stars(r.rating) %></span><span class="sr-only"><%= r.rating %> out of 5</span></p>
          <% if (r.title) { %><h3 class="product-review__title"><%= r.title %></h3><% } %>
          <% if (r.body) { %><p class="product-review__body"><%= r.body %></p><% } %>
          <p class="product-review__by"><%= r.authorName %><% if (r.verifiedPurchase) { %> · Verified purchase<% } %></p>
        </article>
      <% }) %>
      <% if (!approved.length) { %><p class="product-reviews__none">No reviews yet.</p><% } %>
      <% if (rv.open) { %>
        <form class="product-review-form contact-form" action="/api/public/products/<%= encodeURIComponent(p.slug || '') %>/reviews" method="post" data-review-form>
          <h3>Write a review</h3>
          <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;">
            <label for="rv-website">Website (leave empty)</label>
            <input id="rv-website" name="website" type="text" tabindex="-1" autocomplete="off">
          </div>
          <input type="hidden" name="t" value="" data-form-stamp>
          <fieldset class="product-review-form__rating">
            <legend>Your rating</legend>
            <% [5, 4, 3, 2, 1].forEach(function (n) { %>
              <label><input type="radio" name="rating" value="<%= n %>" required> <%= n %> star<%= n === 1 ? '' : 's' %></label>
            <% }) %>
          </fieldset>
          <label for="rv-name">Your name</label>
          <input id="rv-name" name="authorName" type="text" maxlength="80" required autocomplete="name">
          <label for="rv-email">Your email (optional — shows "Verified purchase" when it matches an order)</label>
          <input id="rv-email" name="authorEmail" type="email" maxlength="200" autocomplete="email">
          <label for="rv-title">Title (optional)</label>
          <input id="rv-title" name="title" type="text" maxlength="120">
          <label for="rv-body">Your review (optional)</label>
          <textarea id="rv-body" name="body" rows="4" maxlength="4000"></textarea>
          <button type="submit" class="btn btn--primary">Send review</button>
          <p class="contact-form__status" role="status" hidden></p>
        </form>
        <script>(function(){
          var f = document.currentScript.previousElementSibling;
          if (!f || !window.fetch) return;
          var stamp = f.querySelector('[data-form-stamp]'); if (stamp) stamp.value = Date.now();
          f.addEventListener('submit', function(e){
            e.preventDefault();
            var s = f.querySelector('.contact-form__status'), b = f.querySelector('button[type="submit"]');
            var v = function(n){ var i = f.elements[n]; return i ? String(i.value || '').trim() : ''; };
            var picked = f.querySelector('input[name="rating"]:checked');
            if (!picked || !v('authorName')) { s.hidden = false; s.textContent = 'Please choose a rating and give your name.'; return; }
            var body = { rating: Number(picked.value), authorName: v('authorName'), website: v('website'), t: v('t') };
            ['authorEmail', 'title', 'body'].forEach(function(k){ if (v(k)) body[k] = v(k); });
            b.disabled = true;
            fetch(f.action, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) })
              .then(function(r){ return r.json().catch(function(){ return {}; }).then(function(d){ return { ok: r.ok, d: d }; }); })
              .then(function(x){
                s.hidden = false;
                var d = x.d && (x.d.data || x.d);
                s.textContent = x.ok ? ((d && d.message) || 'Thanks! Your review will appear once it is approved.') : ((x.d && (x.d.error || x.d.message)) || 'Your review could not be sent. Please try again.');
                if (x.ok) f.reset(); else b.disabled = false;
              })
              .catch(function(){ s.hidden = false; s.textContent = 'Your review could not be sent. Please try again.'; b.disabled = false; });
          });
        })();</script>
      <% } %>
    </section>
  <% } %>
  <script type="application/ld+json"><%- ld(structured) %></script>
</div>
