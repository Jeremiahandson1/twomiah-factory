<%
  // The shop: every product on sale, read by the server from the store's catalogue (never composed). From
  // templates/website-store views/shop.ejs. data: { products: [{ slug, name, tagline, featured, images[], variants[] }] }
  const items = Array.isArray(data.products) ? data.products : []
  const money = (c) => '$' + ((Number(c) || 0) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  const primaryImage = (p) => { const imgs = Array.isArray(p && p.images) ? p.images : []; return imgs.find((i) => i.isPrimary) || imgs[0] || null }
  const lowestVariant = (p) => { const vs = Array.isArray(p && p.variants) ? p.variants : []; return vs.length ? vs.reduce((lo, v) => (v.priceCents < lo.priceCents ? v : lo), vs[0]) : null }
%>
<div class="store-page shop-page">
  <section class="store-shop-head">
    <div class="container">
      <h1>Shop</h1>
      <p>Browse the full collection from <%= settings.companyName %>.</p>
    </div>
  </section>
  <section class="shop-section">
    <div class="container">
      <% if (!items.length) { %>
        <div class="store-empty">
          <h3>No products yet</h3>
          <p>Check back soon — we're stocking the shelves.</p>
        </div>
      <% } else { %>
        <div class="product-grid">
          <% items.forEach(function (product) {
               const img = primaryImage(product)
               const lv = lowestVariant(product)
               const variantCount = (product.variants && product.variants.length) || 0
               const soldOut = variantCount > 0 && product.variants.every(function (v) { return v.inventoryQty === 0 })
          %>
            <div class="product-card">
              <a href="/product/<%= encodeURIComponent(product.slug) %>" class="product-card__link" aria-label="<%= product.name %>">
                <div class="product-card__media">
                  <% if (img) { %>
                    <img src="<%= img.url %>" alt="<%= img.alt || product.name %>" loading="lazy" width="600" height="600">
                  <% } else { %>
                    <div class="product-card__noimg" aria-hidden="true">
                      <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
                    </div>
                  <% } %>
                  <% if (product.featured) { %><span class="product-badge product-badge--featured">Featured</span><% } %>
                  <% if (soldOut) { %><span class="product-badge product-badge--soldout">Sold out</span><% } %>
                </div>
                <div class="product-card__body">
                  <h3 class="product-card__name"><%= product.name %></h3>
                  <% if (product.tagline) { %><p class="product-card__tagline"><%= product.tagline %></p><% } %>
                  <% if (lv) { %>
                    <div class="product-price">
                      <% if (variantCount > 1) { %><span class="product-price__from">From</span><% } %>
                      <span class="product-price__now"><%= money(lv.priceCents) %></span>
                      <% if (lv.compareAtPriceCents && lv.compareAtPriceCents > lv.priceCents) { %><span class="product-price__was"><%= money(lv.compareAtPriceCents) %></span><% } %>
                    </div>
                  <% } %>
                </div>
              </a>
              <% if (lv) { %>
                <button type="button" class="btn btn--primary product-card__add add-to-cart" data-add-to-cart
                  data-sku="<%= lv.sku %>" data-name="<%= product.name %>" data-variant="<%= variantCount > 1 ? lv.name : '' %>"
                  data-price="<%= lv.priceCents %>" data-image="<%= img ? img.url : '' %>"
                  data-max="<%= (lv.inventoryQty === null || typeof lv.inventoryQty === 'undefined') ? '' : lv.inventoryQty %>"
                  <%= lv.inventoryQty === 0 ? 'disabled' : '' %>><%= lv.inventoryQty === 0 ? 'Sold out' : 'Add to cart' %></button>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
</div>
