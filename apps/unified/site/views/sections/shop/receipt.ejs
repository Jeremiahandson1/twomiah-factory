<%
  // The order received: what the shopper paid for, read by the server (the order summary, which also finishes an order
  // whose payment confirmation is late). From templates/website-store views/checkout-success.ejs.
  // data: { order: { orderNumber, status, email, subtotalCents, shippingCents, taxCents, discountCents,
  //   loyaltyDiscountCents, discountCode, totalCents, refundedCents, currency, items: [...] } | null }
  const o = data.order || null
  const items = (o && Array.isArray(o.items)) ? o.items : []
  const money = (c) => '$' + ((Number(c) || 0) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  // The discount as the receipt shows it, the code's share and the loyalty reward's, or the lines don't add up (E2E Run 2).
  const discTotal = (o && o.discountCents > 0) ? o.discountCents : 0
  const discLoyalty = (o && o.loyaltyDiscountCents > 0) ? Math.min(discTotal, o.loyaltyDiscountCents) : 0
  // A refunded or cancelled order is not "confirmed": the link in the shopper's email still opens it.
  const closed = o && (o.status === 'refunded' || o.status === 'cancelled')
  // Not paid yet (the shopper came back before paying, or the payment hasn't cleared): never "confirmed", and the cart is
  // kept so they can try again — the template said "Thank you … is confirmed" here (found in the Square sandbox check).
  const waiting = o && o.status === 'pending'
%>
<div class="store-page checkout-success-page">
  <div class="container container--narrow">
    <div class="order-confirm">
      <div class="order-confirm__icon<%= waiting ? ' order-confirm__icon--waiting' : '' %>" aria-hidden="true">
        <% if (waiting) { %><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
        <% } else { %><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg><% } %>
      </div>
      <h1 class="order-confirm__title"><%= waiting ? "We haven't received your payment yet" : closed ? (o.status === 'refunded' ? 'This order was refunded' : 'This order was cancelled') : 'Thank you for your order!' %></h1>
      <% if (waiting) { %>
        <p class="order-confirm__lead">If you've just paid, it can take a moment to come through — refresh this page in a minute. If you didn't finish paying, nothing has been charged and your cart is still saved.</p>
        <div class="order-confirm__actions"><a href="/cart" class="btn btn--primary btn--lg">Back to your cart</a></div>
      <% } else { %>
      <% if (o) { %>
        <p class="order-confirm__lead">
          <% if (closed) { %>Your order <strong>#<%= o.orderNumber %></strong> was <%= o.status %>. Contact us if you have any questions.<% } else { %>Your order <strong>#<%= o.orderNumber %></strong> is confirmed.
          <% if (o.email) { %>A receipt is on its way to <strong><%= o.email %></strong>.<% } else { %>A receipt is on its way to your inbox.<% } %><% } %>
        </p>
        <% if (o.fulfillment === 'pickup' && o.pickup) { %>
          <div class="order-card order-pickup">
            <h2 class="order-pickup__title">Pick up from</h2>
            <p class="order-pickup__where"><%= o.pickup.address %></p>
            <% if (o.pickup.hours) { %><p class="order-pickup__when"><%= o.pickup.hours %></p><% } %>
            <p class="order-pickup__note">We'll email you when it's ready.</p>
          </div>
        <% } %>
        <% if (items.length) { %>
          <div class="order-card">
            <div class="order-items">
              <% items.forEach(function (it) { %>
                <div class="order-item">
                  <div class="order-item__media">
                    <% if (it.imageUrl) { %><img src="<%= it.imageUrl %>" alt="" width="72" height="72"><% } else { %>
                      <div class="product-card__noimg" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg></div>
                    <% } %>
                  </div>
                  <div class="order-item__info">
                    <span class="order-item__name"><%= it.productName %></span>
                    <% if (it.variantName && it.variantName !== 'Default') { %><span class="order-item__variant"><%= it.variantName %></span><% } %>
                    <span class="order-item__qty">Qty <%= it.quantity %></span>
                  </div>
                  <div class="order-item__total"><%= money(it.lineTotalCents) %></div>
                </div>
              <% }) %>
            </div>
            <div class="order-summary">
              <div class="order-summary__row"><span>Subtotal</span><span><%= money(o.subtotalCents) %></span></div>
              <% if (discTotal - discLoyalty > 0) { %><div class="order-summary__row"><span>Discount<%= o.discountCode ? ' (' + o.discountCode + ')' : '' %></span><span>&minus;<%= money(discTotal - discLoyalty) %></span></div><% } %>
              <% if (discLoyalty > 0) { %><div class="order-summary__row"><span>Loyalty reward</span><span>&minus;<%= money(discLoyalty) %></span></div><% } %>
              <% if (o.fulfillment === 'pickup') { %><div class="order-summary__row"><span>Pickup</span><span>Free</span></div><% } else if (o.fulfillment !== 'digital') { %><div class="order-summary__row"><span>Shipping</span><span><%= (o.shippingCents && o.shippingCents > 0) ? money(o.shippingCents) : 'Free' %></span></div><% } %>
              <div class="order-summary__row"><span><%= o.taxAutomatic ? 'Sales tax' : 'Tax' %></span><span><%= money(o.taxCents) %></span></div>
              <div class="order-summary__row order-summary__row--total"><span>Total</span><span><%= money(o.totalCents) %></span></div>
              <% if (o.giftCardCents > 0) { %><div class="order-summary__row"><span>Paid by gift card</span><span>&minus;<%= money(o.giftCardCents) %></span></div><div class="order-summary__row"><span>Paid by card</span><span><%= money(Math.max(0, o.totalCents - o.giftCardCents)) %></span></div><% } %>
              <% if (o.refundedCents > 0 && o.refundedCents < o.totalCents) { %><div class="order-summary__row"><span>Refunded</span><span>&minus;<%= money(o.refundedCents) %></span></div><% } %>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <p class="order-confirm__lead">Your order is confirmed &mdash; a receipt is on its way to your inbox. Thank you for shopping with <%= settings.companyName %>.</p>
      <% } %>
      <div class="order-confirm__actions"><a href="/shop" class="btn btn--primary btn--lg">Continue Shopping</a></div>
      <% } %>
    </div>
  </div>
  <%# The order went through: /scripts/cart.js empties the saved cart when it sees this. %>
  <% if (!closed && !waiting) { %><div data-cart-clear hidden></div><% } %>
</div>
