<%
  // The cart: no server data — /scripts/cart.js fills #cart-root from the browser's saved cart. From
  // templates/website-store views/cart.ejs.
%>
<div class="store-page cart-page">
  <div class="container">
    <a href="/shop" class="store-back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
      Continue Shopping
    </a>
    <h1 class="cart-title">Your Cart</h1>
    <div id="cart-root" class="cart-root">
      <div class="cart-loading">
        <div class="loading-spinner" aria-hidden="true"></div>
        <p>Loading your cart&hellip;</p>
      </div>
    </div>
    <noscript><p class="store-empty">Your cart needs JavaScript to work in this browser.</p></noscript>
  </div>
</div>
