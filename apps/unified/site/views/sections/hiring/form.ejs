<%
  // "Now hiring" — the jobs the owner lists, and an application form. The Web presence plan's second form: the owner switches
  // it on or off in the editor, and a site with it off has no section, no link and no endpoint (the page is drawn without it).
  // The application goes to /api/apply (the site's own function), which hands it to Netlify Forms — emailed to the owner, kept
  // by nobody else. An applicant's details are personal: nothing here puts them in the page, the address or a script.
  // data: { heading, intro, jobs: [{ title, blurb, type }], resumeLimitMb }
  const heading = data.heading || 'Now hiring'
  const intro = data.intro || ''
  const jobs = Array.isArray(data.jobs) ? data.jobs.filter((j) => j && j.title) : []
  const limitMb = Number(data.resumeLimitMb) > 0 ? Number(data.resumeLimitMb) : 3
  const TYPES = { full: 'Full time', part: 'Part time' }
%>
<section class="wp-hiring section" id="hiring">
  <div class="container wp-hiring__grid">
    <div class="wp-hiring__copy">
      <h2 class="section-title"><%= heading %></h2>
      <% if (intro) { %><p class="section-intro"><%= intro %></p><% } %>
      <% if (jobs.length) { %>
        <ul class="wp-hiring__jobs">
          <% for (const j of jobs) { %>
            <li>
              <strong><%= j.title %></strong><% if (TYPES[j.type]) { %> <span class="wp-hiring__type"><%= TYPES[j.type] %></span><% } %>
              <% if (j.blurb) { %><span class="wp-hiring__blurb"><%= j.blurb %></span><% } %>
            </li>
          <% } %>
        </ul>
      <% } %>
    </div>
    <form class="contact-form wp-hiring__form" action="/api/apply" method="post" enctype="multipart/form-data">
      <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;">
        <label for="ap-website">Website (leave empty)</label>
        <input id="ap-website" name="website" type="text" tabindex="-1" autocomplete="off">
      </div>
      <input type="hidden" name="t" value="" data-form-stamp>
      <script>(function(){var s=document.currentScript.previousElementSibling;if(s&&s.name==='t')s.value=Date.now();})();</script>
      <% if (jobs.length > 1) { %>
        <div class="contact-form__row">
          <label for="ap-job">Which job?</label>
          <select id="ap-job" name="job">
            <% for (const j of jobs) { %><option value="<%= j.title %>"><%= j.title %></option><% } %>
          </select>
        </div>
      <% } else if (jobs.length === 1) { %>
        <input type="hidden" name="job" value="<%= jobs[0].title %>">
      <% } %>
      <div class="contact-form__row">
        <label for="ap-name">Your name</label>
        <input id="ap-name" name="name" type="text" required minlength="2" autocomplete="name" aria-describedby="ap-name-err" data-msg="Please enter your name.">
        <p class="contact-form__error" id="ap-name-err" hidden></p>
      </div>
      <div class="contact-form__row">
        <label for="ap-email">Email</label>
        <input id="ap-email" name="email" type="email" required autocomplete="email" aria-describedby="ap-email-err" data-msg="Please enter your email address." data-msg-invalid="Please enter a valid email address, like name@example.com.">
        <p class="contact-form__error" id="ap-email-err" hidden></p>
      </div>
      <div class="contact-form__row">
        <label for="ap-phone">Phone</label>
        <input id="ap-phone" name="phone" type="tel" autocomplete="tel">
      </div>
      <div class="contact-form__row">
        <label for="ap-about">A little about you</label>
        <textarea id="ap-about" name="about" rows="4" required minlength="4" maxlength="2000" aria-describedby="ap-about-err" data-msg="Please tell us a little about yourself."></textarea>
        <p class="contact-form__error" id="ap-about-err" hidden></p>
      </div>
      <div class="contact-form__row">
        <label for="ap-avail">When can you work?</label>
        <input id="ap-avail" name="availability" type="text" maxlength="300">
      </div>
      <div class="contact-form__row">
        <label for="ap-resume">Resume (optional)</label>
        <input id="ap-resume" name="resume" type="file" accept=".pdf,.doc,.docx,application/pdf" aria-describedby="ap-resume-help ap-resume-err" data-max-mb="<%= limitMb %>">
        <p class="wp-hiring__help" id="ap-resume-help">PDF, DOC or DOCX, up to <%= limitMb %> MB.</p>
        <p class="contact-form__error" id="ap-resume-err" hidden></p>
      </div>
      <button class="btn btn--primary btn--lg" type="submit">Send application</button>
      <p class="contact-form__status" role="status" aria-live="polite" hidden></p>
    </form>
    <script>(function(){
      var f = document.currentScript.previousElementSibling;
      if (!f || !window.fetch || !window.FormData) return;
      f.noValidate = true;
      var show = function(i, msg){ var p = document.getElementById(i.getAttribute('aria-describedby').split(' ').pop()); if (!p) return; p.textContent = msg || ''; p.hidden = !msg; if (msg) i.setAttribute('aria-invalid', 'true'); else i.removeAttribute('aria-invalid'); };
      var problem = function(i){
        var v = (i.value || '').trim(), min = Number(i.getAttribute('minlength')) || 1;
        if (i.type === 'file') {
          var file = i.files && i.files[0];
          if (!file) return '';
          if (!/\.(pdf|docx?)$/i.test(file.name)) return 'Please attach a PDF, DOC or DOCX file.';
          if (file.size > (Number(i.getAttribute('data-max-mb')) || 3) * 1024 * 1024) return 'That file is too big. The limit is ' + (i.getAttribute('data-max-mb') || 3) + ' MB.';
          return '';
        }
        if (i.required && v.length < min) return i.getAttribute('data-msg');
        if (i.type === 'email' && v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return i.getAttribute('data-msg-invalid');
        return '';
      };
      f.querySelectorAll('[data-msg], [data-max-mb]').forEach(function(i){ i.addEventListener('input', function(){ if (i.getAttribute('aria-invalid')) show(i, problem(i)); }); i.addEventListener('change', function(){ show(i, problem(i)); }); });
      f.addEventListener('submit', function(e){
        e.preventDefault();
        var first = null;
        f.querySelectorAll('[data-msg], [data-max-mb]').forEach(function(i){ var m = problem(i); show(i, m); if (m && !first) first = i; });
        if (first) { first.focus(); return; }
        var b = f.querySelector('button[type="submit"]'), s = f.querySelector('.contact-form__status');
        b.disabled = true;
        fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } })
          .then(function(r){ return r.json().catch(function(){ return {}; }).then(function(d){ return { ok: r.ok, d: d }; }); })
          .then(function(x){
            s.hidden = false;
            if (x.ok) { s.textContent = x.d.message || 'Thanks — your application was sent.'; f.reset(); }
            else { s.textContent = x.d.error || 'That didn’t go through. Please try again.'; b.disabled = false; }
          })
          .catch(function(){ s.hidden = false; s.textContent = 'That didn’t go through. Please check your connection and try again.'; b.disabled = false; });
      });
    })();</script>
  </div>
</section>
<style>
  .wp-hiring { padding: var(--space) 0; background: var(--paper); }
  .wp-hiring__grid { display: grid; gap: 40px; grid-template-columns: 1fr 1fr; align-items: start; }
  .wp-hiring__copy .section-title, .wp-hiring__copy .section-intro { text-align: left; }
  .wp-hiring__jobs { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 12px; }
  .wp-hiring__jobs li { display: grid; gap: 4px; padding: 14px 16px; background: var(--white); color: var(--ink); border: 1px solid var(--line); border-radius: 12px; }
  .wp-hiring__type { font-size: .85rem; color: var(--muted); font-weight: 600; }
  .wp-hiring__blurb { color: var(--muted); }
  .wp-hiring__help { margin: 4px 0 0; font-size: .9rem; color: var(--muted); }
  @media (max-width: 800px) { .wp-hiring__grid { grid-template-columns: 1fr; } }
</style>
