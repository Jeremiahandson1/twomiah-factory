<%
  // Project cards: each photo as a card with its title (p.title, else caption) and a place or detail line (p.location).
  // Offered only when every photo has a title (server/site/layouts.ts).
  const heading = data.heading || ''
  const intro = data.intro || ''
  const photos = Array.isArray(data.photos) ? data.photos.filter(p => p && p.url) : []
  if (photos.length === 0) return
%>
<section class="gallery-section gallery-section--cards">
  <div class="container">
    <% if (heading || intro) { %><div class="gallery-section__head">
      <% if (heading) { %><h2 class="gallery-section__title"><%= heading %></h2><% } %>
      <% if (intro) { %><p class="gallery-section__intro"><%= intro %></p><% } %>
    </div><% } %>
    <div class="gallery-cards">
      <% photos.forEach(function (p) { %>
        <article class="gallery-cards__card">
          <img src="<%= p.url %>" alt="<%= p.alt || '' %>" loading="lazy">
          <div class="gallery-cards__body">
            <h3><%= p.title || p.caption || '' %></h3>
            <% if (p.location) { %><p><%= p.location %></p><% } else if (p.title && p.caption) { %><p><%= p.caption %></p><% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
