<%
  // Section composition renderer.
  //
  // homepage.sections is an array of { type, variant, data }. Each entry renders
  // views/sections/<type>/<variant>.ejs with { data, settings, words }, and:
  //   site, live    a vertical's live facts (the bar's menu, taps, hours, Tonight; server/site/facts.ts), else null
  //   md            the owner's markdown as HTML (an event's description, an era of the story)
  //   currentPath   the page, which a form names as where it was sent from
  //   isFirst       the section opens the page, so its heading is the page's h1 (the story, the contact section)
  //   smsConsent    the "Text me" box for a form that asks for a phone (server/site/smsConsent.ts) — one wording everywhere
  //
  // A section that doesn't exist is skipped, so a composition naming a section this site lacks still renders the
  // rest. Any OTHER failure inside a section is logged and recorded on `sectionErrors` (the tests read it): the
  // template this came from swallowed every error, so a section that broke simply vanished from the page.
  const sections = Array.isArray(homepage.sections) ? homepage.sections : []
  const _site = typeof site !== 'undefined' ? site : null
  const _live = typeof live !== 'undefined' ? live : null
  const _md = typeof md === 'function' ? md : function (t) { return String(t || '') }
  const _path = typeof currentPath !== 'undefined' ? currentPath : ''
  const _consent = typeof smsConsent === 'function' ? smsConsent : null
%>
<% sections.forEach(function (section, index) { %>
  <%
    const type = (section && section.type) ? String(section.type).replace(/[^a-z0-9_-]/gi, '') : ''
    const variant = (section && section.variant) ? String(section.variant).replace(/[^a-z0-9_-]/gi, '') : 'default'
    const data = (section && section.data) || {}
    // Single-page mode: the first section of each former "page" carries a scroll anchor so the nav (#menu, #visit…)
    // can target it (the bar's one-page site; base.ejs scrolls to it).
    const onepageAnchor = section && section._onepageAnchor ? String(section._onepageAnchor).replace(/[^a-z0-9_-]/gi, '') : ''
    if (!type) { return }
  %>
  <% if (onepageAnchor) { %><span id="<%= onepageAnchor %>" class="onepage-anchor" aria-hidden="true"></span><% } %>
  <% try { %>
    <%- include('sections/' + type + '/' + variant, { data: data, settings: settings, words: words, site: _site, live: _live, md: _md, currentPath: _path, isFirst: index === 0, smsConsent: _consent }) %>
  <% } catch (e) {
       if (!/Could not find the include file/.test(String(e && e.message))) {
         console.error('[site] section ' + type + '/' + variant + ' failed: ' + (e && e.message));
         if (typeof sectionErrors !== 'undefined') sectionErrors.push({ section: type + '/' + variant, error: String(e && e.message) });
       }
     } %>
<% }) %>
