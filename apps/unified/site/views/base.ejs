<%
  // The page around the sections, for every design. A design with the book frame (siteOptions.cover: the bar's leather
  // book, server/core/vertical.ts SITE_DESIGN_SPECS frame 'book') wears its own frame, as templates/website-premium-bar's
  // base.ejs drew it:
  // dark first, its self-hosted faces, the owner's cover art, the brass caps and corners around the page, the header
  // that folds into its menu button when the row doesn't fit, and the one-page anchors. Every other design is the
  // premium templates' shared layout, unchanged. A whole look without the frame (SITE_DESIGN_SPECS build 'whole') takes
  // the standard page and brings only its own type (siteOptions.fonts) and its light/dark (siteOptions.schemes).
  var cover = typeof siteOptions !== 'undefined' && siteOptions && siteOptions.cover;
  // The booking pages framed on another website (/scripts/book-embed.js, ?embed=1): the page alone — no header, menu,
  // footer or tracking (it would count the host's visitors twice), kept out of search, telling the frame its height.
  var _embed = typeof embed !== 'undefined' && !!embed;
  var seoTitle = settings.seoTitle || settings.companyName || 'Website';
  var seoDescription = settings.seoDescription || '';
  var canonicalBase = (settings.siteOrigin || '').replace(/\/+$/, '');
  var canonical = canonicalBase ? canonicalBase + (currentPath || '/') : '';
  var pageJsonLd = typeof jsonLd !== 'undefined' && jsonLd ? jsonLd : '';
  // Where the header's button goes when the site names no page: the vertical's own (a bar's Find us page), else contact.
  var ctaHref = settings.contactHref || (typeof siteOptions !== 'undefined' && siteOptions && siteOptions.ctaHref) || '/contact';
  if (cover) {
    // Theme: the leather cover (bar.css "THE COVER") is dark in every mode, so 'auto' pins the dark palette too.
    // Following a phone's light setting put dark ink straight on black leather (intro text, nav) and failed contrast.
    // 'light' is still honoured when the owner picks it on purpose.
    var theme = settings.theme === 'light' ? 'light' : 'dark';
    // Typography from settings. Each family also needs a real fallback stack in CSS (bar.css) — these vars only
    // override the family name.
    var fD = settings.fontDisplay || 'Cinzel Decorative';
    var fE = settings.fontEyebrow || 'Cinzel';
    var fB = settings.fontBody || 'Lora';
    var fM = settings.fontMono || 'Special Elite';
    var spec = {
      'Cinzel': 'Cinzel:wght@400;600',
      'Lora': 'Lora:ital,wght@0,400;0,600;1,400',
      'Bodoni Moda': 'Bodoni+Moda:wght@700;900',
      'Libre Baskerville': 'Libre+Baskerville:ital,wght@0,400;0,700;1,400',
      'Cormorant Garamond': 'Cormorant+Garamond:ital,wght@0,400;0,600;1,400',
      'Courier Prime': 'Courier+Prime:wght@400;700',
    };
    var seen = {};
    var families = [fD, fE, fB, fM, 'Great Vibes'].filter(function (n) { if (!n || seen[n]) return false; seen[n] = true; return true; });
    // Self-hosted faces (site/public/fonts + styles/fonts.css). Anything else falls back to a Google Fonts request.
    var selfHosted = { 'Limelight': 'Limelight-400', 'Cinzel': 'Cinzel-400', 'Cinzel Decorative': 'CinzelDecorative-700', 'Lora': 'Lora-400', 'Special Elite': 'SpecialElite-400', 'Great Vibes': 'GreatVibes-400' };
    var remote = families.filter(function (n) { return !selfHosted[n]; });
    var coverFontsHref = remote.length ? 'https://fonts.googleapis.com/css2?family=' + remote.map(function (n) { return spec[n] || String(n).replace(/ /g, '+'); }).join('&family=') + '&display=swap' : '';
    var useLocal = families.some(function (n) { return !!selfHosted[n]; });
    var q = function (n) { return "'" + String(n).replace(/'/g, '') + "'"; };
    // Metric-matched local fallbacks so the swap from system font to web font doesn't shift layout (CLS).
    var fallback = {
      'Limelight': { local: 'Georgia', size: '119.5%' },
      'Cinzel': { local: 'Georgia', size: '118.6%' },
      'Cinzel Decorative': { local: 'Georgia', size: '132.5%' },
      'Lora': { local: 'Georgia', size: '102.9%' },
      'Special Elite': { local: 'Courier New', size: '87.7%' },
    };
    var stack = function (n, generic) { var f = fallback[n]; return q(n) + (f ? ", '" + n + " Fallback', " : ", ") + generic; };
  }
%><!doctype html>
<html lang="en"<% if (cover) { %> data-theme="<%= theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <% if (cover) { %>
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#121010" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#F4F2ED" media="(prefers-color-scheme: light)">
  <% } else if (typeof siteOptions !== 'undefined' && siteOptions && siteOptions.schemes) { %>
  <meta name="color-scheme" content="light dark">
  <% } %>
  <%
    // Social cards need an absolute URL, and Facebook/X ignore SVG — so an SVG
    // logo (including the synthesized /images/logo.svg) gives way to the page's
    // hero photo when there is one.
    var _hero = typeof lcpImage !== 'undefined' && lcpImage ? lcpImage : '';
    var _logo = settings.logoUrl || settings.heroPhotoUrl || '';
    var ogImage = /\.svg(\?|$)/i.test(_logo) && _hero ? _hero : _logo;
    if (ogImage && ogImage.charAt(0) === '/' && ogImage.charAt(1) !== '/' && canonicalBase) ogImage = canonicalBase + ogImage;
  %>
  <title><%= seoTitle %></title>
  <meta name="description" content="<%= seoDescription %>">
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta name="robots" content="<%= _embed ? 'noindex, nofollow' : 'index, follow' %>">
  <% if (typeof crmApiUrl !== 'undefined' && crmApiUrl) { %><meta name="twomiah-crm-url" content="<%= crmApiUrl %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= seoTitle %>">
  <meta property="og:description" content="<%= seoDescription %>">
  <% if (canonical) { %><meta property="og:url" content="<%= canonical %>"><% } %>
  <% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
  <% if (settings.companyName) { %><meta property="og:site_name" content="<%= settings.companyName %>"><% } %>
  <meta name="twitter:card" content="<%= ogImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= seoTitle %>">
  <meta name="twitter:description" content="<%= seoDescription %>">
  <% if (ogImage) { %><meta name="twitter:image" content="<%= ogImage %>"><% } %>
  <% if (settings.faviconUrl) { %><link rel="icon" href="<%= settings.faviconUrl %>"><% } else { %><%# No icon chosen: say so, or every browser asks for /favicon.ico and logs a 404 as a console error. %><link rel="icon" href="data:,"><% } %>
  <% if (settings.appleTouchIconUrl) { %><link rel="apple-touch-icon" href="<%= settings.appleTouchIconUrl %>"><% } %>
  <%# The page's schema.org JSON-LD (the business, its services, hours, questions and breadcrumbs) is built in server/site/structuredData.ts and printed with the page's own below. %>
  <% if (typeof lcpPreloads !== 'undefined' && lcpPreloads && lcpPreloads.length) { %>
    <%# The first hero's photo, one preload per screen size: the browser starts only the one that matches (server/site/heroImages.ts). %>
    <% lcpPreloads.forEach(function (p) { %><link rel="preload" as="image" type="image/webp" href="<%= p.href %>"<% if (p.media) { %> media="<%= p.media %>"<% } %><% if (p.srcset) { %> imagesrcset="<%= p.srcset %>" imagesizes="<%= p.sizes %>"<% } %> fetchpriority="high">
    <% }) %>
  <% } else if (typeof lcpImage !== 'undefined' && lcpImage) { %>
    <link rel="preload" as="image" href="<%= lcpImage %>" fetchpriority="high">
  <% } %>
  <% if (cover) { %>
  <% if (useLocal) { %>
  <% [fD, fB, fM].forEach(function (n) { if (selfHosted[n]) { %><link rel="preload" as="font" type="font/woff2" href="/fonts/<%= selfHosted[n] %>.woff2" crossorigin>
  <% } }) %>
  <link rel="stylesheet" href="/styles/fonts.css?v=<%= typeof assetV === 'undefined' ? '' : assetV %>">
  <% } %>
  <% if (coverFontsHref) { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% } %>
  <link rel="stylesheet" href="/styles/main.css?v=<%= typeof assetV === 'undefined' ? '' : assetV %>">
  <style>
    <% families.forEach(function (n) { var f = fallback[n]; if (!f) return; %>@font-face { font-family: '<%= n %> Fallback'; src: local('<%= f.local %>'); size-adjust: <%= f.size %>; }
    <% }) %>:root {
      --font-display: <%- stack(fD, "'Georgia', serif") %>;
      --font-eyebrow: <%- stack(fE, "'Georgia', serif") %>;
      --font-body: <%- stack(fB, "'Georgia', 'Times New Roman', serif") %>;
      --font-mono: <%- stack(fM, "'Courier New', ui-monospace, monospace") %>;
      <%
        // The owner's cover art (uploaded photos), when they have it — see bar.css "THE COVER".
        var _art = settings.brandArt && typeof settings.brandArt === 'object' ? settings.brandArt : {};
        var _u = function (v) { return typeof v === 'string' && /^(\/|https:\/\/)[^'"()\s<>]+$/.test(v) ? "url('" + v + "')" : ''; };
      %><% if (_u(_art.leather)) { %>--art-leather: <%- _u(_art.leather) %>;<% } %><% if (_u(_art.corner)) { %>--art-corner: <%- _u(_art.corner) %>;<% } %><% if (_u(_art.rivet)) { %>--art-rivet: <%- _u(_art.rivet) %>;<% } %>
    }
  </style>
  <% if (coverFontsHref) { %>
  <link rel="stylesheet" href="<%= coverFontsHref %>" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="<%= coverFontsHref %>"></noscript>
  <% } %>
  <% } else { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin>
  <link rel="stylesheet" href="/styles/main.css?v=<%= typeof assetV === 'undefined' ? '' : assetV %>">
  <%
    // Font CSS is loaded via the media-toggle pattern so it stops blocking
    // the initial render — display=swap already keeps text visible while
    // fonts download, but the stylesheet itself was still a critical-path
    // request. Mobile LCP improves ~300-600ms in field testing.
    var fontsHref = (typeof siteOptions !== 'undefined' && siteOptions && siteOptions.fonts) || 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:wght@400;600;700;900&display=swap';
  %>
  <link rel="stylesheet" href="<%= fontsHref %>" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="<%= fontsHref %>"></noscript>
  <% } %>
  <% if (pageJsonLd) { %>
  <script type="application/ld+json"><%- pageJsonLd %></script>
  <% } %>
  <%/* Tracking — PLAIN standard snippets on purpose (Tag Assistant / Ads
       verification detect these; the deferred loader is opt-in elsewhere). */%>
  <% const _tGtm = _embed ? '' : settings.googleTagManagerId || ''; const _tGa = _embed ? '' : settings.googleAnalyticsId || ''; const _tAds = _embed ? '' : settings.googleAdsId || ''; const _tFb = _embed ? '' : settings.facebookPixelId || ''; const _tCl = _embed ? '' : settings.microsoftClarityId || ''; %>
  <% if (_tGtm) { %>
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%= _tGtm %>');</script>
  <% } %>
  <%/* With a Tag Manager container, every Google tag lives inside it: nothing printed beside it (docs/TRACKING_STANDARD.md). */%>
  <% if (!_tGtm && (_tGa || _tAds)) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= _tGa || _tAds %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());<% if (_tGa) { %>gtag('config','<%= _tGa %>');<% } %><% if (_tAds) { %>gtag('config','<%= _tAds %>');<% } %></script>
  <% } %>
  <% if (_tFb) { %>
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','<%= _tFb %>');fbq('track','PageView');</script>
  <% } %>
  <% if (_tCl) { %>
  <script>(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","<%= _tCl %>");</script>
  <% } %>
</head>
<body>
<%/* The frame needs a title for screen readers (the bar template's fix, for every design). */%>
<% if (_tGtm) { %><noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= _tGtm %>" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript><% } %>
<%/* The one #form-success on the page (docs/TRACKING_STANDARD.md): hidden from load, shown by twomiahLeadSent() only when
     the server accepted a lead. A Tag Manager Element Visibility trigger on #form-success is how Google counts a form
     conversion, so every lead form on every page calls it — never a form's own id. */%>
<div id="form-success" role="status" aria-live="polite" style="display:none;position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:9999;max-width:min(92vw,28rem);color:#166534;background:#f0fdf4;border:1px solid #bbf7d0;padding:12px 16px;border-radius:8px;font:500 15px/1.4 system-ui,-apple-system,'Segoe UI',sans-serif;box-shadow:0 4px 16px rgba(0,0,0,.12)">Thanks — we got your message.</div>
<script>window.twomiahLeadSent=function(t){var e=document.getElementById('form-success');if(!e)return;if(t)e.textContent=t;e.style.display='block';clearTimeout(e._h);e._h=setTimeout(function(){e.style.display='none'},10000)};</script>
  <%/* Skip link: the first thing a keyboard or screen-reader user reaches,
       hidden until focused. Fixed colours so it reads on every theme. */%>
  <style>.skip-link{position:absolute;left:8px;top:-100px;z-index:10000;padding:10px 16px;background:#111;color:#fff;font:600 15px/1.2 system-ui,sans-serif;border-radius:6px;text-decoration:none}.skip-link:focus{top:8px;outline:3px solid #fff;outline-offset:2px}#main:focus{outline:none}</style>
  <a class="skip-link" href="#main">Skip to content</a>
  <% if (!_embed) { %>
  <% if (cover) { %>
  <%/* The book cover: brass caps and corner flourishes frame the page (bar.css "THE COVER"). */%>
  <div class="cover"><span class="cap cap--tl" aria-hidden="true"></span><span class="cap cap--tr" aria-hidden="true"></span><span class="cap cap--bl" aria-hidden="true"></span><span class="cap cap--br" aria-hidden="true"></span><span class="flourish flourish--tl" aria-hidden="true"></span><span class="flourish flourish--tr" aria-hidden="true"></span><span class="flourish flourish--bl" aria-hidden="true"></span><span class="flourish flourish--br" aria-hidden="true"></span>
  <% } %>
  <header class="site-header">
    <div class="container header-inner">
      <%/* An uploaded logo replaces the text wordmark — the owner's header lettering first (a photo tagged
           header-logo; the bar's facts). /images/logo.svg is the generator's synthesized placeholder (initial +
           name), never a real logo, so it keeps the text wordmark. */%>
      <% var headerLogo = settings.headerLogoUrl || (settings.logoUrl && settings.logoUrl !== '/images/logo.svg' ? settings.logoUrl : ''); %>
      <a class="brand<%= headerLogo ? ' brand--logo' : '' %>" href="<%= settings.homeHref || '/' %>"><% if (headerLogo) { %><img src="<%= headerLogo %>" alt="<%= settings.companyName || 'Home' %>" style="display:block;height:44px;width:auto;max-width:min(340px,58vw);object-fit:contain;"><% } else { %><%= settings.companyName || 'Your Company' %><% } %></a>
      <nav class="primary-nav" aria-label="Primary">
        <% (settings.nav || []).forEach(function(item) { %>
          <a href="<%= item.href %>"<%- currentPath && currentPath === ('/' + String(item.href || '').replace(/^\//, '')) ? ' aria-current="page"' : '' %>><%= item.label %></a>
        <% }) %>
      </nav>
      <% if (typeof siteOptions !== 'undefined' && siteOptions.shop) { %>
        <%/* A store's cart, with how many items are in it (/scripts/cart.js fills the count from the saved cart). */%>
        <a class="header-cart" href="/cart" aria-label="View cart"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg><span class="header-cart__count" data-cart-count data-cart-count-hide-empty style="display:none">0</span></a>
      <% } %>
      <%/* A cover site with no menu items is a one-page site (a bar "opening soon"): no button pointing at a page that
           is not published, and no menu toggle opening an empty menu. (Amber Inn, 10/17) */%>
      <% var onePage = cover && !(settings.nav || []).length; %>
      <% if (!onePage) { %>
      <a class="header-cta" href="<%= ctaHref %>"><%= settings.contactCtaLabel || 'Get a quote' %></a>
      <button class="mobile-nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
      <% } %>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile primary" hidden>
      <% (settings.nav || []).forEach(function(item) { %>
        <a href="<%= item.href %>"<%- currentPath && currentPath === ('/' + String(item.href || '').replace(/^\//, '')) ? ' aria-current="page"' : '' %>><%= item.label %></a>
      <% }) %>
      <a class="mobile-nav__cta" href="<%= ctaHref %>"><%= settings.contactCtaLabel || 'Get a quote' %></a>
    </nav>
  </header>
  <% if (cover) { %>
  <script>
    (function(){
      var btn = document.querySelector('.mobile-nav-toggle');
      var nav = document.getElementById('mobile-nav');
      if (!btn || !nav) return;
      btn.addEventListener('click', function(){
        var open = !nav.hasAttribute('hidden');
        if (open) { nav.setAttribute('hidden',''); btn.setAttribute('aria-expanded','false'); btn.classList.remove('is-open'); btn.setAttribute('aria-label','Open menu'); }
        else { nav.removeAttribute('hidden'); btn.setAttribute('aria-expanded','true'); btn.classList.add('is-open'); btn.setAttribute('aria-label','Close menu'); }
      });
      nav.querySelectorAll('a').forEach(function(a){
        a.addEventListener('click', function(){ nav.setAttribute('hidden',''); btn.setAttribute('aria-expanded','false'); btn.classList.remove('is-open'); });
      });
      // Above the phone breakpoint, a long name or many links may not fit one row: switch to the menu button
      // (.is-compact, main.css) instead of wrapping. Items overflow into the row's padding, not its scroll
      // width, so each one's right edge is measured against the content edge.
      var head = btn.closest('.site-header'), row = btn.parentNode;
      function fit(){
        head.classList.remove('is-compact');
        var end = row.getBoundingClientRect().right - parseFloat(getComputedStyle(row).paddingRight), over = false;
        for (var i = 0; i < row.children.length; i++) { var r = row.children[i].getBoundingClientRect(); if (r.width && r.right > end + 1) over = true; }
        if (over) head.classList.add('is-compact');
      }
      fit(); window.addEventListener('resize', fit);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    })();
  </script>
  <% } else { %>
  <script>
    (function(){
      var btn = document.querySelector('.mobile-nav-toggle');
      var nav = document.getElementById('mobile-nav');
      if (!btn || !nav) return;
      btn.addEventListener('click', function(){
        var open = nav.hasAttribute('hidden') ? false : true;
        if (open) { nav.setAttribute('hidden',''); btn.setAttribute('aria-expanded','false'); btn.classList.remove('is-open'); }
        else { nav.removeAttribute('hidden'); btn.setAttribute('aria-expanded','true'); btn.classList.add('is-open'); }
      });
      // Close on link tap so SPA-like navigation feels right
      nav.querySelectorAll('a').forEach(function(a){
        a.addEventListener('click', function(){ nav.setAttribute('hidden',''); btn.setAttribute('aria-expanded','false'); btn.classList.remove('is-open'); });
      });
    })();
  </script>
  <% } %>
  <% } %>

  <main id="main" tabindex="-1">
    <%- body %>
  </main>

  <% if (_embed) { %>
  <script>
    // Tells the page framing this one how tall it is, whenever that changes (/scripts/book-embed.js listens).
    (function(){
      if (window.parent === window) return;
      var last = 0;
      function post(){ var h = document.documentElement.scrollHeight; if (h !== last) { last = h; window.parent.postMessage({ type: 'twomiah-book-height', height: h }, '*'); } }
      if (window.ResizeObserver) new ResizeObserver(post).observe(document.body);
      window.addEventListener('load', post); post();
    })();
  </script>
  <% } else { %>
  <footer class="site-footer">
    <div class="container footer-inner">
      <div>
        <div class="footer-brand"><%= settings.companyName || 'Your Company' %></div>
        <% if (cover) { %>
        <% if (settings.tagline) { %><div class="footer-tagline"><%= settings.tagline %></div><% } %>
        <% if (settings.address) { %><div class="footer-address"><%= settings.address %></div><% } %>
        <% if (settings.established) { %><div class="footer-est">Est. <%= settings.established %></div><% } %>
        <% } else { %>
        <div class="footer-tagline"><%= settings.tagline || '' %></div>
        <% } %>
      </div>
      <div class="footer-contact">
        <% if (settings.phone) { %><a href="tel:<%= cover ? String(settings.phone).replace(/[^\d+]/g, '') : settings.phone %>"><%= settings.phone %></a><% } %>
        <% if (settings.email) { %><a href="mailto:<%= settings.email %>"><%= settings.email %></a><% } %>
        <%/* The business's privacy policy and terms (site/legal.ts): the carriers read them before approving its texting. */%>
        <span class="footer-legal"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
        <% if (cover) { (Array.isArray(settings.sameAs) ? settings.sameAs : []).forEach(function (u) {
             var label = /facebook/i.test(u) ? 'Facebook' : /instagram/i.test(u) ? 'Instagram' : /untappd/i.test(u) ? 'Untappd' : /yelp/i.test(u) ? 'Yelp' : 'Link'; %>
          <a href="<%= u %>" rel="noopener" target="_blank"><%= label %></a>
        <% }) } %>
      </div>
    </div>
    <% if (typeof settings !== 'undefined' && settings && Array.isArray(settings.photoCredits) && settings.photoCredits.length) { %>
  <div class="photo-credits" style="padding:10px 16px;text-align:center;font-size:12px;line-height:1.6;opacity:.82;">
    Photos:
    <% settings.photoCredits.forEach(function (c, i) { %><%
      %><% if (c.photographerUrl) { %><a href="<%= c.photographerUrl %>" rel="nofollow noopener" target="_blank" style="color:inherit;"><%= c.photographer %></a><% } else { %><%= c.photographer %><% } %><% if (c.count > 1) { %> (<%= c.count %> photos)<% } %><%
      %> on <% if (c.sourceUrl) { %><a href="<%= c.sourceUrl %>" rel="nofollow noopener" target="_blank" style="color:inherit;"><%= c.source %></a><% } else if (c.source === 'Pexels') { %><a href="https://www.pexels.com" rel="nofollow noopener" target="_blank" style="color:inherit;">Pexels</a><% } else { %><%= c.source %><% } %><%
      %><%= i < settings.photoCredits.length - 1 ? ', ' : '' %><%
    %><% }) %>
  </div>
  <% } %>
  </footer>
  <%# "Call now", phones only (the stylesheet shows it under 768px): the business's own number, and only when it has one. It steps
      aside while a form is on screen or a box has focus, so it never covers a form's buttons. %>
  <% if (settings.phone && String(settings.phone).replace(/[^\d]/g, '').length >= 7) { %>
  <a class="btn btn--primary call-now" href="tel:<%= String(settings.phone).replace(/[^\d+]/g, '') %>" data-call-now aria-label="Call now: <%= settings.companyName || 'us' %>, <%= settings.phone %>"><svg class="call-now__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg><span>Call now</span></a>
  <script>(function(){
    var a = document.querySelector('[data-call-now]'); if (!a) return;
    var seen = 0, typing = false;
    function sync(){ a.classList.toggle('call-now--away', seen > 0 || typing); }
    if (window.IntersectionObserver) {
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { seen += e.isIntersecting ? 1 : -1; }); if (seen < 0) seen = 0; sync(); });
      document.querySelectorAll('form').forEach(function (f) { io.observe(f); });
    }
    document.addEventListener('focusin', function (e) { typing = !!(e.target && e.target.closest && e.target.closest('form')); sync(); });
    document.addEventListener('focusout', function () { typing = false; sync(); });
  })();</script>
  <% } %>
  <% if (cover) { %>
  </div>
  <% } %>
  <%# A text-size control for readers who want larger type (home care sites; the vertical's settings switch it on). %>
  <% if (typeof siteOptions !== 'undefined' && siteOptions.textSizeToggle) { %>
  <div class="text-size-toggle" role="group" aria-label="Adjust text size">
    <button type="button" data-size="default" aria-label="Aa, default text size" title="Default size">Aa</button>
    <button type="button" data-size="large" aria-label="Aa+, larger text" title="Larger">Aa+</button>
    <button type="button" data-size="xlarge" aria-label="Aa++, largest text" title="Largest">Aa++</button>
  </div>
  <script>
    // Aa+ toggle persists to localStorage so the size sticks across visits.
    (function(){
      var KEY = 'cf_text_size';
      var btns = document.querySelectorAll('.text-size-toggle button');
      function apply(size) {
        document.documentElement.classList.remove('cf-text-large', 'cf-text-xlarge');
        if (size === 'large') document.documentElement.classList.add('cf-text-large');
        else if (size === 'xlarge') document.documentElement.classList.add('cf-text-xlarge');
        btns.forEach(function(b){ b.classList.toggle('is-active', b.dataset.size === size); });
        try { localStorage.setItem(KEY, size); } catch(e) {}
      }
      var saved;
      try { saved = localStorage.getItem(KEY); } catch(e) {}
      apply(saved || 'default');
      btns.forEach(function(b){ b.addEventListener('click', function(){ apply(b.dataset.size); }); });
    })();
  </script>
  <% } %>
  <% } %>
  <% if (typeof crmApiUrl !== 'undefined' && crmApiUrl) { %><script src="/scripts/ab.js" defer></script><% } %>
  <% if (typeof siteOptions !== 'undefined' && siteOptions.shop) { %><script src="/scripts/cart.js?v=<%= assetV %>" defer></script><% } %>
  <% if (cover) { %>
  <script>
    // ── Single-page nav: smooth scroll, URL hash sync, active highlight ──
    (function(){
      var anchors = document.querySelectorAll('.onepage-anchor');
      if (anchors.length === 0) return;  // multi-page mode, skip everything below

      // Smooth scroll on nav link click. Use the standard hash navigation
      // but offset by the sticky header height. The scrollMarginTop on
      // .onepage-anchor in CSS handles that natively.
      // The skip link keeps the browser's own jump — it has to move keyboard focus.
      document.querySelectorAll('a[href^="#"]:not(.skip-link)').forEach(function(a){
        a.addEventListener('click', function(e){
          var id = a.getAttribute('href').slice(1);
          if (!id) return;
          var el = document.getElementById(id);
          if (!el) return;
          e.preventDefault();
          history.replaceState(null, '', '#' + id);
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
      var navLinks = document.querySelectorAll('.primary-nav a[href^="#"], .mobile-nav a[href^="#"]');
      var byId = {};
      navLinks.forEach(function(a){
        var id = a.getAttribute('href').slice(1);
        if (id) (byId[id] = byId[id] || []).push(a);
      });
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if (!en.isIntersecting) return;
          var id = en.target.id;
          Object.keys(byId).forEach(function(k){
            byId[k].forEach(function(a){ a.classList.toggle('is-active', k === id); });
          });
          history.replaceState(null, '', '#' + id);
        });
      }, { rootMargin: '-30% 0px -55% 0px', threshold: 0 });
      anchors.forEach(function(el){ io.observe(el); });
    })();
  </script>
  <% } %>
</body>
</html>
