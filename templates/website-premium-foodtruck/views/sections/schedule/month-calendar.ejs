<%
  // Month-view booking calendar. Each day shows the trucks booked on the
  // lot and how many spots remain. Open days link to the contact form
  // (requestTarget) and pre-fill the message textarea with the date — the
  // static-render path. When the template runs with its server, the same
  // section can POST /api/leads with source=booking instead.
  //
  // data: { heading, intro, monthLabel, spotsPerDay, startDow, requestTarget,
  //         days: [{ date, trucks: [], spots?, note?, closed?, today? }] }
  // startDow: weekday column of day 1 (0 = Sunday).
  const heading = data.heading || 'This month at the lot'
  const intro = data.intro || ''
  const monthLabel = data.monthLabel || ''
  const spotsPerDay = typeof data.spotsPerDay === 'number' ? data.spotsPerDay : 2
  const startDow = typeof data.startDow === 'number' ? data.startDow : 0
  const requestTarget = data.requestTarget || '#contact'
  const legend = data.legend || ''
  const days = Array.isArray(data.days) ? data.days : []
  if (days.length === 0) return
%>
<section class="month-cal">
  <style>
    .month-cal { padding: calc(var(--space) * 0.5) 0 var(--space); }
    .month-cal .section-head { margin-bottom: 16px; }
    .month-cal__month { color: var(--muted); font-size: 18px; margin-top: 8px; text-transform: uppercase; letter-spacing: 0.08em; }
    .month-cal__grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; margin-top: 32px; }
    .month-cal__dow { font-family: 'DM Mono', ui-monospace, monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); text-align: center; padding-bottom: 8px; }
    .month-cal__cell { background: var(--white); border: 1px solid var(--line); border-radius: 8px; min-height: 104px; padding: 8px; display: flex; flex-direction: column; gap: 4px; }
    .month-cal__cell--blank { background: transparent; border: none; }
    .month-cal__cell--today { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
    .month-cal__date { font-size: 13px; color: var(--muted); }
    .month-cal__truck { font-size: 12.5px; font-weight: 600; line-height: 1.25; color: var(--ink); background: var(--accent); border-radius: 4px; padding: 3px 6px; }
    .month-cal__note { font-size: 12px; color: var(--ink-soft); line-height: 1.3; }
    .month-cal__open { margin-top: auto; font-size: 12px; font-weight: 600; color: var(--cta, var(--brand)); border: 1px dashed var(--cta, var(--brand)); border-radius: 4px; padding: 3px 6px; text-align: center; }
    .month-cal__open:hover { background: var(--cta, var(--brand)); color: var(--cta-ink, var(--white)); }
    .month-cal__full { margin-top: auto; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); text-align: center; }
    .month-cal__legend { margin-top: 20px; color: var(--muted); font-size: 14px; text-align: center; }
    @media (max-width: 760px) {
      .month-cal__grid { grid-template-columns: 1fr; gap: 8px; margin-top: 24px; }
      .month-cal__dow { display: none; }
      .month-cal__cell--blank { display: none; }
      .month-cal__cell { flex-direction: row; flex-wrap: wrap; align-items: center; min-height: 0; padding: 10px 12px; gap: 6px 10px; }
      .month-cal__date { min-width: 62px; }
      .month-cal__date::after { content: attr(data-dow); margin-left: 5px; }
      .month-cal__truck { font-size: 12px; padding: 4px 8px; }
      .month-cal__note { flex: 1; }
      .month-cal__open, .month-cal__full { margin-top: 0; margin-left: auto; }
    }
  </style>
  <div class="container">
    <div class="section-head">
      <h2 class="section-title"><%= heading %></h2>
      <% if (intro) { %><p class="section-intro"><%= intro %></p><% } %>
      <% if (monthLabel) { %><div class="month-cal__month mono"><%= monthLabel %></div><% } %>
    </div>
    <div class="month-cal__grid">
      <% for (const dow of ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']) { %><div class="month-cal__dow"><%= dow %></div><% } %>
      <% for (let i = 0; i < startDow; i++) { %><div class="month-cal__cell month-cal__cell--blank"></div><% } %>
      <% const dows = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']
         for (let i = 0; i < days.length; i++) {
           const d = days[i]
           const trucks = Array.isArray(d.trucks) ? d.trucks : []
           const cap = typeof d.spots === 'number' ? d.spots : spotsPerDay
           const open = d.closed ? 0 : Math.max(0, cap - trucks.length)
           const dow = dows[(startDow + i) % 7]
      %>
        <div class="month-cal__cell<%= d.closed ? ' month-cal__cell--closed' : '' %><%= d.today ? ' month-cal__cell--today' : '' %>">
          <div class="month-cal__date mono" data-dow="<%= dow %>"><%= d.date %></div>
          <% for (const t of trucks) { %><div class="month-cal__truck"><%= t %></div><% } %>
          <% if (d.note) { %><div class="month-cal__note"><%= d.note %></div><% } %>
          <% if (open > 0) { %>
            <a class="month-cal__open" href="<%= requestTarget %>" data-cal-date="<%= monthLabel %> <%= d.date %>"><%= open %> spot<%= open === 1 ? '' : 's' %> open</a>
          <% } else if (!d.closed && trucks.length) { %>
            <div class="month-cal__full mono">Full</div>
          <% } %>
        </div>
      <% } %>
    </div>
    <% if (legend) { %><p class="month-cal__legend"><%= legend %></p><% } %>
  </div>
  <script>
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[data-cal-date]');
      if (!a) return;
      var ta = document.querySelector('.contact-form textarea');
      if (ta) {
        ta.value = 'Requesting a spot for ' + a.getAttribute('data-cal-date') + ' — here is what I sell: ';
        // Focus after the smooth scroll lands so the visitor sees the
        // pre-filled date and the cursor ready at the end of the line.
        setTimeout(function () {
          ta.focus({ preventScroll: true });
          ta.setSelectionRange(ta.value.length, ta.value.length);
        }, 600);
      }
    });
  </script>
</section>
