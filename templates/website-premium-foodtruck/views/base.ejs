<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <% var seoTitle = settings.seoTitle || settings.companyName || 'Website'; %>
  <% var seoDescription = settings.seoDescription || ''; %>
  <% var canonicalBase = (settings.siteOrigin || '').replace(/\/+$/, ''); %>
  <% var canonical = canonicalBase ? canonicalBase + (currentPath || '/') : ''; %>
  <% var ogImage = settings.logoUrl || settings.heroPhotoUrl || ''; %>
  <title><%= seoTitle %></title>
  <meta name="description" content="<%= seoDescription %>">
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta name="robots" content="index, follow">
  <% if (typeof crmApiUrl !== 'undefined' && crmApiUrl) { %><meta name="twomiah-crm-url" content="<%= crmApiUrl %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= seoTitle %>">
  <meta property="og:description" content="<%= seoDescription %>">
  <% if (canonical) { %><meta property="og:url" content="<%= canonical %>"><% } %>
  <% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
  <% if (settings.companyName) { %><meta property="og:site_name" content="<%= settings.companyName %>"><% } %>
  <meta name="twitter:card" content="<%= ogImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= seoTitle %>">
  <meta name="twitter:description" content="<%= seoDescription %>">
  <% if (ogImage) { %><meta name="twitter:image" content="<%= ogImage %>"><% } %>
  <% if (settings.faviconUrl) { %><link rel="icon" href="<%= settings.faviconUrl %>"><% } %>
  <% if (typeof lcpImage !== 'undefined' && lcpImage) { %>
    <link rel="preload" as="image" href="<%= lcpImage %>" fetchpriority="high">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin>
  <link rel="stylesheet" href="/styles/main.css?v=<%= typeof assetV === 'undefined' ? '' : assetV %>">
  <%
    // Font CSS is loaded via the media-toggle pattern so it stops blocking
    // the initial render — display=swap already keeps text visible while
    // fonts download, but the stylesheet itself was still a critical-path
    // request. Mobile LCP improves ~300-600ms in field testing.
    // Food truck typography: Bebas Neue for big chalkboard-style display
    // (menu board, hero), DM Mono for the menu prices + small caps callouts
    // (gives that "scrawled on the side of the truck" feel), Inter for
    // body copy. Different DNA from showcase's Fraunces editorial pair.
    var fontsHref = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Bebas+Neue&family=DM+Mono:wght@400;500&display=swap';
  %>
  <link rel="stylesheet" href="<%= fontsHref %>" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="<%= fontsHref %>"></noscript>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="<%= settings.homeHref || '/' %>"><%= settings.companyName || 'Your Company' %></a>
      <nav class="primary-nav" aria-label="Primary">
        <% (settings.nav || []).forEach(function(item) { %>
          <a href="<%= item.href %>"<%= currentPath && currentPath === item.href ? ' aria-current="page"' : '' %>><%= item.label %></a>
        <% }) %>
      </nav>
      <a class="header-cta" href="<%= settings.contactHref || '/contact' %>"><%= settings.contactCtaLabel || 'Get a quote' %></a>
      <button class="mobile-nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile primary" hidden>
      <% (settings.nav || []).forEach(function(item) { %>
        <a href="<%= item.href %>"<%= currentPath && currentPath === item.href ? ' aria-current="page"' : '' %>><%= item.label %></a>
      <% }) %>
      <a class="mobile-nav__cta" href="<%= settings.contactHref || '/contact' %>"><%= settings.contactCtaLabel || 'Get a quote' %></a>
    </nav>
  </header>
  <script>
    (function(){
      var btn = document.querySelector('.mobile-nav-toggle');
      var nav = document.getElementById('mobile-nav');
      if (!btn || !nav) return;
      btn.addEventListener('click', function(){
        var open = nav.hasAttribute('hidden') ? false : true;
        if (open) { nav.setAttribute('hidden',''); btn.setAttribute('aria-expanded','false'); btn.classList.remove('is-open'); }
        else { nav.removeAttribute('hidden'); btn.setAttribute('aria-expanded','true'); btn.classList.add('is-open'); }
      });
      // Close on link tap so SPA-like navigation feels right
      nav.querySelectorAll('a').forEach(function(a){
        a.addEventListener('click', function(){ nav.setAttribute('hidden',''); btn.setAttribute('aria-expanded','false'); btn.classList.remove('is-open'); });
      });
    })();
  </script>

  <main>
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div>
        <div class="footer-brand"><%= settings.companyName || 'Your Company' %></div>
        <div class="footer-tagline"><%= settings.tagline || '' %></div>
      </div>
      <div class="footer-contact">
        <% if (settings.phone) { %><a href="tel:<%= settings.phone %>"><%= settings.phone %></a><% } %>
        <% if (settings.email) { %><a href="mailto:<%= settings.email %>"><%= settings.email %></a><% } %>
      </div>
    </div>
  </footer>
  <% if (typeof crmApiUrl !== 'undefined' && crmApiUrl) { %><script src="/scripts/ab.js" defer></script><% } %>
  <script>
    // ── Single-page nav: smooth scroll, URL hash sync, active highlight ──
    (function(){
      var anchors = document.querySelectorAll('.onepage-anchor');
      if (anchors.length === 0) return;  // multi-page mode, skip everything below

      // Smooth scroll on nav link click. Use the standard hash navigation
      // but offset by the sticky header height. The scrollMarginTop on
      // .onepage-anchor in CSS handles that natively.
      document.querySelectorAll('a[href^="#"]').forEach(function(a){
        a.addEventListener('click', function(e){
          var id = a.getAttribute('href').slice(1);
          if (!id) return;
          var el = document.getElementById(id);
          if (!el) return;
          e.preventDefault();
          history.replaceState(null, '', '#' + id);
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // Active-section highlight: which anchor are we currently looking at?
      // IntersectionObserver with a generous top margin so the active link
      // changes when a section enters the upper third of the viewport.
      var navLinks = document.querySelectorAll('.primary-nav a[href^="#"], .mobile-nav a[href^="#"]');
      var byId = {};
      navLinks.forEach(function(a){
        var id = a.getAttribute('href').slice(1);
        if (id) (byId[id] = byId[id] || []).push(a);
      });
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if (!en.isIntersecting) return;
          var id = en.target.id;
          Object.keys(byId).forEach(function(k){
            byId[k].forEach(function(a){ a.classList.toggle('is-active', k === id); });
          });
          history.replaceState(null, '', '#' + id);
        });
      }, { rootMargin: '-30% 0px -55% 0px', threshold: 0 });
      anchors.forEach(function(el){ io.observe(el); });
    })();
  </script>
</body>
</html>
