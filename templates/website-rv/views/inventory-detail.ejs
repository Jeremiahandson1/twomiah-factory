<%
// ── Inventory detail page ─────────────────────────────────────────────
// Server passes: unit (object), relatedUnits (array, up to 3).
// We render only the page body; base.ejs supplies header/footer.
const u = (typeof unit !== 'undefined' && unit) ? unit : {};
const related = (typeof relatedUnits !== 'undefined' && relatedUnits) ? relatedUnits : [];

const phone = (typeof settings !== 'undefined' && settings && settings.phone) ? settings.phone : '{{COMPANY_PHONE}}';
const phoneRaw = phone.replace(/\D/g, '');

function getImageUrl(p) {
  if (!p) return '';
  if (typeof p === 'object') p = p.url || p.thumbnail || '';
  if (!p) return '';
  if (p.startsWith('http')) return p;
  if (p.startsWith('/')) return p;
  return '/uploads/' + p;
}

function unitTitle(x) {
  return [x.year, x.make, x.modelName, x.trim].filter(Boolean).join(' ');
}

function priceVal(x) {
  const p = x.internetPrice || x.listedPrice;
  return (p && Number(p) > 0) ? Number(p) : 0;
}
function priceLabel(x) {
  const p = priceVal(x);
  return p > 0 ? '$' + p.toLocaleString('en-US') : 'Call for Price';
}

function condInfo(x) {
  const c = String(x.condition || '').toLowerCase();
  if (c === 'new') return { label: 'New', cls: 'is-new' };
  if (c === 'pending' || String(x.status || '').toLowerCase() === 'pending') return { label: 'Pending', cls: 'is-pending' };
  if (c === 'used' || c === 'pre-owned' || c === 'preowned') return { label: 'Used', cls: 'is-used' };
  return x.condition ? { label: x.condition, cls: 'is-used' } : null;
}

const title = unitTitle(u) || 'Unit';
const badge = condInfo(u);
const photos = (u.photos && u.photos.length) ? u.photos.map(getImageUrl).filter(Boolean) : [];
const cat = String(u.category || '').toLowerCase();
const isRv = ['motorhome', 'towable', 'travel-trailer', 'fifth-wheel', 'fifthwheel', 'class-a', 'class-b', 'class-c'].includes(cat);
const isPowersports = ['atv', 'utv', 'sxs', 'motorcycle', 'snowmobile'].includes(cat);
const isMarine = ['boat', 'pwc'].includes(cat);

// unitOfInterest carried into the lead so sales knows which unit.
const stockStr = u.stockNumber ? (' (Stock #' + u.stockNumber + ')') : '';
const unitOfInterest = [u.year, u.make, u.modelName].filter(Boolean).join(' ') + stockStr;

// A spec row only renders when the value is present.
function fmtNum(v) { return Number(v).toLocaleString('en-US'); }
%>

<style>
  .ivd-page { padding: 32px 0 60px; }
  .ivd-back { display: inline-flex; align-items: center; gap: 6px; color: #64748b; font-weight: 600; text-decoration: none; margin-bottom: 18px; }
  .ivd-back:hover { color: #1e293b; }
  .ivd-top { display: grid; grid-template-columns: 1.4fr 1fr; gap: 36px; align-items: start; }
  .ivd-gallery-main { position: relative; aspect-ratio: 4 / 3; background: #0f172a; border-radius: 14px; overflow: hidden; }
  .ivd-gallery-main img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ivd-gallery-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px; background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: rgba(255,255,255,.85); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .ivd-badge { position: absolute; top: 14px; left: 14px; padding: 6px 14px; border-radius: 999px; font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: #fff; background: #475569; }
  .ivd-badge.is-new { background: #16a34a; }
  .ivd-badge.is-used { background: #2563eb; }
  .ivd-badge.is-pending { background: #d97706; }
  .ivd-thumbs { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
  .ivd-thumb { width: 84px; height: 64px; border-radius: 8px; overflow: hidden; border: 2px solid transparent; background: #0f172a; cursor: pointer; padding: 0; }
  .ivd-thumb.is-active { border-color: var(--accent, #c8963e); }
  .ivd-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ivd-summary h1 { margin: 0 0 10px; font-size: clamp(1.6rem, 3.5vw, 2.2rem); line-height: 1.2; color: #1e293b; }
  .ivd-price { font-size: 2rem; font-weight: 800; color: var(--accent, #c8963e); margin: 0 0 14px; }
  .ivd-ids { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0 0 22px; color: #475569; font-size: .92rem; }
  .ivd-ids span strong { color: #1e293b; }
  .ivd-cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .ivd-section { margin-top: 48px; }
  .ivd-section h2 { font-size: 1.5rem; color: #1e293b; margin: 0 0 18px; }
  .ivd-specs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px 24px; }
  .ivd-spec { padding: 12px 0; border-bottom: 1px solid #e2e8f0; }
  .ivd-spec dt { font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: #94a3b8; font-weight: 700; margin-bottom: 3px; }
  .ivd-spec dd { margin: 0; font-size: 1.02rem; font-weight: 700; color: #1e293b; }
  .ivd-desc { color: #334155; line-height: 1.7; max-width: 820px; }
  .ivd-desc p { margin: 0 0 1em; }
  .ivd-quote { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,.06); padding: 26px; max-width: 720px; }
  .ivd-quote .form-row { display: flex; gap: 16px; flex-wrap: wrap; }
  .ivd-quote .form-group { flex: 1; min-width: 200px; margin-bottom: 16px; }
  .ivd-quote label { display: block; font-size: .82rem; font-weight: 600; color: #334155; margin-bottom: 6px; }
  .ivd-quote input, .ivd-quote textarea { width: 100%; padding: 11px 13px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; font-family: inherit; color: #1e293b; background: #fff; box-sizing: border-box; }
  .ivd-quote input[readonly] { background: #f1f5f9; color: #475569; }
  .ivd-quote textarea { resize: vertical; }
  .ivd-form-msg { display: none; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 8px; margin-top: 14px; font-size: .95rem; }
  .ivd-form-msg.success { background: #f0fdf4; color: #15803d; }
  .ivd-form-msg.error { background: #fef2f2; color: #dc2626; }
  .ivd-related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
  .ivd-mini { display: block; text-decoration: none; color: inherit; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; transition: box-shadow .2s, transform .2s; }
  .ivd-mini:hover { box-shadow: 0 14px 30px rgba(0,0,0,.12); transform: translateY(-2px); }
  .ivd-mini-media { aspect-ratio: 4 / 3; background: #0f172a; }
  .ivd-mini-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ivd-mini-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.75); font-weight: 700; font-size: .8rem; text-transform: uppercase; }
  .ivd-mini-body { padding: 12px 14px; }
  .ivd-mini-body h3 { margin: 0 0 4px; font-size: .98rem; color: #1e293b; line-height: 1.3; }
  .ivd-mini-body .ivd-mini-price { font-weight: 800; color: var(--accent, #c8963e); }
  @media (max-width: 860px) { .ivd-top { grid-template-columns: 1fr; gap: 24px; } }
</style>

<div class="ivd-page">
  <div class="container">
    <a href="/inventory" class="ivd-back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
      Back to Inventory
    </a>

    <div class="ivd-top">
      <!-- Gallery -->
      <div class="ivd-gallery">
        <div class="ivd-gallery-main">
          <% if (photos.length) { %>
            <img id="ivd-main-img" src="<%= photos[0] %>" alt="<%= title %>">
          <% } else { %>
            <div class="ivd-gallery-ph"><%= u.category || 'Photos Coming Soon' %></div>
          <% } %>
          <% if (badge) { %><span class="ivd-badge <%= badge.cls %>"><%= badge.label %></span><% } %>
        </div>
        <% if (photos.length > 1) { %>
          <div class="ivd-thumbs">
            <% photos.forEach(function(ph, i) { %>
              <button type="button" class="ivd-thumb <%= i === 0 ? 'is-active' : '' %>" data-full="<%= ph %>">
                <img src="<%= ph %>" alt="<%= title %> photo <%= i + 1 %>" loading="lazy">
              </button>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- Summary -->
      <div class="ivd-summary">
        <h1><%= title %></h1>
        <div class="ivd-price"><%= priceLabel(u) %></div>
        <div class="ivd-ids">
          <% if (u.stockNumber) { %><span><strong>Stock #:</strong> <%= u.stockNumber %></span><% } %>
          <% if (u.vin) { %><span><strong><%= isMarine ? 'HIN' : 'VIN' %>:</strong> <%= u.vin %></span><% } %>
          <% if (u.hin && !u.vin) { %><span><strong>HIN:</strong> <%= u.hin %></span><% } %>
        </div>
        <div class="ivd-cta-row">
          <a href="#request-quote" class="btn btn-primary btn-lg">Request a Quote</a>
          <a href="tel:<%= phoneRaw %>" class="btn btn-outline-light btn-lg">Call <%= phone %></a>
        </div>
      </div>
    </div>

    <!-- Specs (category-aware) -->
    <section class="ivd-section">
      <h2>Specifications</h2>
      <dl class="ivd-specs-grid">
        <% if (isRv) { %>
          <% if (u.rvClass) { %><div class="ivd-spec"><dt>Class</dt><dd><%= u.rvClass %></dd></div><% } %>
          <% if (u.lengthFt) { %><div class="ivd-spec"><dt>Length</dt><dd><%= u.lengthFt %> ft</dd></div><% } %>
          <% if (u.sleeps) { %><div class="ivd-spec"><dt>Sleeps</dt><dd><%= u.sleeps %></dd></div><% } %>
          <% if (u.slideOuts != null && u.slideOuts !== '') { %><div class="ivd-spec"><dt>Slide-Outs</dt><dd><%= u.slideOuts %></dd></div><% } %>
          <% if (u.gvwr) { %><div class="ivd-spec"><dt>GVWR</dt><dd><%= fmtNum(u.gvwr) %> lbs</dd></div><% } %>
          <% if (u.dryWeight) { %><div class="ivd-spec"><dt>Dry Weight</dt><dd><%= fmtNum(u.dryWeight) %> lbs</dd></div><% } %>
          <% if (u.chassis) { %><div class="ivd-spec"><dt>Chassis</dt><dd><%= u.chassis %></dd></div><% } %>
          <% if (u.freshTankGal) { %><div class="ivd-spec"><dt>Fresh Tank</dt><dd><%= u.freshTankGal %> gal</dd></div><% } %>
          <% if (u.greyTankGal) { %><div class="ivd-spec"><dt>Grey Tank</dt><dd><%= u.greyTankGal %> gal</dd></div><% } %>
          <% if (u.blackTankGal) { %><div class="ivd-spec"><dt>Black Tank</dt><dd><%= u.blackTankGal %> gal</dd></div><% } %>
          <% if (u.generatorHours != null && u.generatorHours !== '') { %><div class="ivd-spec"><dt>Generator Hours</dt><dd><%= fmtNum(u.generatorHours) %></dd></div><% } %>
          <% if (u.awnings != null && u.awnings !== '') { %><div class="ivd-spec"><dt>Awnings</dt><dd><%= u.awnings %></dd></div><% } %>
        <% } else if (isPowersports) { %>
          <% if (u.engine) { %><div class="ivd-spec"><dt>Engine</dt><dd><%= u.engine %></dd></div><% } %>
          <% if (u.engineCc) { %><div class="ivd-spec"><dt>Displacement</dt><dd><%= u.engineCc %>cc</dd></div><% } %>
          <% if (u.engineHp) { %><div class="ivd-spec"><dt>Horsepower</dt><dd><%= u.engineHp %> hp</dd></div><% } %>
          <% if (u.mileage != null && u.mileage !== '') { %><div class="ivd-spec"><dt>Mileage</dt><dd><%= fmtNum(u.mileage) %> mi</dd></div><% } %>
          <% if (u.hours != null && u.hours !== '') { %><div class="ivd-spec"><dt>Hours</dt><dd><%= fmtNum(u.hours) %></dd></div><% } %>
          <% if (u.fuelType) { %><div class="ivd-spec"><dt>Fuel Type</dt><dd><%= u.fuelType %></dd></div><% } %>
          <% if (u.drivetrain) { %><div class="ivd-spec"><dt>Drivetrain</dt><dd><%= u.drivetrain %></dd></div><% } %>
          <% if (u.transmission) { %><div class="ivd-spec"><dt>Transmission</dt><dd><%= u.transmission %></dd></div><% } %>
        <% } else if (isMarine) { %>
          <% if (u.lengthFt) { %><div class="ivd-spec"><dt>Length</dt><dd><%= u.lengthFt %> ft</dd></div><% } %>
          <% if (u.beamFt) { %><div class="ivd-spec"><dt>Beam</dt><dd><%= u.beamFt %> ft</dd></div><% } %>
          <% if (u.draftFt) { %><div class="ivd-spec"><dt>Draft</dt><dd><%= u.draftFt %> ft</dd></div><% } %>
          <% if (u.hullMaterial) { %><div class="ivd-spec"><dt>Hull Material</dt><dd><%= u.hullMaterial %></dd></div><% } %>
          <% if (u.engineType) { %><div class="ivd-spec"><dt>Engine Type</dt><dd><%= u.engineType %></dd></div><% } %>
          <% if (u.engineCount != null && u.engineCount !== '') { %><div class="ivd-spec"><dt>Engines</dt><dd><%= u.engineCount %></dd></div><% } %>
          <% if (u.engineHp) { %><div class="ivd-spec"><dt>Horsepower</dt><dd><%= u.engineHp %> hp</dd></div><% } %>
          <% if (u.fuelCapacityGal) { %><div class="ivd-spec"><dt>Fuel Capacity</dt><dd><%= u.fuelCapacityGal %> gal</dd></div><% } %>
          <% if (u.maxPersons) { %><div class="ivd-spec"><dt>Max Persons</dt><dd><%= u.maxPersons %></dd></div><% } %>
          <% if (u.trailerIncluded != null && u.trailerIncluded !== '') { %><div class="ivd-spec"><dt>Trailer</dt><dd><%= (u.trailerIncluded === true || String(u.trailerIncluded).toLowerCase() === 'true' || String(u.trailerIncluded).toLowerCase() === 'yes') ? 'Included' : 'Not Included' %></dd></div><% } %>
        <% } %>
        <% if (u.year) { %><div class="ivd-spec"><dt>Year</dt><dd><%= u.year %></dd></div><% } %>
        <% if (u.make) { %><div class="ivd-spec"><dt>Make</dt><dd><%= u.make %></dd></div><% } %>
        <% if (u.modelName) { %><div class="ivd-spec"><dt>Model</dt><dd><%= u.modelName %></dd></div><% } %>
      </dl>
    </section>

    <!-- Description -->
    <% if (u.description) { %>
      <section class="ivd-section">
        <h2>About This Unit</h2>
        <% if (String(u.description).includes('<')) { %>
          <div class="ivd-desc"><%- u.description %></div>
        <% } else { %>
          <div class="ivd-desc">
            <% String(u.description).split('\n\n').forEach(function(para) { %>
              <p><%= para %></p>
            <% }); %>
          </div>
        <% } %>
      </section>
    <% } %>

    <!-- Request a Quote -->
    <section class="ivd-section" id="request-quote">
      <h2>Request a Quote</h2>
      <div class="ivd-quote">
        <form id="quoteForm" action="/api/admin/leads" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="q-name">Full Name *</label>
              <input id="q-name" type="text" name="name" autocomplete="name" required>
            </div>
            <div class="form-group">
              <label for="q-phone">Phone *</label>
              <input id="q-phone" type="tel" name="phone" autocomplete="tel" required>
            </div>
          </div>
          <div class="form-group">
            <label for="q-email">Email *</label>
            <input id="q-email" type="email" name="email" autocomplete="email" required>
          </div>
          <div class="form-group">
            <label for="q-unit">Unit of Interest</label>
            <input id="q-unit" type="text" name="unitOfInterest" value="<%= unitOfInterest %>" readonly>
          </div>
          <div class="form-group">
            <label for="q-message">Message</label>
            <textarea id="q-message" name="message" rows="4">I'm interested in this unit.</textarea>
          </div>
          <input type="hidden" name="service" value="Inventory Quote">
          <input type="hidden" name="source" value="inventory-detail">
          <button type="submit" class="btn btn-primary btn-lg btn-block">Send Quote Request</button>

          <div id="quoteSuccess" class="ivd-form-msg success">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span><strong>Thank you!</strong> We've received your request and will contact you within 24 hours.</span>
          </div>
          <div id="quoteError" class="ivd-form-msg error">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>Something went wrong. Please try calling us directly at <%= phone %>.</span>
          </div>
        </form>
      </div>
    </section>

    <!-- Similar units -->
    <% if (related.length > 0) { %>
      <section class="ivd-section">
        <h2>Similar Units</h2>
        <div class="ivd-related-grid">
          <% related.forEach(function(r) { %>
            <%
              const rHref = '/inventory/' + (r.stockNumber || r.id);
              const rPhoto = (r.photos && r.photos.length) ? getImageUrl(r.photos[0]) : '';
              const rTitle = unitTitle(r) || 'View Unit';
            %>
            <a class="ivd-mini" href="<%= rHref %>">
              <div class="ivd-mini-media">
                <% if (rPhoto) { %>
                  <img src="<%= rPhoto %>" alt="<%= rTitle %>" loading="lazy">
                <% } else { %>
                  <div class="ivd-mini-ph"><%= r.category || 'RV & Powersports' %></div>
                <% } %>
              </div>
              <div class="ivd-mini-body">
                <h3><%= rTitle %></h3>
                <span class="ivd-mini-price"><%= priceLabel(r) %></span>
              </div>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>
  </div>
</div>

<!-- Vehicle structured data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Vehicle",
  "name": <%- _jsonStr(title) %>,
  "url": "<%= BASE_URL %>/inventory/<%= u.stockNumber || u.id %>",
  <% if (u.make) { %>"brand": { "@type": "Brand", "name": <%- _jsonStr(u.make) %> },<% } %>
  <% if (u.modelName) { %>"model": <%- _jsonStr(u.modelName) %>,<% } %>
  <% if (u.year) { %>"modelDate": <%- _jsonStr(u.year) %>,<% } %>
  <% if (u.vin) { %>"vehicleIdentificationNumber": <%- _jsonStr(u.vin) %>,<% } %>
  <% if (u.mileage != null && u.mileage !== '') { %>"mileageFromOdometer": { "@type": "QuantitativeValue", "value": <%- _jsonStr(u.mileage) %>, "unitCode": "SMI" },<% } %>
  <% if (u.description) { %>"description": <%- _jsonStr(_plainDesc(u.description, 500)) %>,<% } %>
  <% if (photos.length) { %>"image": <%- _jsonStr(photos[0]) %>,<% } %>
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    <% if (priceVal(u) > 0) { %>"price": "<%= priceVal(u) %>",<% } %>
    "availability": "https://schema.org/<%= String(u.status || '').toLowerCase() === 'pending' ? 'PreOrder' : 'InStock' %>",
    "seller": { "@type": "AutoDealer", "name": "{{COMPANY_NAME}}", "telephone": "+1<%= phoneRaw %>" }
  }
}
</script>

<script>
// Gallery thumbnail swap
(function() {
  var main = document.getElementById('ivd-main-img');
  if (!main) return;
  document.querySelectorAll('.ivd-thumb').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var full = btn.getAttribute('data-full');
      if (full) main.src = full;
      document.querySelectorAll('.ivd-thumb').forEach(function(b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
    });
  });
})();

// Quote form submission — mirrors contact.ejs lead POST + tracking
(function() {
  var form = document.getElementById('quoteForm');
  if (!form) return;
  var successDiv = document.getElementById('quoteSuccess');
  var errorDiv = document.getElementById('quoteError');

  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    var submitBtn = form.querySelector('button[type="submit"]');
    var originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    successDiv.style.display = 'none';
    errorDiv.style.display = 'none';

    try {
      var formData = new FormData(form);
      var data = Object.fromEntries(formData);

      var response = await fetch('/api/admin/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        successDiv.style.display = 'flex';
        errorDiv.style.display = 'none';
        form.reset();

        if (typeof window._bpTrack === 'function') {
          window._bpTrack('generate_lead', { event_category: 'conversion', service_requested: 'inventory', contact_method: 'form', value: 1 });
        }
        if (typeof fbq !== 'undefined') {
          fbq('track', 'Lead', { content_name: 'inventory_quote' });
        }
        if (typeof gtag !== 'undefined' && window._gadsId) {
          gtag('event', 'conversion', { send_to: window._gadsId });
        }
        successDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        throw new Error('Failed to submit');
      }
    } catch (err) {
      successDiv.style.display = 'none';
      errorDiv.style.display = 'flex';
      errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
})();
</script>
