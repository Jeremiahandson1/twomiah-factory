// Reserve CTA — smooth scroll to reserve section
(function() {
  var btn = document.getElementById('ivd-reserve-cta');
  if (!btn) return;
  btn.addEventListener('click', function(e) {
    e.preventDefault();
    var target = document.getElementById('reserve');
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
})();

// Reserve form submit — POSTs to /reserve/<stock>; may redirect to Stripe deposit checkout
(function() {
  var form = document.getElementById('reserveForm');
  if (!form) return;
  var successDiv = document.getElementById('reserveSuccess');
  var successText = document.getElementById('reserveSuccessText');
  var errorDiv = document.getElementById('reserveError');
  var errorText = document.getElementById('reserveErrorText');

  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    var submitBtn = form.querySelector('button[type="submit"]');
    var originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    successDiv.style.display = 'none';
    errorDiv.style.display = 'none';

    try {
      var formData = new FormData(form);
      var payload = Object.fromEntries(formData);

      var response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      var data = {};
      try { data = await response.json(); } catch (_) { data = {}; }

      // Stripe deposit checkout — send the customer straight to pay.
      if (data && data.checkoutUrl) {
        window.location.href = data.checkoutUrl;
        return;
      }

      if (response.ok || (data && data.ok)) {
        successText.textContent = "Reservation received — we'll contact you shortly to arrange your deposit and hold this unit.";
        successDiv.style.display = 'flex';
        errorDiv.style.display = 'none';
        form.reset();

        if (typeof window._bpTrack === 'function') {
          window._bpTrack('generate_lead', { event_category: 'conversion', service_requested: 'reservation', contact_method: 'form', value: 1 });
        }
        if (typeof fbq !== 'undefined') {
          fbq('track', 'Lead', { content_name: 'reservation' });
        }
        if (typeof gtag !== 'undefined' && window._gadsId) {
          gtag('event', 'conversion', { send_to: window._gadsId });
        }
        successDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        errorText.textContent = (data && data.error) ? data.error : 'Something went wrong. Please try calling us directly at <%= phone %>.';
        errorDiv.style.display = 'flex';
        errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch (err) {
      successDiv.style.display = 'none';
      errorText.textContent = 'Something went wrong. Please try calling us directly at <%= phone %>.';
      errorDiv.style.display = 'flex';
      errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
})();
</script>
