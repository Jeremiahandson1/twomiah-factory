# {{COMPANY_NAME}} — HomeCare CRM Backend
# Generated by Twomiah Factory

# ── Database ─────────────────────────────────────────────
DATABASE_URL="{{DATABASE_URL}}"

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET="{{JWT_SECRET}}"
JWT_REFRESH_SECRET="{{JWT_REFRESH_SECRET}}"

# ── App ──────────────────────────────────────────────────
NODE_ENV="production"
PORT=10000
# FRONTEND_URL is set by the Factory on Render at deploy time (real service host,
# or the custom domain once attached). Do NOT bake it here: a committed .env value
# is auto-loaded by Bun and overrides Render's, which produced dead portal links
# built from the company name instead of the real host.

# ── Encryption (for SSN, license, sensitive fields) ──────
ENCRYPTION_KEY="{{ENCRYPTION_KEY}}"

# ── Twilio (SMS) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID="{{TWILIO_ACCOUNT_SID}}"
TWILIO_AUTH_TOKEN="{{TWILIO_AUTH_TOKEN}}"
TWILIO_PHONE_NUMBER="{{TWILIO_PHONE_NUMBER}}"

# ── Email (SendGrid or SMTP) ─────────────────────────────
SENDGRID_API_KEY="{{SENDGRID_API_KEY}}"
EMAIL_FROM="{{COMPANY_EMAIL}}"

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY="{{STRIPE_SECRET_KEY}}"
STRIPE_WEBHOOK_SECRET="{{STRIPE_WEBHOOK_SECRET}}"

# ── Push Notifications (VAPID) ───────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="{{COMPANY_EMAIL}}"

# ── File Uploads ─────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ── Sandata EVV (Wisconsin Alt EVV Addendum v2.5) ────────
# AGENCY_MEDICAID_ID=""                     # Your agency's WI Medicaid provider ID
# SANDATA_USERNAME=""                       # Sandata API username
# SANDATA_PASSWORD=""                       # Sandata API password
# SANDATA_ENV="uat"                         # "uat" or "production"

# ── AI Receptionist (OpenAI) ────────────────────────────
OPENAI_API_KEY="{{OPENAI_API_KEY}}"

# ── Feature Flags ────────────────────────────────────────
# Set automatically by Twomiah Factory from your wizard selections.
# Edit only if adding an integration after initial deployment.
ENABLE_SANDATA_EVV={{ENABLE_SANDATA_EVV}}
ENABLE_GUSTO={{ENABLE_GUSTO}}
ENABLE_WORCS={{ENABLE_WORCS}}

# ── Twomiah Ads ───────────────────────────────────────────
ADS_ENABLED={{ADS_ENABLED}}
ADS_API_KEY="{{ADS_API_KEY}}"
