services:
  - type: web
    name: {{COMPANY_SLUG}}-site
    runtime: image
    image:
      url: oven/bun:1.2-slim
    region: oregon
    plan: starter
    healthCheckPath: /health
    envVars:
      - key: NODE_ENV
        value: production
      - key: DATABASE_URL
        fromDatabase:
          name: {{COMPANY_SLUG}}-site-db
          property: connectionString
      - key: JWT_SECRET
        generateValue: true
      - key: ADMIN_EMAIL
        value: {{ADMIN_EMAIL}}
      - key: ADMIN_INITIAL_PASSWORD
        generateValue: true
      - key: STORAGE_BACKEND
        value: s3
      - key: R2_ACCOUNT_ID
        sync: false
      - key: R2_ACCESS_KEY_ID
        sync: false
      - key: R2_SECRET_ACCESS_KEY
        sync: false
      - key: R2_BUCKET_NAME
        value: {{R2_BUCKET_NAME}}
      - key: R2_PUBLIC_URL
        value: {{R2_PUBLIC_URL}}
      - key: SENDGRID_API_KEY
        sync: false
      - key: FROM_EMAIL
        value: {{COMPANY_EMAIL}}
      - key: FACTORY_URL
        value: {{FACTORY_URL}}
      - key: TENANT_ID
        value: {{TENANT_ID}}
      - key: FACTORY_SYNC_KEY
        value: {{FACTORY_SYNC_KEY}}

databases:
  - name: {{COMPANY_SLUG}}-site-db
    region: oregon
    plan: starter
    ipAllowList: []
