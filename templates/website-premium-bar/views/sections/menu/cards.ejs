<%
  // Food truck menu — name, description, price, dietary chips (GF/V/DF/etc),
  // optional image. The price + chips are inline, scannable at a glance.
  // No "learn more" links — every detail is here.
  const heading = data.heading || 'The menu'
  const intro = data.intro || ''
  const items = Array.isArray(data.items) ? data.items.filter(i => i && i.name) : []
  if (items.length === 0) return

  // Collect dietary tags across items so we can render a legend chip strip.
  const allDietary = new Set()
  for (const i of items) {
    if (Array.isArray(i.dietary)) i.dietary.forEach(d => { if (d) allDietary.add(String(d).toUpperCase()) })
  }
  const dietaryLegend = Array.isArray(data.dietary_legend) ? data.dietary_legend : Array.from(allDietary)
  const DIETARY_LABELS = { GF: 'Gluten-free', V: 'Vegetarian', VG: 'Vegan', DF: 'Dairy-free', N: 'Contains nut', SP: 'Spicy', K: 'Kosher', H: 'Halal' }
%>
<section id="menu" class="menu menu--cards">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title"><%= heading %></h2>
      <% if (intro) { %><p class="section-intro"><%= intro %></p><% } %>
      <% if (dietaryLegend.length > 0) { %>
        <ul class="menu__legend" aria-label="Dietary key">
          <% for (const code of dietaryLegend) { %>
            <li class="menu__legend-chip"><span class="menu__chip menu__chip--<%= String(code).toLowerCase() %>"><%= code %></span><%= DIETARY_LABELS[String(code).toUpperCase()] || code %></li>
          <% } %>
        </ul>
      <% } %>
    </div>
    <ul class="menu__grid" role="list">
      <% for (const item of items) { %>
        <li class="menu-item">
          <% if (item.image) { %>
            <div class="menu-item__image" style="background-image: url('<%= item.image %>')" role="img" aria-label="<%= item.name %>"></div>
          <% } %>
          <div class="menu-item__body">
            <div class="menu-item__head">
              <h3 class="menu-item__name"><%= item.name %></h3>
              <% if (item.price) { %><span class="menu-item__price"><%= item.price %></span><% } %>
            </div>
            <% if (item.description) { %><p class="menu-item__desc"><%= item.description %></p><% } %>
            <% if (Array.isArray(item.dietary) && item.dietary.length) { %>
              <ul class="menu-item__diet" aria-label="Dietary tags">
                <% for (const d of item.dietary) { %>
                  <li class="menu__chip menu__chip--<%= String(d).toLowerCase() %>"><%= String(d).toUpperCase() %></li>
                <% } %>
              </ul>
            <% } %>
          </div>
        </li>
      <% } %>
    </ul>
  </div>
</section>
