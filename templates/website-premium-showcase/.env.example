# Runtime configuration for this service — KEY NAMES ONLY.
# Every value is set on the Render service by Twomiah Factory (apps/api/src/services/deploy.ts). The generator does not
# write a .env for this service, so no secret is ever committed to the tenant repo. (Bun would load a .env, but a real
# environment variable always wins over it — values here would only have been stale copies or unreplaced token placeholders.)

# Required
DATABASE_URL=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# R2 / S3 storage — required for photo uploads in production. Falls back
# to local /uploads/* in dev when STORAGE_BACKEND != 's3'.
STORAGE_BACKEND=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Outbound email (lead replies, etc.)
SENDGRID_API_KEY=
FROM_EMAIL=

# Factory sync — set by the Factory deploy pipeline so this tenant can
# receive feature-flag updates without a redeploy.
FACTORY_URL=
TENANT_ID=
FACTORY_SYNC_KEY=

# Behavior toggles
NODE_ENV=
PORT=
