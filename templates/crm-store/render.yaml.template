# {{COMPANY_NAME}} — Store back-office (crm-store) Render Blueprint
# Generated by Twomiah Factory.
# One web service: the backend builds and serves the admin SPA (no separate site).
# NOTE: the real deploy is driven by the Render REST API (deploy.ts); this
# blueprint is the manual fallback.

services:
  - type: web
    name: {{COMPANY_SLUG}}-shop-api
    runtime: node
    plan: starter
    rootDir: crm-store/backend
    buildCommand: curl -fsSL https://bun.sh/install | bash && export PATH="$HOME/.bun/bin:$PATH" && cd ../frontend && bun install && VITE_API_URL="" bun run build && cp -r dist ../backend/frontend-dist && cd ../backend && bun install
    startCommand: export PATH="$HOME/.bun/bin:$PATH" && bun db/migrate.ts && bun db/seed.ts && bun src/index.ts
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: {{COMPANY_SLUG}}-shop
          property: connectionString
      - key: JWT_SECRET
        generateValue: true
      - key: JWT_REFRESH_SECRET
        generateValue: true
      - key: PAYMENT_ENC_KEY
        generateValue: true
      - key: BACKEND_URL
        value: {{BACKEND_URL}}
      - key: STOREFRONT_ORIGIN
        value: {{SITE_URL}}
      - key: STOREFRONT_URL
        value: {{SITE_URL}}
      - key: NODE_ENV
        value: production
      - key: PORT
        value: 10000

databases:
  - name: {{COMPANY_SLUG}}-shop
    plan: starter
    databaseName: {{COMPANY_SLUG_UNDERSCORE}}_shop
