# Runtime configuration for this service — KEY NAMES ONLY.
# Every value is set on the Render service by Twomiah Factory (apps/api/src/services/deploy.ts). The generator does not
# write a .env for this service, so no secret is ever committed to the tenant repo. (Bun would load a .env, but a real
# environment variable always wins over it — values here would only have been stale copies or unreplaced token placeholders.)

DATABASE_URL=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
NODE_ENV=
PORT=

# Encryption key for merchant payment credentials at rest (AES-256-GCM).
# 32-byte key, base64 or hex. Render injects this via generateValue.
PAYMENT_ENC_KEY=

# Public storefront that is allowed to read the catalog / start checkout (CORS + origin allowlist).
STOREFRONT_ORIGIN=

# Where the storefront sends buyers back after hosted checkout.
STOREFRONT_URL=

# Transactional order emails (Resend). Injected by the factory deploy; order
# confirmation / merchant-alert / shipped emails no-op gracefully if unset.
RESEND_API_KEY=
FACTORY_FROM_EMAIL=
# Optional override for the From address (else FACTORY_FROM_EMAIL is used).
STORE_FROM_EMAIL=

# Product-image storage (Cloudflare R2). Injected by the factory deploy. Uploads
# are written here privately and served back through this API's /media/<key>
# route, so no public bucket domain is required. Image upload no-ops with a 503
# if these are unset (paste-URL images still work).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# This service's own public URL — used to build absolute /media image URLs the
# storefront (separate origin) can load. Injected by the factory deploy.
BACKEND_URL=
