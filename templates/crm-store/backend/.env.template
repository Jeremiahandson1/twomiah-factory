# {{COMPANY_NAME}} — Store back-office (crm-store) configuration
DATABASE_URL="{{DATABASE_URL}}"

# Auth
JWT_SECRET="{{JWT_SECRET}}"
JWT_REFRESH_SECRET="{{JWT_REFRESH_SECRET}}"
NODE_ENV=production
PORT=10000

# Encryption key for merchant payment credentials at rest (AES-256-GCM).
# 32-byte key, base64 or hex. Render injects this via generateValue.
PAYMENT_ENC_KEY="{{ENCRYPTION_KEY}}"

# Public storefront that is allowed to read the catalog / start checkout (CORS + origin allowlist).
STOREFRONT_ORIGIN="{{SITE_URL}}"

# Where the storefront sends buyers back after hosted checkout.
STOREFRONT_URL="{{SITE_URL}}"

# Transactional order emails (Resend). Injected by the factory deploy; order
# confirmation / merchant-alert / shipped emails no-op gracefully if unset.
RESEND_API_KEY=""
FACTORY_FROM_EMAIL=""
# Optional override for the From address (else FACTORY_FROM_EMAIL is used).
STORE_FROM_EMAIL=""
