# Runtime configuration for this service — KEY NAMES ONLY.
# Every value is set on the Render service by Twomiah Factory (apps/api/src/services/deploy.ts). The generator does not
# write a .env for this service, so no secret is ever committed to the tenant repo. (Bun would load a .env, but a real
# environment variable always wins over it — values here would only have been stale copies or unreplaced token placeholders.)

# Database
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# Server
PORT=
NODE_ENV=
SITE_URL=

# Factory
FACTORY_SYNC_KEY=

# Dispensary Config
LOYALTY_ENABLED=
DELIVERY_ENABLED=
MERCH_STRIPE_ENABLED=
PURCHASE_LIMIT_OZ=

# Stripe (for merch only)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (email)
SENDGRID_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Sentry (error tracking)
SENTRY_DSN=

# R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
