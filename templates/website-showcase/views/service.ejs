<%
// Extract service data with fallbacks
const heroImage = service.heroImage || '';
const heroAnimation = service.heroAnimation || 'none';
const heroAnimationSpeed = service.heroAnimationSpeed || 10;
const phone = (typeof settings !== 'undefined' && settings && settings.phone) ? settings.phone : '{{COMPANY_PHONE}}';
const phoneRaw = phone.replace(/\D/g, '');
// Seeded copy that says "Call us" reads wrong with no phone on file (the owner's own wording is left alone).
const description = phoneRaw ? (service.fullDescription || service.description || '') : String(service.fullDescription || service.description || '').replace('Call us or send a message', 'Send us a message');

// Function to get image URL
function getImageUrl(p) {
  if (!p) return '';
  if (p.startsWith('http')) return p;
  if (p.startsWith('/')) return p;
  return '/uploads/' + p;
}

// Seeded services carry "name" (not "title")
const serviceTitle = service.title || service.name || '';

// Get other services (excluding current one); the /services/:slug route passes "services"
const _allSvc = (typeof allServices !== 'undefined' && allServices) ? allServices
  : (typeof services !== 'undefined' && Array.isArray(services)) ? services : [];
const otherServices = _allSvc.filter(s => s && s.visible !== false && (s.slug || s.id) && s.id !== service.id && s.slug !== service.slug);

// The generator fills empty nearby-city tokens with the home city: list each city once.
const _areas = ['{{CITY}}', '{{NEARBY_CITY_1}}', '{{NEARBY_CITY_2}}', '{{NEARBY_CITY_3}}', '{{NEARBY_CITY_4}}']
  .map((a) => String(a).trim()).filter((a, i, all) => a && all.findIndex((b) => b.toLowerCase() === a.toLowerCase()) === i);
%>

<div class="service-page">
  <!-- Hero Section -->
  <section 
    class="service-hero <%= heroImage ? 'has-image' : '' %>"
    style="--hero-speed: <%= heroAnimationSpeed %>s"
  >
    <% if (heroImage) { %>
      <div 
        class="service-hero-bg animation-<%= heroAnimation %>"
        style="background-image: <%- bgWithWebp(getImageUrl(heroImage)) %>"
      ></div>
      <div class="service-hero-overlay"></div>
    <% } %>
    <div class="service-hero-content">
      <div class="container">
        <a href="/#services" class="back-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          All Services
        </a>
        <h1><%= serviceTitle %></h1>
        <% if (service.tagline) { %>
          <p class="hero-tagline"><%= service.tagline %></p>
        <% } %>
        <% if (service.heroDescription) { %>
          <p class="hero-description"><%= service.heroDescription %></p>
        <% } %>
        <div class="hero-buttons">
          <a href="/contact" class="btn btn-primary btn-lg">Get in Touch</a>
          <% if (phoneRaw) { %><a href="tel:<%= phoneRaw %>" class="btn btn-outline-light btn-lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <%= phone %>
          </a><% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="service-main">
    <div class="container">
      <div class="service-layout">
        <!-- Main Column -->
        <div class="service-content">
          <div class="content-section">
            <% if (description) { %>
              <h2>About <%= serviceTitle %></h2>
              <% if (description.includes('<')) { %>
                <!-- HTML content -->
                <div class="prose"><%- description %></div>
              <% } else { %>
                <!-- Plain text content -->
                <div class="prose">
                  <% description.split('\n\n').forEach(function(para) { %>
                    <p><%= para %></p>
                  <% }); %>
                </div>
              <% } %>
            <% } %>
          </div>

          <!-- Services Offered / Offerings -->
          <% if (service.offerings && service.offerings.length > 0) { %>
            <div class="offerings-section">
              <h2><%= serviceTitle %> Options</h2>
              <div class="offerings-grid">
                <% service.offerings.forEach(function(offering, index) { %>
                  <div class="offering-card">
                    <div class="offering-number"><%= String(index + 1).padStart(2, '0') %></div>
                    <h3><%= offering.title %></h3>
                    <p><%= offering.description %></p>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Materials & Features -->
          <% if ((service.materials && service.materials.length > 0) || (service.features && service.features.length > 0)) { %>
            <div class="details-section">
              <div class="details-grid">
                <% if (service.materials && service.materials.length > 0) { %>
                  <div class="details-card">
                    <h3>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                      </svg>
                      What We Use
                    </h3>
                    <ul>
                      <% service.materials.forEach(function(material) { %>
                        <li>
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <%= material %>
                        </li>
                      <% }); %>
                    </ul>
                  </div>
                <% } %>
                <% if (service.features && service.features.length > 0) { %>
                  <div class="details-card">
                    <h3>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                        <circle cx="12" cy="8" r="7"></circle>
                        <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                      </svg>
                      Highlights
                    </h3>
                    <ul>
                      <% service.features.forEach(function(feature) { %>
                        <li>
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                          </svg>
                          <%= feature %>
                        </li>
                      <% }); %>
                    </ul>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Sidebar -->
        <aside class="service-sidebar">
          <div class="cta-card">
            <h3>Ready to Get Started?</h3>
            <p>Get in touch. We'd love to hear from you.</p>
            <% if (phoneRaw) { %><a href="tel:<%= phoneRaw %>" class="phone-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <%= phone %>
            </a><% } %>
            <a href="/contact" class="btn btn-primary btn-block">Contact Us</a>
          </div>

          <%/* no trust badges: licensed/insured/guarantee claims are the owner's to make */%>
        </aside>
      </div>
    </div>
  </section>

  <!-- Related Projects from Gallery -->
  <% if (typeof galleryProjects !== 'undefined' && galleryProjects && galleryProjects.length > 0) { %>
    <section class="service-projects">
      <div class="container">
        <div class="section-header">
          <h2>Recent Work</h2>
          <a href="/gallery" class="view-all-link">View Gallery →</a>
        </div>
        <div class="projects-grid">
          <% galleryProjects.forEach(function(project) { %>
            <a href="/gallery/<%= project.id %>" class="project-card">
              <div class="project-image">
                <% if (project.images && project.images[0]) { %>
                  <img 
                    src="<%= getImageUrl(project.images[0].thumbnail || project.images[0].url) %>"
                    alt="<%= project.title %>"
                  >
                <% } else { %>
                  <div class="project-placeholder">
                    <span><%= project.category %></span>
                  </div>
                <% } %>
                <div class="project-overlay">
                  <span>View</span>
                </div>
              </div>
              <div class="project-info">
                <h3><%= project.title %></h3>
                <% if (project.location) { %>
                  <p><%= project.location %></p>
                <% } %>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- FAQ Section -->
  <% if (service.faqs && service.faqs.length > 0) { %>
    <section class="service-faq">
      <div class="container">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-list">
          <% service.faqs.forEach(function(faq, index) { %>
            <div class="faq-item" data-index="<%= index %>">
              <button class="faq-question">
                <span><%= faq.question %></span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p><%= faq.answer %></p>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- FAQ Schema -->
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          <% service.faqs.forEach(function(faq, index) { %>
          {
            "@type": "Question",
            "name": <%- JSON.stringify(faq.question || '') %>,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": <%- JSON.stringify(faq.answer || '') %>
            }
          }<%= index < service.faqs.length - 1 ? ',' : '' %>
          <% }); %>
        ]
      }
      </script>
    </section>
  <% } %>

  <!-- Bottom CTA -->
  <section class="service-cta">
    <div class="container">
      <h2>Interested in <%= serviceTitle %>?</h2>
      <p>Get in touch with {{COMPANY_NAME}}. We'd love to hear from you.</p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-primary btn-lg">Get in Touch</a>
        <% if (phoneRaw) { %><a href="tel:<%= phoneRaw %>" class="btn btn-outline-light btn-lg">Call <%= phone %></a><% } %>
      </div>
    </div>
  </section>

  <!-- Other Services -->
  <% if (otherServices.length > 0) { %>
    <section class="other-services">
      <div class="container">
        <h3>Explore Our Other Services</h3>
        <div class="services-links">
          <% otherServices.forEach(function(s) { %>
            <a href="/services/<%= s.slug || s.id %>" class="service-link">
              <%= s.title || s.name %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Service Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": <%- JSON.stringify(serviceTitle + ' - {{COMPANY_NAME}}') %>,
    "description": <%- JSON.stringify(service.heroDescription || service.tagline || service.shortDescription || '') %>,
    "provider": {
      "@type": "LocalBusiness",
      "name": "{{COMPANY_NAME}}",
      "url": "{{SITE_URL}}",
<% if (phoneRaw) { %>      "telephone": "+1<%= phoneRaw %>",
<% } %>      "areaServed": { "@type": "City", "name": "{{CITY}}, {{STATE}}" }
    },
    "areaServed": [
      <% _areas.forEach(function(a, i) { %>{ "@type": "City", "name": <%- JSON.stringify(a + ', {{STATE}}') %> }<%= i < _areas.length - 1 ? ',' : '' %>
      <% }); %>
    ],
    "serviceType": <%- JSON.stringify(serviceTitle) %>
  }
  </script>
</div>

<script>
// FAQ accordion functionality
(function() {
  const faqItems = document.querySelectorAll('.faq-item');
  
  faqItems.forEach(function(item) {
    const button = item.querySelector('.faq-question');
    
    button.addEventListener('click', function() {
      const isOpen = item.classList.contains('open');
      
      // Close all FAQs
      faqItems.forEach(function(i) {
        i.classList.remove('open');
      });
      
      // Open this one if it wasn't already open
      if (!isOpen) {
        item.classList.add('open');
      }
    });
  });
})();
</script>
