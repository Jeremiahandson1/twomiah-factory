<%
// Extract data with fallbacks
const hero = (typeof homepage !== 'undefined' && homepage && homepage.hero) ? homepage.hero : {};
const trustBadges = (typeof homepage !== 'undefined' && homepage && homepage.trustBadges) ? homepage.trustBadges.filter(b => b.enabled) : [];
const ctaSection = (typeof homepage !== 'undefined' && homepage && homepage.ctaSection) ? homepage.ctaSection : {};
// Empty nearby-city slots are filled with the home city, so de-duplicate.
const serviceAreas = ((typeof homepage !== 'undefined' && homepage && Array.isArray(homepage.serviceAreas) && homepage.serviceAreas.length) ? homepage.serviceAreas : ['{{CITY}}', '{{NEARBY_CITY_1}}', '{{NEARBY_CITY_2}}', '{{NEARBY_CITY_3}}', '{{NEARBY_CITY_4}}'])
  .map((a) => String(a || '').trim()).filter((a, i, all) => a && all.findIndex((b) => b.toLowerCase() === a.toLowerCase()) === i);
// Form choices are the site's own services, not a fixed list.
const _svcOpts = (typeof services !== 'undefined' && Array.isArray(services) ? services : []).filter((s) => s && s.visible !== false && (s.name || s.title));
const businessHours = (typeof homepage !== 'undefined' && homepage && homepage.businessHours) ? homepage.businessHours : {};

// Settings with fallbacks
const phone = (typeof settings !== 'undefined' && settings && settings.phone) ? settings.phone : '{{COMPANY_PHONE}}';
const email = (typeof settings !== 'undefined' && settings && settings.email) ? settings.email : '{{COMPANY_EMAIL}}';
const address = (typeof settings !== 'undefined' && settings && settings.address) ? settings.address : '{{COMPANY_ADDRESS}}';
const city = (typeof settings !== 'undefined' && settings && settings.city) ? settings.city : '{{CITY}}';
const state = (typeof settings !== 'undefined' && settings && settings.state) ? settings.state : '{{STATE}}';
const zip = (typeof settings !== 'undefined' && settings && settings.zip) ? settings.zip : '{{ZIP}}';
const phoneRaw = phone.replace(/\D/g, '');

// Function to get image URL
function getImageUrl(p) {
  if (!p) return '';
  if (p.startsWith('http')) return p;
  if (p.startsWith('/')) return p;
  return '/uploads/' + p;
}
%>

<div class="home-page">

  <!--  SPLIT HERO  -->
  <section class="hero-split">
    <div class="container">
      <div class="hero-split-inner">

        <!-- Left: Text Content -->
        <div class="hero-split-text">
          <% if (hero.tagline) { %>
            <div class="hero-badge-pill">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <%= hero.tagline %>
            </div>
          <% } else { %>
            <div class="hero-badge-pill">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              COMPASSIONATE VETERINARY CARE
            </div>
          <% } %>

          <h1 class="hero-split-headline"><%= hero.title || 'Compassionate Veterinary Care for Your Beloved Pets' %></h1>

          <p class="hero-split-sub"><%= hero.description || 'Caring for dogs, cats, and small animals in {{CITY}} and the {{SERVICE_REGION}} with compassionate veterinary care.' %></p>

          <div class="hero-split-buttons">
            <a href="tel:<%= phoneRaw %>" class="btn btn-warm btn-lg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.19 14.9 19.79 19.79 0 0 1 1.12 6.24 2 2 0 0 1 3.1 4h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16.92z"/></svg>
              Call <%= phone %>
            </a>
            <a href="<%= hero.primaryButtonLink || '#contact' %>" class="btn btn-outline-teal btn-lg">
              <%= hero.primaryButtonText || 'Request a Consultation' %>
            </a>
          </div>
        </div>

        <!-- Right: Hero Photo -->
        <div class="hero-split-photo">
          <% if (hero.image) { %>
            <img
              src="<%= getImageUrl(hero.image) %>"
              alt="Veterinarian caring for a pet at {{COMPANY_NAME}} in {{CITY}} {{STATE}}"
              class="hero-photo-img"
              loading="eager"
            >
          <% } else { %>
            <div class="hero-photo-placeholder">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              <p>Add a hero photo<br>in Admin &rarr; Homepage</p>
            </div>
          <% } %>
        </div>

      </div>
    </div>
  </section>

  <!--  TRUST BAR  -->
  <div class="trust-bar">
    <div class="container">
      <div class="trust-bar-items">
        <% if (trustBadges && trustBadges.length > 0) { %>
          <% trustBadges.forEach(function(badge) { %>
            <div class="trust-bar-item">
              <% if (badge.icon === 'shield' || badge.icon === 'check') { %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <% } else if (badge.icon === 'clock') { %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <% } else { %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <% } %>
              <span><%= badge.label %></span>
            </div>
          <% }); %>
        <% } else { %>
          <div class="trust-bar-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Compassionate Care</span></div>
          <div class="trust-bar-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Gentle Handling</span></div>
          <div class="trust-bar-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Preventive Care</span></div>
          <div class="trust-bar-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Serving <%= city %></span></div>
        <% } %>
      </div>
    </div>
  </div>

  <!--  ABOUT US  -->
  <section class="about-section" id="about">
    <div class="container">
      <div class="section-eyebrow">About Us</div>
      <h2 class="section-headline-serif">Where Your Pet Is Treated Like Family</h2>
      <div class="about-body">
        <p><%= settings && settings.aboutParagraph1 || "We are a veterinary practice serving " + (city || "the area") + " and the surrounding communities. We know your pet is part of your family -- and we treat every pet that comes through our doors with the same love and attention we'd give our own." %></p>
        <p><%= settings && settings.aboutParagraph2 || "Whether it's a routine checkup or a health concern, we take the time to listen, explain things clearly, and partner with you to keep your companion happy and healthy for years to come." %></p>
        <%/* No accreditation quote: a site states only what its owner supplied. */%>
      </div>
    </div>
  </section>

  <%/* No "Meet our vets" section: the team it showed was invented. A site states
       only what its owner supplied, and there is no staff data source yet. */%>

  <!--  SERVICES  -->
  <section class="hc-services-section" id="services">
    <div class="container">
      <div class="section-eyebrow">Our Services</div>
      <h2 class="section-headline-serif">How We Can Help</h2>
      <div class="hc-services-grid">
        <% if (typeof services !== 'undefined' && services && services.length > 0) { %>
          <% services.forEach(function(service) { %>
            <div class="hc-service-card">
              <div class="hc-service-icon">
                <% if (service.svgIcon) { %>
                  <%- service.svgIcon %>
                <% } else { %>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                <% } %>
              </div>
              <% if (service.slug) { %>
              <h3><a href="/services/<%= service.slug %>" style="color:inherit;text-decoration:none"><%= service.title || service.name %></a></h3>
              <% } else { %>
              <h3><%= service.title || service.name %></h3>
              <% } %>
              <p><%= service.shortDescription || service.tagline || service.description %></p>
            </div>
          <% }); %>
        <% } else { %>
          <div class="hc-service-card"><div class="hc-service-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div><h3>Wellness Exams</h3><p>Comprehensive nose-to-tail checkups that catch problems early and keep your pet healthy at every life stage.</p></div>
          <div class="hc-service-card"><div class="hc-service-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div><h3>Surgery &amp; Procedures</h3><p>Surgical care with attention to your pet's comfort before, during, and after the procedure.</p></div>
          <div class="hc-service-card"><div class="hc-service-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 14s1.5 2 4 2 4-2 4-2"/><circle cx="12" cy="12" r="10"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></div><h3>Dental Care</h3><p>Dental care that protects your pet's teeth, gums, and overall health.</p></div>
          <div class="hc-service-card"><div class="hc-service-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><h3>Vaccinations &amp; Prevention</h3><p>Tailored vaccine schedules plus flea, tick, and heartworm prevention to shield your pet from preventable disease.</p></div>
          <div class="hc-service-card"><div class="hc-service-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div><h3>Sick Visits</h3><p>When your pet isn't feeling well, we'll work with you to find out why and how to help.</p></div>
          <div class="hc-service-card"><div class="hc-service-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></div><h3>Internal Medicine &amp; Diagnostics</h3><p>Diagnostics and ongoing care for chronic conditions, with a clear treatment plan.</p></div>
        <% } %>
      </div>
    </div>
  </section>

  <!--  SERVICE AREA  -->
  <section class="service-area-section" id="areas">
    <div class="container">
      <div class="section-eyebrow">Service Area</div>
      <h2 class="section-headline-serif">Proudly Serving the <%= settings && settings.serviceRegion || (city + ' Area') %></h2>
      <p class="service-area-sub">We welcome pets and their families from <%= city %> and surrounding communities throughout the region.</p>
      <div class="service-area-pills">
        <% serviceAreas.forEach(function(area, i) { %>
          <span class="area-pill <%= i === 0 ? 'area-pill-active' : '' %>"><%= area %></span>
        <% }); %>
      </div>
    </div>
  </section>

  <!--  CTA BANNER  -->
  <section class="hc-cta-banner">
    <div class="container">
      <h2><%= ctaSection.title || "Your pet's health is our priority." %></h2>
      <p><%= ctaSection.description || "Whether it's a routine checkup or an urgent concern, our caring veterinary team is here to help. Schedule an appointment or call us today." %></p>
      <div class="hc-cta-buttons">
        <a href="tel:<%= phoneRaw %>" class="btn hc-cta-btn-white">Call <%= phone %></a>
        <a href="#contact" class="btn hc-cta-btn-outline">Schedule a Visit</a>
      </div>
    </div>
  </section>

  <!--  CONTACT  -->
  <section class="hc-contact-section" id="contact">
    <div class="container">
      <div class="hc-contact-grid">

        <!-- Left: Info -->
        <div class="hc-contact-info">
          <h2>Schedule Your Pet's Visit</h2>
          <p>Whether your pet needs a wellness checkup or you have an urgent concern, we're happy to answer your questions. Reach out by phone, email, or the appointment form.</p>
          <div class="hc-contact-items">
            <div class="hc-contact-item">
              <div class="hc-contact-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.19 14.9 19.79 19.79 0 0 1 1.12 6.24 2 2 0 0 1 3.1 4h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16.92z"/></svg>
              </div>
              <div>
                <div class="hc-contact-label">Phone</div>
                <a href="tel:<%= phoneRaw %>" class="hc-contact-value"><%= phone %></a>
              </div>
            </div>
            <div class="hc-contact-item">
              <div class="hc-contact-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <div class="hc-contact-label">Email</div>
                <a href="mailto:<%= email %>" class="hc-contact-value"><%= email %></a>
              </div>
            </div>
            <div class="hc-contact-item">
              <div class="hc-contact-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <div class="hc-contact-label">Location</div>
                <span class="hc-contact-value"><%= city %>, <%= typeof stateFull !== 'undefined' && stateFull ? stateFull : state %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="hc-contact-form-wrap">
          <h3>Request an Appointment</h3>
          <p class="form-subhead">Tell us a little about your pet and we'll be in touch soon.</p>
          <div id="form-success" style="display:none;padding:2rem;background:#059669;color:#fff;border-radius:12px;text-align:center;margin-bottom:1rem;">
            <strong>Thank you!</strong> We've received your request and will be in touch soon.
          </div>
          <form id="contact-form" method="POST" action="/api/admin/leads">
            <div class="hc-form-group">
              <label>Your Name</label>
              <input type="text" name="name" required placeholder="">
            </div>
            <div class="hc-form-group">
              <label>Phone Number</label>
              <input type="tel" name="phone" required placeholder="">
            </div>
            <div class="hc-form-group">
              <label>Email Address</label>
              <input type="email" name="email" placeholder="">
            </div>
            <div class="hc-form-group">
              <label>Pet's Name</label>
              <input type="text" name="petName" placeholder="">
            </div>
            <div class="hc-form-group">
              <label>What type of appointment are you looking for?</label>
              <select name="careType">
                <option value="">Select an option...</option>
                <% _svcOpts.forEach(function(s) { %><option><%= s.name || s.title %></option><% }); %>
                <option>Sick Visit</option>
                <option>Other / Not Sure</option>
              </select>
            </div>
            <div class="hc-form-group">
              <label>Tell us about your pet</label>
              <textarea name="message" rows="4" placeholder="What kind of pet do you have, and what can we help with?"></textarea>
            </div>
            <div id="form-error" style="display:none;color:#dc2626;background:#fef2f2;padding:12px 16px;border-radius:8px;margin-bottom:8px;font-size:.9rem;"></div>
            <div class="form-group checkbox-group sms-consent">
              <label>
                <input type="checkbox" name="sms_consent" value="yes">
                I agree to receive text messages from {{COMPANY_NAME}} about my inquiry, appointments, and offers. Message frequency varies. Msg &amp; data rates may apply. Reply STOP to opt out, HELP for help. Consent is not a condition of purchase.
              </label>
            </div>
            <button type="submit" class="btn btn-warm btn-lg" style="width:100%;border-radius:50px;">Send Message</button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <%
    // Defensive JSON-LD escape (Claflin 3.6) + email guard (3.7).
    const _emailOk = typeof email === 'string' && /^[^\s<>]+@[^\s<>]+\.[^\s<>]+$/.test(email);
  %>
  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VeterinaryCare",
    "name": <%- _jsonStr(settings && settings.companyName || 'Veterinary Hospital') %>,
    "url": <%- _jsonStr(settings && settings.siteUrl || '') %>,
    "telephone": <%- _jsonStr('+1' + phoneRaw) %>,
<% if (_emailOk) { %>    "email": <%- _jsonStr(email) %>,
<% } %>    "address": {
      "@type": "PostalAddress",
      "addressLocality": <%- _jsonStr(city) %>,
      "addressRegion": <%- _jsonStr(state) %>,
      "postalCode": <%- _jsonStr(zip) %>,
      "addressCountry": "US"
    },
    "areaServed": [<% serviceAreas.forEach(function(area, i) { %>{"@type":"City","name":<%- _jsonStr(area) %>}<%- i < serviceAreas.length-1 ? ',' : '' %><% }); %>]
  }
  </script>

</div>

<script>
// Testimonial slider functionality
(function() {
  const slider = document.querySelector('.testimonial-slider');
  const dots = document.querySelectorAll('.testimonial-dots button');
  const cards = document.querySelectorAll('.testimonial-card');
  
  if (!slider || cards.length === 0) return;
  
  let currentIndex = 0;
  
  function showTestimonial(index) {
    cards.forEach((card, i) => {
      card.classList.toggle('active', i === index);
    });
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
    });
    currentIndex = index;
  }
  
  // Dot click handlers
  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => showTestimonial(index));
  });
  
  // Auto-rotate every 8 seconds
  if (cards.length > 1) {
    setInterval(() => {
      const nextIndex = (currentIndex + 1) % cards.length;
      showTestimonial(nextIndex);
    }, 8000);
  }
})();

// Contact form submission
(function() {
  const form = document.getElementById('contact-form');
  const errorDiv = document.getElementById('form-error');
  
  if (!form) return;
  
  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Submitting...';
    submitBtn.disabled = true;
    errorDiv.style.display = 'none';
    
    try {
      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        phone: formData.get('phone'),
        email: formData.get('email'),
        address: formData.get('address'),
        service: formData.getAll('services[]').join(', '),
        message: formData.get('message'),
        source: 'homepage'
      };
      
      const response = await fetch('/api/admin/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      if (response.ok) {
        form.reset();
        form.style.display = 'none';
        document.getElementById('form-success').style.display = 'block';
      } else {
        throw new Error('Submission failed');
      }
    } catch (err) {
      errorDiv.textContent = 'Something went wrong. Please try again or call us directly.';
      errorDiv.style.display = 'block';
    }
    
    submitBtn.textContent = originalText;
    submitBtn.disabled = false;
  });
})();

// Scroll animations
(function() {
  const observer = new IntersectionObserver(
    function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.animate-on-scroll').forEach(function(el) {
    observer.observe(el);
  });
})();
</script>
