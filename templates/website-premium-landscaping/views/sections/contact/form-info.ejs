<%
  // Contact section: form on one side, business details (phone, email,
  // address, hours, response promise) on the other. Used as the main
  // body of a /contact page.
  //
  // The form is render-only here — wiring it to a backend lives in
  // server-static.ts when the template gets a real deploy pipeline.
  const heading = data.heading || 'Start a conversation'
  const intro = data.intro || ''
  const phone = data.phone || ''
  const email = data.email || ''
  const address = data.address || ''
  const hours = Array.isArray(data.hours) ? data.hours : []
  const responsePromise = data.responsePromise || ''
  const formAction = data.formAction || '/contact'
%>
<section class="contact-section">
  <div class="container contact-section__grid">
    <div class="contact-section__copy">
      <h1 class="contact-section__title"><%= heading %></h1>
      <% if (intro) { %><p class="contact-section__intro"><%= intro %></p><% } %>

      <div class="contact-section__details">
        <% if (phone) { %>
          <div class="contact-section__row">
            <div class="contact-section__label">Phone</div>
            <a class="contact-section__value" href="tel:<%= phone %>"><%= phone %></a>
          </div>
        <% } %>
        <% if (email) { %>
          <div class="contact-section__row">
            <div class="contact-section__label">Email</div>
            <a class="contact-section__value" href="mailto:<%= email %>"><%= email %></a>
          </div>
        <% } %>
        <% if (address) { %>
          <div class="contact-section__row">
            <div class="contact-section__label">Office</div>
            <div class="contact-section__value"><%= address %></div>
          </div>
        <% } %>
        <% if (hours.length) { %>
          <div class="contact-section__row">
            <div class="contact-section__label">Hours</div>
            <div class="contact-section__value">
              <% for (const h of hours) { %><div><%= h %></div><% } %>
            </div>
          </div>
        <% } %>
      </div>

      <% if (responsePromise) { %><div class="contact-section__promise"><%= responsePromise %></div><% } %>
    </div>

    <form class="contact-form" action="<%= formAction %>" method="post">
      <div class="contact-form__row">
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" required>
      </div>
      <div class="contact-form__row">
        <label for="cf-email">Email</label>
        <input id="cf-email" name="email" type="email" required>
      </div>
      <div class="contact-form__row">
        <label for="cf-phone">Phone (optional)</label>
        <input id="cf-phone" name="phone" type="tel">
      </div>
      <div class="contact-form__row">
        <label for="cf-project">What you're working on</label>
        <textarea id="cf-project" name="project" rows="5" required></textarea>
      </div>
      <button class="btn btn--primary btn--lg" type="submit">Send</button>
    </form>
  </div>
</section>
