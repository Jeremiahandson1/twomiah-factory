# Required
DATABASE_URL=postgres://user:pass@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=owner@example.com
ADMIN_INITIAL_PASSWORD=change-me-on-first-login

# R2 / S3 storage — required for photo uploads in production. Falls back
# to local /uploads/* in dev when STORAGE_BACKEND != 's3'.
STORAGE_BACKEND=s3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Outbound email (lead replies, etc.)
SENDGRID_API_KEY=
FROM_EMAIL=hello@example.com

# Factory sync — set by the Factory deploy pipeline so this tenant can
# receive feature-flag updates without a redeploy.
FACTORY_URL=
TENANT_ID=
FACTORY_SYNC_KEY=

# Behavior toggles
NODE_ENV=production
PORT=3000
