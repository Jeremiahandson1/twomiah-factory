<%
// Extract data with fallbacks
const hero = (typeof homepage !== 'undefined' && homepage && homepage.hero) ? homepage.hero : {};
const trustBadges = (typeof homepage !== 'undefined' && homepage && homepage.trustBadges) ? homepage.trustBadges.filter(b => b.enabled) : [];
const ctaSection = (typeof homepage !== 'undefined' && homepage && homepage.ctaSection) ? homepage.ctaSection : {};
const serviceAreas = (typeof homepage !== 'undefined' && homepage && homepage.serviceAreas) ? homepage.serviceAreas : ['{{CITY}}', '{{NEARBY_CITY_4}}', '{{NEARBY_CITY_1}}', '{{NEARBY_CITY_2}}', '{{NEARBY_CITY_3}}'];
const businessHours = (typeof homepage !== 'undefined' && homepage && homepage.businessHours) ? homepage.businessHours : {};

// Settings with fallbacks
const phone = (typeof settings !== 'undefined' && settings && settings.phone) ? settings.phone : '{{COMPANY_PHONE}}';
const email = (typeof settings !== 'undefined' && settings && settings.email) ? settings.email : '{{COMPANY_EMAIL}}';
const address = (typeof settings !== 'undefined' && settings && settings.address) ? settings.address : '{{COMPANY_ADDRESS}}';
const city = (typeof settings !== 'undefined' && settings && settings.city) ? settings.city : '{{CITY}}';
const state = (typeof settings !== 'undefined' && settings && settings.state) ? settings.state : '{{STATE}}';
const zip = (typeof settings !== 'undefined' && settings && settings.zip) ? settings.zip : '{{ZIP}}';
const phoneRaw = phone.replace(/\D/g, '');

// Areas: the generator fills empty nearby-city tokens with the home city, so de-duplicate.
const _areas = serviceAreas
  .map((a) => String(a).trim()).filter((a, i, all) => a && all.findIndex((b) => b.toLowerCase() === a.toLowerCase()) === i);

// Hours print only for days the owner gave a real open time: a site states only what its owner supplied.
const _dayNames = { monday: 'Monday', tuesday: 'Tuesday', wednesday: 'Wednesday', thursday: 'Thursday', friday: 'Friday', saturday: 'Saturday', sunday: 'Sunday' };
const _openDays = Object.keys(_dayNames).filter(function (d) {
  const h = businessHours[d];
  return h && !h.closed && String(h.open || '').trim() && !/closed/i.test(String(h.open));
});
// "9:00 AM" -> "09:00" for JSON-LD; '' when the text is not a recognisable time.
function _to24(t) {
  const m = String(t || '').trim().match(/^(\d{1,2})(?::(\d{2}))?\s*(am|pm)?$/i);
  if (!m) return '';
  let h = parseInt(m[1], 10);
  if (m[3]) { if (/pm/i.test(m[3]) && h < 12) h += 12; if (/am/i.test(m[3]) && h === 12) h = 0; }
  if (h > 23) return '';
  return String(h).padStart(2, '0') + ':' + (m[2] || '00');
}
const _hoursLd = _openDays
  .map(function (d) { return { day: _dayNames[d], opens: _to24(businessHours[d].open), closes: _to24(businessHours[d].close) }; })
  .filter(function (x) { return x.opens && x.closes; });

// Function to get image URL
function getImageUrl(p) {
  if (!p) return '';
  if (p.startsWith('http')) return p;
  if (p.startsWith('/')) return p;
  return '/uploads/' + p;
}
%>

<div class="home-page">
  <!-- Age Gate Overlay (first visit check) -->
  <div id="ageGateOverlay" class="age-overlay" style="display:none">
    <div class="age-overlay-card">
      <h2>Are you 21 or older?</h2>
      <p>You must be 21+ to browse this website.</p>
      <div class="age-overlay-buttons">
        <button id="ageYesBtn" class="btn btn-primary btn-lg">Yes, I'm 21+</button>
        <a href="https://www.google.com" class="btn btn-outline btn-lg">No</a>
      </div>
    </div>
  </div>

  <!-- Hero Section — Fluid Sim + Shader BG + Kinetic Type -->
  <section
    class="hero-video hero-enhanced hero-gradient-morph <%= hero.image ? 'hero-animated' : '' %>"
    style="--hero-speed: <%= hero.animationSpeed || 10 %>s"
  >
    <!-- WebGL Fluid Simulation Layer -->
    <div class="fluid-canvas-wrap"></div>

    <% if (hero.image) { %>
      <div
        class="hero-bg animation-<%= hero.animation || 'none' %>"
        style="background-image: <%- bgWithWebp(getImageUrl(hero.image)) %>"
      ></div>
      <div class="hero-overlay"></div>
    <% } else { %>
      <div class="hero-video-bg">
        <div class="video-placeholder"></div>
        <div class="hero-overlay"></div>
      </div>
    <% } %>
    <div class="hero-video-content <%= hero.image ? 'hero-content' : '' %>" data-depth="0.03">
      <h1 class="kinetic-text variable-font-hero"><%= hero.title || '{{COMPANY_NAME}}' %></h1>
      <h2><%= hero.subtitle || 'Cannabis Dispensary' %></h2>
      <div class="hero-line"></div>
      <p class="hero-tagline"><strong><%= hero.tagline || 'ADULTS 21+ ONLY' %></strong></p>
      <p class="hero-awards"><%= hero.description || 'Browse the menu and order online.' %></p>
      <div class="hero-buttons">
        <a href="<%= hero.primaryButtonLink || '/menu' %>" class="btn btn-primary btn-lg magnetic-btn">
          <span class="btn-text"><%= hero.primaryButtonText || 'Browse Menu' %></span>
        </a>
        <a href="<%= hero.secondaryButtonLink || '/order' %>" class="btn btn-outline-light btn-lg magnetic-btn">
          <span class="btn-text"><%= hero.secondaryButtonText || 'Order Online' %></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 21+ Notice Bar -->
  <div class="age-notice-bar">
    <div class="container">
      <span>&#9888; Adults 21+ Only &mdash; Valid government-issued ID required for all purchases.</span>
    </div>
  </div>

  <!-- Stats Counter Section -->
  <section class="section-aurora" style="padding:60px 0;">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:32px;text-align:center;" class="stagger-grid">
        <%/* No product counts, ratings, customer counts or years: a site states only what its owner supplied. */%>
        <div class="glass-card scroll-reveal" style="padding:32px 20px;">
          <div style="font-size:1.6rem;font-weight:800;line-height:1.2;">Menu</div>
          <div style="font-size:0.9rem;font-weight:600;margin-top:8px;color:#666;">Browse online before you visit</div>
        </div>
        <div class="glass-card scroll-reveal" style="padding:32px 20px;">
          <div style="font-size:1.6rem;font-weight:800;line-height:1.2;">Order Ahead</div>
          <div style="font-size:0.9rem;font-weight:600;margin-top:8px;color:#666;">Place your order online</div>
        </div>
        <div class="glass-card scroll-reveal" style="padding:32px 20px;">
          <div style="font-size:1.6rem;font-weight:800;line-height:1.2;">Loyalty</div>
          <div style="font-size:0.9rem;font-weight:600;margin-top:8px;color:#666;">Check your points online</div>
        </div>
        <div class="glass-card scroll-reveal" style="padding:32px 20px;">
          <div style="font-size:1.6rem;font-weight:800;line-height:1.2;">ID Required</div>
          <div style="font-size:0.9rem;font-weight:600;margin-top:8px;color:#666;">Adults 21 and older only</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Store Hours Section -->
  <section class="hours-section divider-wave">
    <div class="container">
      <div class="hours-grid">
        <div class="hours-info scroll-slide-left">
          <h2>Visit Us</h2>
          <% if (_openDays.length) { %>
          <div class="hours-table">
            <% _openDays.forEach(function (d) { %>
              <div class="hours-row">
                <span><%= _dayNames[d] %></span>
                <span><%= businessHours[d].open %><% if (businessHours[d].close) { %> - <%= businessHours[d].close %><% } %></span>
              </div>
            <% }); %>
          </div>
          <% } %>
          <div class="hours-address">
            <% if (address) { %>
            <p><%= address %></p>
            <% } %>
            <p><%= city %>, <%= state %><% if (zip) { %> <%= zip %><% } %></p>
            <% if (phoneRaw) { %>
            <a href="tel:<%= phoneRaw %>" class="hours-phone"><%= phone %></a>
            <% } %>
          </div>
        </div>
        <div class="hours-features scroll-slide-right stagger-grid">
          <div class="feature-badge glass-card hover-glow">
            <span class="feature-icon">&#128666;</span>
            <div>
              <strong>Order Online</strong>
              <span>Order ahead from our menu</span>
            </div>
          </div>
          <div class="feature-badge glass-card hover-glow">
            <span class="feature-icon">&#127807;</span>
            <div>
              <strong>Browse the Menu</strong>
              <span>See products by category and strain type</span>
            </div>
          </div>
          <div class="feature-badge glass-card hover-glow">
            <span class="feature-icon">&#11088;</span>
            <div>
              <strong>Loyalty Program</strong>
              <span>Check your points balance online</span>
            </div>
          </div>
          <div class="feature-badge glass-card hover-glow">
            <span class="feature-icon">&#128101;</span>
            <div>
              <strong>Questions Welcome</strong>
              <span>Ask us about any product on the menu</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <% if (typeof services !== 'undefined' && services && services.length > 0) { %>
  <section class="featured-section section-aurora glow-border" id="services">
    <div class="container">
      <h2 class="scroll-reveal">Featured Products</h2>
      <div class="services-grid stagger-grid">
        <% services.forEach(function(service) { %>
          <div class="service-card card-lift hover-glow scroll-reveal">
            <div class="service-image">
              <% if (service.image) { %>
                <img
                  src="<%= getImageUrl(service.image) %>"
                  alt="<%= service.title || service.name %> at {{COMPANY_NAME}}"
                  loading="lazy"
                  width="800"
                  height="600"
                >
              <% } else { %>
                <span class="service-icon"><%= service.icon || '&#127807;' %></span>
              <% } %>
            </div>
            <div class="service-content">
              <h3><%= service.title || service.name %></h3>
              <p><%= service.shortDescription || service.tagline || service.description %></p>
              <% if (service.links && service.links.length > 0) { %>
                <hr>
                <ul class="service-links">
                  <% service.links.forEach(function(link) { %>
                    <li><a href="<%= link.href %>"><%= link.label %></a></li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="/menu" class="btn btn-primary btn-lg magnetic-btn"><span class="btn-text">View Full Menu</span></a>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Why Choose Us Section -->
  <section class="why-choose-section shader-bg divider-wave">
    <div class="container">
      <h2 class="scroll-reveal">Visiting {{COMPANY_NAME}}</h2>
      <div class="why-grid stagger-grid">
        <div class="why-item glass-card hover-glow scroll-reveal">
          <div class="why-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Bring Your ID</h3>
          <p>You must be 21 or older to purchase cannabis. Bring a valid, unexpired government-issued photo ID.</p>
        </div>
        <div class="why-item glass-card hover-glow scroll-reveal">
          <div class="why-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Ask Us Anything</h3>
          <p>Whether you are a seasoned consumer or visiting a dispensary for the first time, ask us about the products on our menu.</p>
        </div>
        <div class="why-item glass-card hover-glow scroll-reveal">
          <div class="why-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>Find Us</h3>
          <p>Visit us in <%= city %>, <%= state %>, or browse the menu online and order ahead.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <% if (typeof testimonials !== 'undefined' && testimonials && testimonials.length > 0) { %>
    <section class="testimonials-section section-aurora">
      <div class="container">
        <h2>What Our Customers Say</h2>
        <div class="testimonial-slider">
          <% testimonials.forEach(function(testimonial, index) { %>
            <div class="testimonial-card <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>">
              <div class="testimonial-content">
                <div class="testimonial-stars">
                  <%= '★'.repeat(testimonial.rating || 5) %>
                </div>
                <blockquote>"<%= testimonial.text %>"</blockquote>
                <div class="testimonial-author">
                  <% if (testimonial.image) { %>
                    <img src="<%= getImageUrl(testimonial.image) %>" alt="<%= testimonial.author %>">
                  <% } %>
                  <div>
                    <strong><%= testimonial.author %></strong>
                    <% if (testimonial.location) { %>
                      <span><%= testimonial.location %></span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
        <% if (testimonials.length > 1) { %>
          <div class="testimonial-dots">
            <% testimonials.forEach(function(_, i) { %>
              <button
                class="<%= i === 0 ? 'active' : '' %>"
                data-index="<%= i %>"
                aria-label="Testimonial <%= i + 1 %>"
              ></button>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- Trust Badges -->
  <% if (trustBadges.length > 0) { %>
    <section class="trust-section">
      <div class="container">
        <div class="review-badges">
          <% trustBadges.forEach(function(badge) { %>
            <div class="review-badge">
              <% if (badge.type === 'google') { %>
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
              <% } else if (badge.type === 'leafly') { %>
                <span class="badge-text" style="color:#00b368;font-weight:800;">Leafly</span>
              <% } else if (badge.type === 'weedmaps') { %>
                <span class="badge-text" style="color:#00c389;font-weight:800;">WM</span>
              <% } else { %>
                <span class="badge-text">&#10003;</span>
              <% } %>
              <div class="badge-info">
                <span class="stars"><%= badge.label %></span>
                <span class="count"><%= badge.sublabel %></span>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- CTA Section -->
  <section
    class="cta-section aurora-bg"
    <% if (ctaSection.backgroundImage) { %>
      style="background-image: <%- bgWithWebp(getImageUrl(ctaSection.backgroundImage)) %>"
    <% } %>
  >
    <div class="container">
      <%
        const ctaTitle = ctaSection.title || 'Browse the menu,\norder ahead.';
        const ctaTitleLines = ctaTitle.split('\n');
      %>
      <h2>
        <% ctaTitleLines.forEach(function(line, i) { %>
          <%= line %><% if (i === 0 && ctaTitleLines.length > 1) { %><br><% } %>
        <% }); %>
      </h2>
      <p><%= ctaSection.description || "Browse our menu and place your order online. Adults 21+ only." %></p>
      <div class="cta-buttons">
        <a href="<%= ctaSection.primaryButtonLink || '/order' %>" class="btn btn-primary btn-lg magnetic-btn">
          <span class="btn-text"><%= ctaSection.primaryButtonText || 'Order Now' %></span>
        </a>
        <% const _ctaSecondaryLink = ctaSection.secondaryButtonLink || 'tel:' + phoneRaw; %>
        <% if (!/^tel:\D*$/.test(_ctaSecondaryLink)) { %>
        <a href="<%= _ctaSecondaryLink %>" class="btn btn-outline btn-lg magnetic-btn">
          <span class="btn-text"><%= ctaSection.secondaryButtonText || 'Call ' + phone %></span>
        </a>
        <% } %>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="home-faq" id="faq">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="home-faq-list">
        <details class="home-faq-item scroll-reveal">
          <summary><strong>What do I need to bring to purchase cannabis?</strong></summary>
          <p>You must be 21 or older and present a valid, unexpired government-issued photo ID (driver's license, state ID, or passport). Temporary or expired IDs are not accepted.</p>
        </details>
        <details class="home-faq-item scroll-reveal">
          <summary><strong>Can I order ahead?</strong></summary>
          <p>Yes. Browse our menu, add items to your cart, and place your order online. Contact us with any questions about your order.</p>
        </details>
        <details class="home-faq-item scroll-reveal">
          <summary><strong>How does the loyalty program work?</strong></summary>
          <p>Ask us about joining. Members can check their points balance on our <a href="/loyalty">loyalty page</a>.</p>
        </details>
        <details class="home-faq-item scroll-reveal">
          <summary><strong>Is there a limit on how much I can buy?</strong></summary>
          <p>Purchase limits are set by state law and can differ for medical and adult-use customers. Ask us about the limits that apply to you.</p>
        </details>
        <details class="home-faq-item scroll-reveal">
          <summary><strong>What forms of payment do you accept?</strong></summary>
          <p>Payment options vary between dispensaries. Contact us to ask which payment methods we accept.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="contact-section" id="contact">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>Get in Touch</h2>
          <% if (phoneRaw) { %>
          <div class="contact-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <div>
              <strong>Phone</strong>
              <a href="tel:<%= phoneRaw %>"><%= phone %></a>
            </div>
          </div>
          <% } %>
          <% if (email) { %>
          <div class="contact-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <div>
              <strong>Email</strong>
              <a href="mailto:<%= email %>"><%= email %></a>
            </div>
          </div>
          <% } %>
          <div class="contact-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <div>
              <strong>Address</strong>
              <span><% if (address) { %><%= address %><br/><% } %><%= city %>, <%= state %><% if (zip) { %> <%= zip %><% } %></span>
            </div>
          </div>
          <% if (_openDays.length) { %>
          <div class="contact-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <strong>Hours</strong>
              <span>
                <% _openDays.forEach(function (d, i) { %><%= _dayNames[d].slice(0, 3) %>: <%= businessHours[d].open %><% if (businessHours[d].close) { %> - <%= businessHours[d].close %><% } %><% if (i < _openDays.length - 1) { %><br/><% } %><% }); %>
              </span>
            </div>
          </div>
          <% } %>

          <div class="service-areas">
            <h3>Serving</h3>
            <p><%= _areas.join(', ') %></p>
          </div>
        </div>

        <div class="contact-form-container">
          <h2>Send Us a Message</h2>
          <form id="contact-form" method="POST" action="/api/admin/leads">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" required>
              </div>
              <div class="form-group">
                <label for="phone">Phone *</label>
                <input type="tel" id="phone" name="phone" required>
              </div>
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email">
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Questions about products, hours, orders..."></textarea>
            </div>
            <div id="form-error" style="display: none; color: #dc2626; background: #fef2f2; padding: 12px 16px; border-radius: 8px; margin-bottom: 8px; font-size: 0.95rem;"></div>
            <div class="form-group checkbox-group sms-consent">
              <label>
                <input type="checkbox" name="sms_consent" value="yes">
                I agree to receive text messages from {{COMPANY_NAME}} about my inquiry, appointments, and offers. Message frequency varies. Msg &amp; data rates may apply. Reply STOP to opt out, HELP for help. Consent is not a condition of purchase.
              </label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg full-width">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="map-section">
    <iframe
      src="https://maps.google.com/maps?q=<%= encodeURIComponent([address, city, [state, zip].filter(Boolean).join(' ')].filter(Boolean).join(', ')) %>&output=embed"
      allowfullscreen=""
      loading="lazy"
      title="Location Map"
    ></iframe>
  </section>

  <%
    // Defensive JSON-LD escape (Claflin 3.6) + email guard (3.7).
    const _emailOk = typeof email === 'string' && /^[^\s<>]+@[^\s<>]+\.[^\s<>]+$/.test(email);
  %>
  <!-- LocalBusiness Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Store",
    "name": "{{COMPANY_NAME}}",
    "image": "{{SITE_URL}}/logo.jpg",
    "url": "{{SITE_URL}}",
<% if (phoneRaw) { %>    "telephone": <%- _jsonStr('+1' + phoneRaw) %>,
<% } %><% if (_emailOk) { %>    "email": <%- _jsonStr(email) %>,
<% } %>    "address": {
      "@type": "PostalAddress",
<% if (address) { %>      "streetAddress": <%- _jsonStr(address) %>,
<% } %>      "addressLocality": <%- _jsonStr(city) %>,
      "addressRegion": <%- _jsonStr(state) %>,
<% if (zip) { %>      "postalCode": <%- _jsonStr(zip) %>,
<% } %>      "addressCountry": "US"
    },
    "areaServed": [
      <% _areas.forEach(function(area, index) { %>
      {
        "@type": "City",
        "name": <%- _jsonStr(String(area) + ', {{STATE}}') %>
      }<%= index < _areas.length - 1 ? ',' : '' %>
      <% }); %>
    ]
    <% if (_hoursLd.length) { %>
    ,"openingHoursSpecification": [
      <% _hoursLd.forEach(function(h, index) { %>
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": <%- _jsonStr(h.day) %>,
        "opens": <%- _jsonStr(h.opens) %>,
        "closes": <%- _jsonStr(h.closes) %>
      }<%= index < _hoursLd.length - 1 ? ',' : '' %>
      <% }); %>
    ]
    <% } %>
    <% if (typeof testimonials !== 'undefined' && testimonials && testimonials.length > 0) { %>
    ,"aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": <%- _jsonStr((testimonials.reduce(function(sum, t) { return sum + (t.rating || 5); }, 0) / testimonials.length).toFixed(1)) %>,
      "reviewCount": <%= testimonials.length %>,
      "bestRating": "5",
      "worstRating": "1"
    }
    ,"review": [
      <% testimonials.forEach(function(t, index) { %>
      {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": <%- _jsonStr(t.author) %>
        },
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": <%= t.rating || 5 %>,
          "bestRating": "5"
        },
        "reviewBody": <%- _jsonStr(_plainDesc(t.text, 500)) %>
        <% if (t.createdAt) { %>
        ,"datePublished": <%- _jsonStr(String(t.createdAt).split('T')[0]) %>
        <% } %>
      }<%= index < testimonials.length - 1 ? ',' : '' %>
      <% }); %>
    ]
    <% } %>
  }
  </script>

  <!-- FAQ Schema for Rich Results -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What do I need to bring to purchase cannabis?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You must be 21 or older and present a valid, unexpired government-issued photo ID (driver's license, state ID, or passport)."
        }
      },
      {
        "@type": "Question",
        "name": "Can I order ahead?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Browse our menu, add items to your cart, and place your order online."
        }
      },
      {
        "@type": "Question",
        "name": "How does the loyalty program work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ask us about joining. Members can check their points balance on our loyalty page."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a limit on how much I can buy?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Purchase limits are set by state law and can differ for medical and adult-use customers. Ask us about the limits that apply to you."
        }
      },
      {
        "@type": "Question",
        "name": "What forms of payment do you accept?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Payment options vary between dispensaries. Contact us to ask which payment methods we accept."
        }
      }
    ]
  }
  </script>
</div>

<style>
  .home-page { --green-primary: #2d6a4f; --green-accent: #52b788; --green-dark: #1a3a2a; }

  /* Age overlay (homepage first-visit) */
  .age-overlay {
    position: fixed; inset: 0; z-index: 10000;
    background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center;
  }
  .age-overlay-card {
    background: #fff; border-radius: 16px; padding: 48px 40px; text-align: center;
    max-width: 440px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  .age-overlay-card h2 { font-size: 1.5rem; margin-bottom: 8px; color: var(--green-dark); }
  .age-overlay-card p { color: #666; margin-bottom: 24px; }
  .age-overlay-buttons { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .age-overlay-buttons .btn { min-width: 140px; }

  /* 21+ notice bar */
  .age-notice-bar {
    background: var(--green-dark); color: rgba(255,255,255,0.8); text-align: center;
    padding: 10px 0; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.02em;
  }
  /* every theme colours bare spans globally; the notice text must take the bar's own colour */
  .age-notice-bar span { color: inherit; }

  /* Store Hours */
  .hours-section { padding: 60px 0; background: #fff; }
  .hours-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .hours-info h2 { font-size: 1.75rem; color: var(--green-dark); margin-bottom: 24px; }
  .hours-table { margin-bottom: 24px; }
  .hours-row {
    display: flex; justify-content: space-between; padding: 12px 0;
    border-bottom: 1px solid #eee; font-size: 0.95rem;
  }
  .hours-row span:first-child { font-weight: 600; color: #333; }
  .hours-row span:last-child { color: #555; }
  .hours-address { color: #555; }
  .hours-address p { margin-bottom: 4px; }
  .hours-phone {
    display: inline-block; margin-top: 8px; font-weight: 700;
    color: var(--green-primary); text-decoration: none; font-size: 1.1rem;
  }
  .hours-phone:hover { color: var(--green-accent); }
  .hours-features { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .feature-badge {
    display: flex; align-items: center; gap: 16px; padding: 20px;
    background: #f8f8f8; border-radius: 12px; border: 1px solid #eee;
  }
  .feature-icon { font-size: 2rem; }
  .feature-badge strong { display: block; color: var(--green-dark); font-size: 0.95rem; }
  .feature-badge span { font-size: 0.85rem; color: #666; }

  @media (max-width: 768px) {
    .hours-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

<script>
// Age gate overlay for homepage
(function() {
  var overlay = document.getElementById('ageGateOverlay');
  var yesBtn = document.getElementById('ageYesBtn');
  if (!overlay || !yesBtn) return;

  // Check if already verified via cookie
  function getCookie(name) {
    var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return match ? match[2] : null;
  }

  if (!getCookie('age_verified')) {
    overlay.style.display = 'flex';
  }

  yesBtn.addEventListener('click', function() {
    document.cookie = 'age_verified=1; path=/; max-age=86400; SameSite=Lax';
    overlay.style.display = 'none';
  });
})();

// Testimonial slider functionality
(function() {
  const slider = document.querySelector('.testimonial-slider');
  const dots = document.querySelectorAll('.testimonial-dots button');
  const cards = document.querySelectorAll('.testimonial-card');

  if (!slider || cards.length === 0) return;

  let currentIndex = 0;

  function showTestimonial(index) {
    cards.forEach((card, i) => {
      card.classList.toggle('active', i === index);
    });
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
    });
    currentIndex = index;
  }

  // Dot click handlers
  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => showTestimonial(index));
  });

  // Auto-rotate every 8 seconds
  if (cards.length > 1) {
    setInterval(() => {
      const nextIndex = (currentIndex + 1) % cards.length;
      showTestimonial(nextIndex);
    }, 8000);
  }
})();

// Contact form submission
(function() {
  const form = document.getElementById('contact-form');
  const errorDiv = document.getElementById('form-error');

  if (!form) return;

  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Submitting...';
    submitBtn.disabled = true;
    errorDiv.style.display = 'none';

    try {
      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        phone: formData.get('phone'),
        email: formData.get('email'),
        message: formData.get('message'),
        source: 'homepage'
      };

      const response = await fetch('/api/admin/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        form.reset();
        alert('Thank you! We\'ll be in touch soon.');
      } else {
        throw new Error('Submission failed');
      }
    } catch (err) {
      errorDiv.textContent = 'Something went wrong. Please try again or call us directly.';
      errorDiv.style.display = 'block';
    }

    submitBtn.textContent = originalText;
    submitBtn.disabled = false;
  });
})();

// Scroll animations
(function() {
  const observer = new IntersectionObserver(
    function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.animate-on-scroll').forEach(function(el) {
    observer.observe(el);
  });
})();
</script>
