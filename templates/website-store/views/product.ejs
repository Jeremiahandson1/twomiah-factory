<%
// product.ejs — locals: { product: Product }
// Product = { id, slug, name, tagline, description, featured, images[], variants[] }
const p = product || {};
const images = Array.isArray(p.images) ? p.images : [];
const variants = Array.isArray(p.variants) ? p.variants : [];
const primary = images.find(function(i){ return i.isPrimary; }) || images[0] || null;
const hasVariants = variants.length > 0;
const multiVariant = variants.length > 1;

// The variant selected on initial render = first in-stock variant, else first.
const defaultVariant = hasVariants
  ? (variants.find(function(v){ return v.inventoryQty !== 0; }) || variants[0])
  : null;

function inv(v) {
  return (v.inventoryQty === null || typeof v.inventoryQty === 'undefined') ? '' : v.inventoryQty;
}
%>

<div class="store-page product-page">
  <div class="container">
    <a href="/shop" class="back-link store-back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      Back to Shop
    </a>

    <div class="product-detail">
      <!-- Gallery -->
      <div class="product-gallery">
        <div class="product-gallery__main">
          <% if (primary) { %>
            <img
              data-gallery-main
              src="<%= primary.url %>"
              alt="<%= primary.alt || p.name %>"
              width="800" height="800"
            >
          <% } else { %>
            <div class="product-card__noimg product-gallery__noimg" aria-hidden="true">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <path d="M21 15l-5-5L5 21"></path>
              </svg>
            </div>
          <% } %>
        </div>
        <% if (images.length > 1) { %>
          <div class="product-gallery__thumbs">
            <% images.forEach(function(img, i) { %>
              <button
                type="button"
                class="product-gallery__thumb <%= (primary && img.url === primary.url) ? 'is-active' : '' %>"
                data-gallery-thumb
                data-full="<%= img.url %>"
                data-alt="<%= img.alt || p.name %>"
                aria-label="View image <%= i + 1 %>"
              >
                <img src="<%= img.url %>" alt="<%= img.alt || p.name %>" loading="lazy" width="120" height="120">
              </button>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- Info / buy box -->
      <div class="product-info">
        <% if (p.featured) { %><span class="product-eyebrow">Featured</span><% } %>
        <h1 class="product-info__name"><%= p.name %></h1>
        <% if (p.tagline) { %>
          <p class="product-info__tagline"><%= p.tagline %></p>
        <% } %>

        <% if (defaultVariant) { %>
          <div class="product-info__price">
            <span class="product-price__now" data-price-display><%= money(defaultVariant.priceCents) %></span>
            <span
              class="product-price__was"
              data-compare-display
              style="<%= (defaultVariant.compareAtPriceCents && defaultVariant.compareAtPriceCents > defaultVariant.priceCents) ? '' : 'display:none' %>"
            ><%= defaultVariant.compareAtPriceCents ? money(defaultVariant.compareAtPriceCents) : '' %></span>
          </div>
        <% } %>

        <!-- Sold-out notice (toggled by cart.js on variant change) -->
        <p class="product-soldout" data-soldout-msg style="<%= (defaultVariant && defaultVariant.inventoryQty === 0) ? '' : 'display:none' %>">
          This item is currently sold out.
        </p>

        <% if (multiVariant) { %>
          <div class="product-variants" role="group" aria-label="Choose an option">
            <span class="product-variants__label">Options</span>
            <div class="product-variants__opts">
              <% variants.forEach(function(v) { %>
                <button
                  type="button"
                  class="variant-option <%= (defaultVariant && v.id === defaultVariant.id) ? 'is-selected' : '' %>"
                  data-variant-option
                  data-sku="<%= v.sku %>"
                  data-name="<%= v.name %>"
                  data-price="<%= v.priceCents %>"
                  data-price-display="<%= money(v.priceCents) %>"
                  data-compare="<%= (v.compareAtPriceCents && v.compareAtPriceCents > v.priceCents) ? money(v.compareAtPriceCents) : '' %>"
                  data-max="<%= inv(v) %>"
                  <%= (v.inventoryQty === 0) ? 'data-soldout="1"' : '' %>
                >
                  <%= v.name %><% if (v.inventoryQty === 0) { %> &mdash; sold out<% } %>
                </button>
              <% }); %>
            </div>
          </div>
        <% } %>

        <% if (defaultVariant) { %>
          <div class="product-buy">
            <div class="qty-stepper" data-qty-stepper>
              <button type="button" class="qty-stepper__btn" data-qty-dec aria-label="Decrease quantity">&minus;</button>
              <input type="number" class="qty-stepper__input" data-qty-input value="1" min="1" step="1" inputmode="numeric" aria-label="Quantity">
              <button type="button" class="qty-stepper__btn" data-qty-inc aria-label="Increase quantity">&plus;</button>
            </div>
            <button
              type="button"
              class="btn btn-primary btn-lg product-add"
              data-add-to-cart
              data-product-add
              data-sku="<%= defaultVariant.sku %>"
              data-name="<%= p.name %>"
              data-variant="<%= multiVariant ? defaultVariant.name : '' %>"
              data-price="<%= defaultVariant.priceCents %>"
              data-image="<%= primary ? primary.url : '' %>"
              data-max="<%= inv(defaultVariant) %>"
              <%= (defaultVariant.inventoryQty === 0) ? 'disabled' : '' %>
            >
              <span data-add-label><%= (defaultVariant.inventoryQty === 0) ? 'Sold out' : 'Add to Cart' %></span>
            </button>
          </div>
        <% } else { %>
          <p class="product-soldout">This item is not available for purchase right now.</p>
        <% } %>

        <a href="/cart" class="product-viewcart" data-cart-count-wrap>
          View cart<span class="product-viewcart__count" data-cart-count>0</span>
        </a>

        <% if (p.description) { %>
          <div class="product-description">
            <h2>Details</h2>
            <div class="prose">
              <% String(p.description).split(/\n\n+/).forEach(function(para) { %>
                <p><%= para %></p>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Product structured data -->
  <%
    const _ldImages = images.map(function(i){ return i.url; });
    const _prices = variants.map(function(v){ return v.priceCents; });
    const _lowCents = _prices.length ? Math.min.apply(null, _prices) : 0;
    const _highCents = _prices.length ? Math.max.apply(null, _prices) : 0;
    const _anyInStock = variants.some(function(v){ return v.inventoryQty === null || typeof v.inventoryQty === 'undefined' || v.inventoryQty > 0; });
    const _availability = _anyInStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock';
  %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": <%- _jsonStr(p.name) %>,
    <% if (p.description) { %>"description": <%- _jsonStr(_plainDesc ? _plainDesc(p.description, 500) : String(p.description).slice(0, 500)) %>,<% } %>
    <% if (_ldImages.length) { %>"image": <%- JSON.stringify(_ldImages) %>,<% } %>
    "url": "{{SITE_URL}}/product/<%= p.slug %>",
    <% if (variants.length > 1) { %>
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "<%= (_lowCents / 100).toFixed(2) %>",
      "highPrice": "<%= (_highCents / 100).toFixed(2) %>",
      "offerCount": <%= variants.length %>,
      "availability": "<%= _availability %>"
    }
    <% } else if (variants.length === 1) { %>
    "offers": {
      "@type": "Offer",
      "priceCurrency": "USD",
      "price": "<%= (variants[0].priceCents / 100).toFixed(2) %>",
      "availability": "<%= _availability %>",
      "url": "{{SITE_URL}}/product/<%= p.slug %>"
    }
    <% } else { %>
    "offers": []
    <% } %>
  }
  </script>
</div>
