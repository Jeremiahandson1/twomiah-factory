<%
// Extract data with fallbacks
const hero = (typeof homepage !== 'undefined' && homepage && homepage.hero) ? homepage.hero : {};
const trustBadges = (typeof homepage !== 'undefined' && homepage && homepage.trustBadges) ? homepage.trustBadges.filter(b => b.enabled) : [];
const ctaSection = (typeof homepage !== 'undefined' && homepage && homepage.ctaSection) ? homepage.ctaSection : {};
const businessHours = (typeof homepage !== 'undefined' && homepage && homepage.businessHours) ? homepage.businessHours : {};

// Settings with fallbacks
const phone = (typeof settings !== 'undefined' && settings && settings.phone) ? settings.phone : '{{COMPANY_PHONE}}';
const email = (typeof settings !== 'undefined' && settings && settings.email) ? settings.email : '{{COMPANY_EMAIL}}';
const address = (typeof settings !== 'undefined' && settings && settings.address) ? settings.address : '';
const city = (typeof settings !== 'undefined' && settings && settings.city) ? settings.city : '{{CITY}}';
const state = (typeof settings !== 'undefined' && settings && settings.state) ? settings.state : '{{STATE}}';
const zip = (typeof settings !== 'undefined' && settings && settings.zip) ? settings.zip : '{{ZIP}}';
const phoneRaw = phone.replace(/\D/g, '');

function getImageUrl(p) {
  if (!p) return '';
  if (p.startsWith('http')) return p;
  if (p.startsWith('/')) return p;
  return '/uploads/' + p;
}
%>

<div class="home-page">
  <!-- Hero -->
  <section class="hero-video <%= hero.image ? 'hero-animated' : '' %>" style="--hero-speed: <%= hero.animationSpeed || 12 %>s">
    <% if (hero.image) { %>
      <div class="hero-bg animation-<%= hero.animation || 'none' %>" style="background-image: <%- bgWithWebp(getImageUrl(hero.image)) %>"></div>
      <div class="hero-overlay"></div>
    <% } else { %>
      <div class="hero-video-bg"><div class="video-placeholder"></div><div class="hero-overlay"></div></div>
    <% } %>
    <div class="hero-video-content <%= hero.image ? 'hero-content' : '' %>">
      <h1><%= hero.title || '{{COMPANY_NAME}}' %></h1>
      <h2><%= hero.subtitle || 'Quality products, delivered.' %></h2>
      <div class="hero-line"></div>
      <p class="hero-tagline"><strong><%= hero.tagline || 'SHOP {{COMPANY_NAME_UPPER}}' %></strong></p>
      <p class="hero-awards"><%= hero.description || 'Quality products with fast shipping and secure checkout.' %></p>
      <div class="hero-buttons">
        <a href="<%= hero.primaryButtonLink || '/shop' %>" class="btn btn-primary btn-lg"><%= hero.primaryButtonText || 'Shop Now' %></a>
        <a href="<%= hero.secondaryButtonLink || '/about' %>" class="btn btn-outline-light btn-lg"><%= hero.secondaryButtonText || 'Learn More' %></a>
      </div>
    </div>
  </section>

  <!-- Featured Products (from the crm-store catalog) -->
  <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
  <section class="products-section" id="featured">
    <div class="container">
      <h2>Featured Products</h2>
      <div class="product-grid">
        <% products.forEach(function(product) {
          const imgs = product.images || [];
          const primary = imgs.find(function(i){ return i.isPrimary; }) || imgs[0];
          const vars = product.variants || [];
          const lowest = vars.length ? Math.min.apply(null, vars.map(function(v){ return v.priceCents; })) : 0;
          const firstVar = vars[0] || null;
          const soldOut = firstVar && firstVar.inventoryQty === 0;
        %>
          <div class="product-card animate-on-scroll">
            <a class="product-card-link" href="/product/<%= product.slug %>">
              <div class="product-image">
                <% if (primary) { %>
                  <img src="<%= primary.url %>" alt="<%= primary.alt || product.name %>" loading="lazy">
                <% } else { %>
                  <div class="product-image-placeholder"></div>
                <% } %>
              </div>
              <div class="product-info">
                <h3><%= product.name %></h3>
                <p class="product-price"><%= vars.length > 1 ? 'From ' : '' %><%= money(lowest) %></p>
              </div>
            </a>
            <% if (firstVar) { %>
              <button class="btn btn-primary product-add"
                data-add-to-cart
                data-sku="<%= firstVar.sku %>"
                data-name="<%= product.name %>"
                data-variant="<%= firstVar.name %>"
                data-price="<%= firstVar.priceCents %>"
                data-image="<%= primary ? primary.url : '' %>"
                data-max="<%= firstVar.inventoryQty == null ? '' : firstVar.inventoryQty %>"
                <%= soldOut ? 'disabled' : '' %>>
                <%= soldOut ? 'Sold Out' : 'Add to Cart' %>
              </button>
            <% } %>
          </div>
        <% }); %>
      </div>
      <div class="products-cta" style="text-align:center; margin-top: 2rem;">
        <a href="/shop" class="btn btn-outline btn-lg">Shop All Products</a>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Why Shop With Us -->
  <section class="why-choose-section">
    <div class="container">
      <h2>Why Shop With {{COMPANY_NAME}}</h2>
      <div class="why-grid">
        <div class="why-item animate-on-scroll">
          <div class="why-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h3>Fast, Reliable Shipping</h3>
          <p>Orders ship quickly with tracking, so you always know where your package is. Most items arrive within a few business days.</p>
        </div>
        <div class="why-item animate-on-scroll">
          <div class="why-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          </div>
          <h3>Secure Checkout</h3>
          <p>Payments are processed by trusted, PCI-compliant providers. Your card details never touch our servers — checkout is safe and encrypted.</p>
        </div>
        <div class="why-item animate-on-scroll">
          <div class="why-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          </div>
          <h3>Easy Returns</h3>
          <p>Not quite right? Returns are simple and hassle-free. Reach out and we'll make it right — your satisfaction is what keeps us going.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials (data-driven) -->
  <% if (typeof testimonials !== 'undefined' && testimonials && testimonials.length > 0) { %>
    <section class="testimonials-section">
      <div class="container">
        <h2>What Our Customers Say</h2>
        <div class="testimonial-slider">
          <% testimonials.forEach(function(testimonial, index) { %>
            <div class="testimonial-card <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>">
              <div class="testimonial-content">
                <div class="testimonial-stars"><%= '★'.repeat(testimonial.rating || 5) %></div>
                <blockquote>"<%= testimonial.text %>"</blockquote>
                <div class="testimonial-author">
                  <% if (testimonial.image) { %><img src="<%= getImageUrl(testimonial.image) %>" alt="<%= testimonial.author %>"><% } %>
                  <div>
                    <strong><%= testimonial.author %></strong>
                    <% if (testimonial.location) { %><span><%= testimonial.location %></span><% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
        <% if (testimonials.length > 1) { %>
          <div class="testimonial-dots">
            <% testimonials.forEach(function(_, i) { %>
              <button class="<%= i === 0 ? 'active' : '' %>" data-index="<%= i %>" aria-label="Testimonial <%= i + 1 %>"></button>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- CTA -->
  <section class="cta-section" <% if (ctaSection.backgroundImage) { %>style="background-image: <%- bgWithWebp(getImageUrl(ctaSection.backgroundImage)) %>"<% } %>>
    <div class="container">
      <h2><%= ctaSection.title || 'Ready to shop?' %></h2>
      <p><%= ctaSection.description || 'Browse our full collection and check out securely in seconds.' %></p>
      <div class="cta-buttons">
        <a href="<%= ctaSection.primaryButtonLink || '/shop' %>" class="btn btn-primary btn-lg"><%= ctaSection.primaryButtonText || 'Shop Now' %></a>
        <a href="<%= ctaSection.secondaryButtonLink || '/contact' %>" class="btn btn-outline btn-lg"><%= ctaSection.secondaryButtonText || 'Contact Us' %></a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts (data-driven, optional) -->
  <% if (typeof recentPosts !== 'undefined' && recentPosts && recentPosts.length > 0) { %>
    <section class="blog-preview-section">
      <div class="container">
        <h2>From the Journal</h2>
        <div class="blog-preview-grid">
          <% recentPosts.forEach(function(post) { %>
            <a href="/blog/<%= post.slug %>" class="blog-preview-card animate-on-scroll">
              <% if (post.featuredImage) { %><img src="<%= getImageUrl(post.featuredImage) %>" alt="<%= post.title %>" loading="lazy" width="400" height="225"><% } %>
              <div class="blog-preview-content">
                <h3><%= post.title %></h3>
                <p><%= post.excerpt %></p>
                <span class="read-more">Read More →</span>
              </div>
            </a>
          <% }); %>
        </div>
        <div style="text-align: center; margin-top: 1.5rem;"><a href="/blog" class="btn btn-outline">View All Articles</a></div>
      </div>
    </section>
  <% } %>

  <!-- FAQ (store) -->
  <section class="home-faq">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="home-faq-list">
        <details class="home-faq-item animate-on-scroll">
          <summary><strong>How long does shipping take?</strong></summary>
          <p>Most orders ship within 1–2 business days and arrive within a few business days after that. You'll receive tracking as soon as your order is on its way.</p>
        </details>
        <details class="home-faq-item animate-on-scroll">
          <summary><strong>What is your return policy?</strong></summary>
          <p>If something isn't right, contact us and we'll help with a return or exchange. We want you to love what you ordered from {{COMPANY_NAME}}.</p>
        </details>
        <details class="home-faq-item animate-on-scroll">
          <summary><strong>Is checkout secure?</strong></summary>
          <p>Yes. Payments are handled by a trusted, PCI-compliant payment provider over an encrypted connection. Your card details are never stored on our site.</p>
        </details>
        <details class="home-faq-item animate-on-scroll">
          <summary><strong>How do I track my order?</strong></summary>
          <p>Once your order ships, we'll email you a tracking link so you can follow it to your door. Questions about an order? Just reach out.</p>
        </details>
        <details class="home-faq-item animate-on-scroll">
          <summary><strong>How can I get in touch?</strong></summary>
          <p>Email us any time at <%= email %><% if (phoneRaw && phoneRaw !== '5550000000') { %> or call <%= phone %><% } %>. We're happy to help with sizing, availability, orders, and returns.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Support / Contact -->
  <section class="contact-section" id="contact">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>Customer Support</h2>
          <p style="color: var(--gray-600, #4b5563); margin-bottom: 1.5rem;">Questions about a product, an order, or a return? We're here to help.</p>
          <div class="contact-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <div><strong>Email</strong><a href="mailto:<%= email %>"><%= email %></a></div>
          </div>
          <% if (phoneRaw && phoneRaw !== '5550000000') { %>
          <div class="contact-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <div><strong>Phone</strong><a href="tel:<%= phoneRaw %>"><%= phone %></a></div>
          </div>
          <% } %>
          <div class="contact-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <div><strong>Support Hours</strong>
              <span>
                <% if (businessHours.monday && !businessHours.monday.closed) { %>Mon - Fri: <%= businessHours.monday.open %> - <%= businessHours.monday.close %><% } else { %>Mon - Fri: 9am - 5pm<% } %>
              </span>
            </div>
          </div>
        </div>

        <div class="contact-form-container">
          <h2>Send Us a Message</h2>
          <form id="contact-form" method="POST" action="/api/admin/leads">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" required>
              </div>
              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required>
              </div>
            </div>
            <div class="form-group">
              <label for="message">How can we help?</label>
              <textarea id="message" name="message" rows="4" placeholder="Ask about a product, an order, or a return..."></textarea>
            </div>
            <div id="form-error" style="display: none; color: #dc2626; background: #fef2f2; padding: 12px 16px; border-radius: 8px; margin-bottom: 8px; font-size: 0.95rem;"></div>
            <button type="submit" class="btn btn-primary btn-lg full-width">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <%
    const _emailOk = typeof email === 'string' && /^[^\s<>]+@[^\s<>]+\.[^\s<>]+$/.test(email);
  %>
  <!-- Store / Organization schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Store",
    "name": "{{COMPANY_NAME}}",
    "image": "{{SITE_URL}}/logo.jpg",
    "url": "{{SITE_URL}}",
    "priceRange": "$$"<% if (_emailOk) { %>,
    "email": <%- _jsonStr(email) %><% } %>
  }
  </script>

  <!-- FAQ schema (store) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How long does shipping take?", "acceptedAnswer": { "@type": "Answer", "text": "Most orders ship within 1-2 business days and arrive within a few business days after that, with tracking provided." } },
      { "@type": "Question", "name": "What is your return policy?", "acceptedAnswer": { "@type": "Answer", "text": "If something isn't right, contact us and we'll help with a return or exchange." } },
      { "@type": "Question", "name": "Is checkout secure?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Payments are handled by a trusted, PCI-compliant provider over an encrypted connection; card details are never stored on our site." } },
      { "@type": "Question", "name": "How do I track my order?", "acceptedAnswer": { "@type": "Answer", "text": "Once your order ships, we email you a tracking link." } }
    ]
  }
  </script>
</div>

<script>
// Testimonial slider
(function() {
  const dots = document.querySelectorAll('.testimonial-dots button');
  const cards = document.querySelectorAll('.testimonial-card');
  if (cards.length === 0) return;
  let currentIndex = 0;
  function show(index) {
    cards.forEach((c, i) => c.classList.toggle('active', i === index));
    dots.forEach((d, i) => d.classList.toggle('active', i === index));
    currentIndex = index;
  }
  dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));
  if (cards.length > 1) setInterval(() => show((currentIndex + 1) % cards.length), 8000);
})();

// Contact form
(function() {
  const form = document.getElementById('contact-form');
  const errorDiv = document.getElementById('form-error');
  if (!form) return;
  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Sending...';
    submitBtn.disabled = true;
    errorDiv.style.display = 'none';
    try {
      const fd = new FormData(form);
      const data = { name: fd.get('name'), email: fd.get('email'), message: fd.get('message'), source: 'store-contact' };
      const res = await fetch('/api/admin/leads', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      if (res.ok) { form.reset(); alert('Thanks! We\'ll get back to you soon.'); }
      else throw new Error('failed');
    } catch (err) {
      errorDiv.textContent = 'Something went wrong. Please email us directly.';
      errorDiv.style.display = 'block';
    }
    submitBtn.textContent = originalText;
    submitBtn.disabled = false;
  });
})();

// Scroll animations
(function() {
  const observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
  document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
})();
</script>
