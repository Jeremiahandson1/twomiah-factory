<%
// shop.ejs — locals: { products: Product[] }
// Product = { id, slug, name, tagline, description, featured, images[], variants[] }
const items = (typeof products !== 'undefined' && Array.isArray(products)) ? products : [];

// Pick the primary image (or first) for a product, guarding empty arrays.
function primaryImage(p) {
  const imgs = (p && Array.isArray(p.images)) ? p.images : [];
  if (imgs.length === 0) return null;
  return imgs.find(function(i){ return i.isPrimary; }) || imgs[0];
}

// Lowest-priced sellable variant drives the card price.
function lowestVariant(p) {
  const vs = (p && Array.isArray(p.variants)) ? p.variants : [];
  if (vs.length === 0) return null;
  return vs.reduce(function(lo, v){ return (v.priceCents < lo.priceCents) ? v : lo; }, vs[0]);
}
%>

<div class="store-page shop-page">
  <!-- Hero heading (reuses gallery-hero chrome) -->
  <section class="gallery-hero">
    <div class="gallery-hero-bg"></div>
    <div class="container">
      <div class="gallery-hero-content">
        <h1>Shop</h1>
        <p>Browse our collection from {{COMPANY_NAME}} — quality products, shipped to your door.</p>
      </div>
    </div>
  </section>

  <!-- Product grid -->
  <section class="shop-section">
    <div class="container">
      <% if (items.length === 0) { %>
        <div class="store-empty">
          <h3>No products yet</h3>
          <p>Check back soon — we're stocking the shelves.</p>
        </div>
      <% } else { %>
        <div class="product-grid">
          <% items.forEach(function(product) {
               const img = primaryImage(product);
               const lv = lowestVariant(product);
               const variantCount = (product.variants && product.variants.length) || 0;
               const soldOut = variantCount > 0 && product.variants.every(function(v){ return v.inventoryQty === 0; });
          %>
            <div class="product-card">
              <a href="/product/<%= product.slug %>" class="product-card__link" aria-label="<%= product.name %>">
                <div class="product-card__media">
                  <% if (img) { %>
                    <img src="<%= img.url %>" alt="<%= img.alt || product.name %>" loading="lazy" width="600" height="600">
                  <% } else { %>
                    <div class="product-card__noimg" aria-hidden="true">
                      <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <path d="M21 15l-5-5L5 21"></path>
                      </svg>
                    </div>
                  <% } %>
                  <% if (product.featured) { %><span class="product-badge product-badge--featured">Featured</span><% } %>
                  <% if (soldOut) { %><span class="product-badge product-badge--soldout">Sold out</span><% } %>
                </div>
                <div class="product-card__body">
                  <h3 class="product-card__name"><%= product.name %></h3>
                  <% if (product.tagline) { %>
                    <p class="product-card__tagline"><%= product.tagline %></p>
                  <% } %>
                  <% if (lv) { %>
                    <div class="product-price">
                      <% if (variantCount > 1) { %><span class="product-price__from">From</span><% } %>
                      <span class="product-price__now"><%= money(lv.priceCents) %></span>
                      <% if (lv.compareAtPriceCents && lv.compareAtPriceCents > lv.priceCents) { %>
                        <span class="product-price__was"><%= money(lv.compareAtPriceCents) %></span>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              </a>
              <% if (lv) { %>
                <button
                  type="button"
                  class="btn btn-primary product-card__add add-to-cart"
                  data-add-to-cart
                  data-sku="<%= lv.sku %>"
                  data-name="<%= product.name %>"
                  data-variant="<%= (variantCount > 1) ? lv.name : '' %>"
                  data-price="<%= lv.priceCents %>"
                  data-image="<%= img ? img.url : '' %>"
                  data-max="<%= (lv.inventoryQty === null || typeof lv.inventoryQty === 'undefined') ? '' : lv.inventoryQty %>"
                  <%= (lv.inventoryQty === 0) ? 'disabled' : '' %>
                >
                  <%= (lv.inventoryQty === 0) ? 'Sold out' : 'Add to cart' %>
                </button>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>
</div>
