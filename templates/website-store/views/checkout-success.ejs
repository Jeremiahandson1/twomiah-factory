<%
// checkout-success.ejs — locals: { order: {...}|null }
// order = { orderNumber, status, email, subtotalCents, shippingCents, taxCents,
//           discountCents, loyaltyDiscountCents, discountCode,
//           totalCents, currency, items: [{ productName, variantName, quantity,
//           lineTotalCents, imageUrl }] }
const o = (typeof order !== 'undefined' && order) ? order : null;
const cur = (o && o.currency) ? o.currency : 'usd';
const orderItems = (o && Array.isArray(o.items)) ? o.items : [];
// The discount, as the receipt shows it: the code's share and the loyalty reward's. Without these the lines did not
// add up to the total (E2E Run 2).
const discTotal = (o && o.discountCents > 0) ? o.discountCents : 0;
const discLoyalty = (o && o.loyaltyDiscountCents > 0) ? Math.min(discTotal, o.loyaltyDiscountCents) : 0;
// A refunded or cancelled order is not "confirmed" — the link in the shopper's email still opens it.
const closed = o && (o.status === 'refunded' || o.status === 'cancelled');
%>

<div class="store-page checkout-success-page">
  <div class="container container--narrow">
    <div class="order-confirm">
      <div class="order-confirm__icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6L9 17l-5-5"></path>
        </svg>
      </div>
      <h1 class="order-confirm__title"><%= closed ? (o.status === 'refunded' ? 'This order was refunded' : 'This order was cancelled') : 'Thank you for your order!' %></h1>

      <% if (o) { %>
        <p class="order-confirm__lead">
          <% if (closed) { %>Your order <strong>#<%= o.orderNumber %></strong> was <%= o.status %>. Contact the store if you have any questions.<% } else { %>Your order <strong>#<%= o.orderNumber %></strong> is confirmed.
          <% if (o.email) { %>A receipt is on its way to <strong><%= o.email %></strong>.<% } else { %>A receipt is on its way to your inbox.<% } %><% } %>
        </p>

        <% if (orderItems.length > 0) { %>
          <div class="order-card">
            <div class="order-items">
              <% orderItems.forEach(function(it) { %>
                <div class="order-item">
                  <div class="order-item__media">
                    <% if (it.imageUrl) { %>
                      <img src="<%= it.imageUrl %>" alt="<%= it.productName %>" width="72" height="72">
                    <% } else { %>
                      <div class="product-card__noimg" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                          <circle cx="8.5" cy="8.5" r="1.5"></circle>
                          <path d="M21 15l-5-5L5 21"></path>
                        </svg>
                      </div>
                    <% } %>
                  </div>
                  <div class="order-item__info">
                    <span class="order-item__name"><%= it.productName %></span>
                    <% if (it.variantName) { %><span class="order-item__variant"><%= it.variantName %></span><% } %>
                    <span class="order-item__qty">Qty <%= it.quantity %></span>
                  </div>
                  <div class="order-item__total"><%= money(it.lineTotalCents, cur) %></div>
                </div>
              <% }); %>
            </div>

            <div class="order-summary">
              <div class="order-summary__row">
                <span>Subtotal</span>
                <span><%= money(o.subtotalCents, cur) %></span>
              </div>
              <% if (discTotal - discLoyalty > 0) { %>
              <div class="order-summary__row">
                <span>Discount<%= o.discountCode ? ' (' + o.discountCode + ')' : '' %></span>
                <span>&minus;<%= money(discTotal - discLoyalty, cur) %></span>
              </div>
              <% } %>
              <% if (discLoyalty > 0) { %>
              <div class="order-summary__row">
                <span>Loyalty reward</span>
                <span>&minus;<%= money(discLoyalty, cur) %></span>
              </div>
              <% } %>
              <div class="order-summary__row">
                <span>Shipping</span>
                <span><%= (o.shippingCents && o.shippingCents > 0) ? money(o.shippingCents, cur) : 'Free' %></span>
              </div>
              <div class="order-summary__row">
                <span>Tax</span>
                <span><%= money(o.taxCents, cur) %></span>
              </div>
              <div class="order-summary__row order-summary__row--total">
                <span>Total</span>
                <span><%= money(o.totalCents, cur) %></span>
              </div>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <p class="order-confirm__lead">
          Your order is confirmed &mdash; a receipt is on its way to your inbox.
          Thank you for shopping with {{COMPANY_NAME}}.
        </p>
      <% } %>

      <div class="order-confirm__actions">
        <a href="/shop" class="btn btn-primary btn-lg">Continue Shopping</a>
      </div>
    </div>
  </div>
</div>

<script>
  // Order placed — empty the client cart so the badge/cart page reset.
  (function () {
    try {
      localStorage.removeItem('{{COMPANY_SLUG}}-cart');
      document.querySelectorAll('[data-cart-count]').forEach(function (el) { el.textContent = '0'; });
    } catch (e) {}
  })();
</script>
